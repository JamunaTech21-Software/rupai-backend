# RupAI STAGING secrets and settings. Copy to deploy/staging/.env on the staging machine ONLY.
# Never commit the real file. Generate every secret with:  openssl rand -hex 24
# (hex, so a password is always safe inside a mysql:// or redis:// URL)

# Which tunnel starts with the stack:
#   tunnel       the named tunnel (needs a domain on Cloudflare and CLOUDFLARE_TUNNEL_TOKEN): stable address
#   quicktunnel  no domain needed: a random https://<words>.trycloudflare.com, new on every restart
COMPOSE_PROFILES=tunnel

# ---- database and Redis -------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=
MIGRATOR_DB_PASSWORD=
APP_DB_PASSWORD=
REDIS_PASSWORD=

# ---- authentication -----------------------------------------------------------------------------
# openssl rand -base64 48
AUTH_TOKEN_SECRET=
# AUTH_TOKEN_PREVIOUS_SECRET=

# The Vercel URL of the frontend, exactly (no trailing slash). Password-reset links point here.
APP_PUBLIC_URL=https://rupai-admin-frontend.vercel.app

# Origins the API accepts from browsers (CORS): exact origins, comma-separated, no wildcard, no trailing
# slash. Optional: defaults to APP_PUBLIC_URL. List every Vercel domain people open the app on.
CORS_ORIGINS=https://rupai-admin-frontend.vercel.app,https://rupai-admin-frontend-git-main-jamuna-tech.vercel.app

# Hops between the user and the API: Vercel (sets X-Forwarded-For to the user's IP), then Cloudflare
# (appends Vercel's IP), then cloudflared (the TCP peer). With 2, the API sees the user's real IP, which
# the sign-in lockout and rate limits depend on. Check it after the first deploy (STAGING.md, step 7).
TRUST_PROXY=2

# ---- accounts -------------------------------------------------------------------------------------
# The bootstrap administrator (`admin`), created by the first seed. Must be changed at first sign-in.
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_EMAIL=
# Demo accounts `manager` (Administrator, all estates) and `viewer` (read-only). Leave empty for none.
DEMO_PASSWORD=

# ---- Cloudflare ------------------------------------------------------------------------------------
# Zero Trust → Networks → Tunnels → your tunnel → the token in the install command.
CLOUDFLARE_TUNNEL_TOKEN=

# ---- backups ---------------------------------------------------------------------------------------
BACKUP_KEEP_DAYS=14
