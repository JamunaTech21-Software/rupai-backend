// =============================================================================================
// RupAI database schema — a typed MIRROR of spec Part 3. Part 3 is the authority, not this file.
//
// Read prisma/README.md before changing anything here. In short:
//   * Every model maps to its Part 3 table and column names with @@map / @map (snake_case singular).
//   * Surrogate keys:  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
//     ULID keys (the six field-capture tables, P3 §2.2):  id String @id @db.Char(26)
//   * Money Decimal @db.Decimal(18,4) · qty (14,3) · rate (18,8) · pct (9,4). Never Float.
//   * States and enums are String @db.VarChar(30), validated in TypeScript. Never a Prisma enum.
//   * Generated columns and CHECK constraints are added by hand in the migration SQL.
//   * Migrations are created with `npm run db:migrate:new -- --name <x>` (create-only), then the
//     SQL is reviewed and edited. `prisma db push` is never used.
// =============================================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// Models are added epic by epic.

// ---------------------------------------------------------------------------------------------
// P1.01 — Platform prerequisites: permission, role, role_permission, user, user_role (P3 §28.1,
// migration step 1 of P3 §32). Every audit column in the schema references user.
// ---------------------------------------------------------------------------------------------

/// P3 §28.1. System data: seeded from the catalogue in code, never written by the app account.
model Permission {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  module      String  @db.VarChar(40)
  action      String  @db.VarChar(20)
  description String? @db.VarChar(500)

  roles RolePermission[]

  @@unique([module, action], map: "ux_permission_module_action")
  @@map("permission")
}

/// P3 §28.1: the common lookup shape (P3 §5.1) + audit block. `version` per P4 §5.1.
model Role {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  /// The Administrator role is is_system: it may be renamed but not deleted or deactivated.
  isSystem    Boolean   @default(false) @map("is_system")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy   BigInt?   @map("updated_by") @db.UnsignedBigInt

  workflowSteps     WorkflowStep[]
  notificationRules NotificationRule[]
  creator           User               @relation("RoleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_created_by")
  updater           User?              @relation("RoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_updated_by")
  permissions       RolePermission[]
  users             UserRole[]

  @@unique([code], map: "ux_role_code")
  @@index([status], map: "ix_role_status")
  @@index([createdBy], map: "ix_role_created_by")
  @@index([updatedBy], map: "ix_role_updated_by")
  @@map("role")
}

/// P3 §28.1. Junction; rows go with their role (P2 §7.1, line-to-header).
model RolePermission {
  roleId       BigInt @map("role_id") @db.UnsignedBigInt
  permissionId BigInt @map("permission_id") @db.UnsignedBigInt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_role_permission_role")
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_permission_permission")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "ix_role_permission_permission")
  @@map("role_permission")
}

/// P3 §28.1 + audit block. `version` per P4 §5.1. person_id / employment_profile_id get their foreign
/// keys when person (P2.01) and employment_profile (P2.02) exist.
model User {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
