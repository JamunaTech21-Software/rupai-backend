  @@unique([baseKey], map: "ux_currency_base")
  @@index([status], map: "ix_currency_status")
  @@index([createdBy], map: "ix_currency_created_by")
  @@index([updatedBy], map: "ix_currency_updated_by")
  @@map("currency")
}

model Country {
