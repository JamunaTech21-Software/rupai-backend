  updatedBy        BigInt?   @map("updated_by") @db.UnsignedBigInt

  uomCategory             UomCategory    @relation("UomUomCategory", fields: [uomCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_uom_uom_category")
  creator                 User           @relation("UomCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_uom_created_by")
  updater                 User?          @relation("UomUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_uom_updated_by")
  activityTypeDefaultUoms ActivityType[] @relation("ActivityTypeDefaultUom")
  uomCategoryBaseUoms     UomCategory[]  @relation("UomCategoryBaseUom")

  @@unique([code], map: "ux_uom_code")
  @@unique([baseKey], map: "ux_uom_base")
  @@index([uomCategoryId], map: "ix_uom_uom_category")
  @@index([status], map: "ix_uom_status")
  @@index([createdBy], map: "ix_uom_created_by")
  @@index([updatedBy], map: "ix_uom_updated_by")
