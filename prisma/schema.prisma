// ---- P1.16 Notifications (P3 §28.5, P1 §4.3, §7.1) -------------------------------------------------

/// When to tell whom about what (P3 §28.5). The trigger types are the system's (core/notify); each rule
/// says who hears of it, how far ahead, and whether by email too. Seeded active with conservative
/// defaults (P3 Table 31.2); never deleted, deactivated instead.
model NotificationRule {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code          String    @db.VarChar(40)
  name          String    @db.VarChar(150)
  description   String?   @db.VarChar(500)
  /// approval_pending | approval_unresolved | document_expiry | access_review | budget_threshold |
  /// payment_due | abnormal_yield | low_stock | contract_expiry | lease_due
  triggerType   String    @map("trigger_type") @db.VarChar(40)
  /// Rule parameters of the trigger (P3 §6: JSON only for rule parameters), e.g. which document types.
  conditionJson Json?     @map("condition_json")
  /// Days ahead of a due or expiry date. NULL for triggers without one.
  leadDays      Int?      @map("lead_days") @db.SmallInt
  /// approvers | by_role | by_scope | by_named_user
  recipientRule String    @map("recipient_rule") @db.VarChar(30)
  roleId        BigInt?   @map("role_id") @db.UnsignedBigInt
  /// by_named_user: who. (P3 lists role_id only; a named user needs its own column.)
  userId        BigInt?   @map("user_id") @db.UnsignedBigInt
  /// in_app | email. Every notification is in-app; email also sends it.
  channel       String    @default("in_app") @db.VarChar(20)
  /// info | warning | critical
  severity      String    @default("info") @db.VarChar(20)
  isActive      Boolean   @default(true) @map("is_active")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy     BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt     DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy     BigInt?   @map("updated_by") @db.UnsignedBigInt

  role          Role?          @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_rule_role")
  user          User?          @relation("NotificationRuleUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_rule_user")
  creator       User           @relation("NotificationRuleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_rule_created_by")
  updater       User?          @relation("NotificationRuleUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_rule_updated_by")
  notifications Notification[]

  @@unique([code], map: "ux_notification_rule_code")
  @@index([triggerType, isActive], map: "ix_notification_rule_trigger")
  @@index([roleId], map: "ix_notification_rule_role")
  @@index([userId], map: "ix_notification_rule_user")
  @@index([createdBy], map: "ix_notification_rule_created_by")
  @@index([updatedBy], map: "ix_notification_rule_updated_by")
  @@map("notification_rule")
}

/// One message to one user (P3 §28.5). Written by jobs, never inside a business transaction (P1 §4.3).
/// The dedupe key makes a re-run of the same evaluation, or of the nightly job, write nothing new.
model Notification {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  notificationRuleId BigInt    @map("notification_rule_id") @db.UnsignedBigInt
  userId             BigInt    @map("user_id") @db.UnsignedBigInt
  subject            String    @db.VarChar(200)
  body               String    @db.VarChar(2000)
  /// What it is about (polymorphic): approval_request, document_file, job, approval_queue.<type>.
  linkType           String    @map("link_type") @db.VarChar(50)
  linkId             BigInt    @map("link_id") @db.UnsignedBigInt
  /// info | warning | critical
  severity           String    @db.VarChar(20)
  /// The day of the occurrence it reports (the expiry date, the day the step started): the dedupe
  /// key's date, so the same occurrence is never reported twice.
  generationDate     DateTime  @map("generation_date") @db.Date
  readAt             DateTime? @map("read_at") @db.DateTime(0)
  dismissedAt        DateTime? @map("dismissed_at") @db.DateTime(0)
  /// not_required (in-app only) | pending | sending | sent | failed | skipped (no email address)
  deliveryState      String    @map("delivery_state") @db.VarChar(20)
  deliveryAttempts   Int       @default(0) @map("delivery_attempts") @db.SmallInt
  /// When the last send was started; a send that never finished is found by it.
  deliveryStartedAt  DateTime? @map("delivery_started_at") @db.DateTime(0)
  deliveredAt        DateTime? @map("delivered_at") @db.DateTime(0)
  deliveryError      String?   @map("delivery_error") @db.VarChar(500)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)

  rule NotificationRule @relation(fields: [notificationRuleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_rule")
  user User             @relation("NotificationUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_notification_user")

  @@unique([notificationRuleId, userId, linkType, linkId, generationDate], map: "ux_notification_dedupe")
  @@index([userId, dismissedAt, id], map: "ix_notification_user")
  @@index([deliveryState, id], map: "ix_notification_delivery")
  @@index([createdAt], map: "ix_notification_created_at")
  @@map("notification")
}

// ---- P1.17 import framework (Spec P2 §11.4, P3 §32.5, P4 §6.7, P5 §7.6) ------------------------------

/// One uploaded file of one import type: template → upload → validation (a job) → error report →
/// correct and re-upload (a new batch) → commit (a job) → result. Kept after commit, so an import can be
/// audited (P3 §32.5).
model ImportBatch {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// The registered import type, e.g. lookup.amenity (core/imports/registry.ts).
  importType     String    @map("import_type") @db.VarChar(60)
  /// validating | validated | rejected | committing | committed | cancelled
  state          String    @default("validating") @db.VarChar(20)
  /// As uploaded: metadata only (the stored file has a generated key).
  fileName       String    @map("file_name") @db.VarChar(255)
  /// xlsx | csv
  fileFormat     String    @map("file_format") @db.VarChar(10)
  fileKey        String?   @map("file_key") @db.VarChar(100)
  fileSha256     String    @map("file_sha256") @db.Char(64)
  fileSize       Int       @map("file_size")
  rowCount       Int       @default(0) @map("row_count")
  validCount     Int       @default(0) @map("valid_count")
  errorCount     Int       @default(0) @map("error_count")
  committedCount Int       @default(0) @map("committed_count")
  /// Valid at validation, refused at commit (e.g. the code was taken meanwhile).
  failedCount    Int       @default(0) @map("failed_count")
  /// rejected: why the file could not be read at all (no header, unknown columns, too many rows).
  problems       Json?
  validateJobId  BigInt?   @map("validate_job_id") @db.UnsignedBigInt
  commitJobId    BigInt?   @map("commit_job_id") @db.UnsignedBigInt
  validatedAt    DateTime? @map("validated_at") @db.DateTime(0)
  committedAt    DateTime? @map("committed_at") @db.DateTime(0)
  cancelledAt    DateTime? @map("cancelled_at") @db.DateTime(0)
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy      BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt      DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy      BigInt?   @map("updated_by") @db.UnsignedBigInt

  rows        ImportRow[]
  validateJob Job?        @relation("ImportValidateJob", fields: [validateJobId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_import_batch_validate_job")
  commitJob   Job?        @relation("ImportCommitJob", fields: [commitJobId], references: [id], onDelete: SetNull, onUpdate: Restrict, map: "fk_import_batch_commit_job")
  creator     User        @relation("ImportBatchCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_import_batch_created_by")
  updater     User?       @relation("ImportBatchUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_import_batch_updated_by")

  @@index([importType, createdAt], map: "ix_import_batch_type")
  @@index([state], map: "ix_import_batch_state")
  @@index([createdBy, createdAt], map: "ix_import_batch_created_by")
  @@index([updatedBy], map: "ix_import_batch_updated_by")
  @@index([validateJobId], map: "ix_import_batch_validate_job")
  @@index([commitJobId], map: "ix_import_batch_commit_job")
  @@map("import_batch")
}

/// The staging row: one data row of the file as read (column → text), its errors, and what commit made
/// of it. One table for every import type (BACKLOG D-1.17-2).
model ImportRow {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  importBatchId BigInt    @map("import_batch_id") @db.UnsignedBigInt
  /// The row number in the file (the header is row 1), as the error report names it.
  rowNumber     Int       @map("row_number")
  /// The row as read: { column: text }.
  data          Json
  /// valid | invalid | committed | failed
  state         String    @db.VarChar(20)
  /// [{ column, code, message }] when invalid or failed.
  errors        Json?
  /// The record the row became, e.g. the new amenity's id.
  targetId      String?   @map("target_id") @db.VarChar(26)
  committedAt   DateTime? @map("committed_at") @db.DateTime(0)

  batch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_import_row_batch")

  @@unique([importBatchId, rowNumber], map: "ux_import_row")
  @@index([importBatchId, state], map: "ix_import_row_state")
  @@map("import_row")
}

// ---- P2.01 person registry (Spec P3 §8.1, P1 §5.5; the manager's design, BACKLOG D-2-1) ------------

/// A person exists once (P1 §5.5): identity, contact and payment details. NO employment attribute: those
/// are the employment profile's (P2.02).
model Person {
  id                         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// Permanent identity reference, numbered by the `person` number format (PRS-000001).
  personCode                 String    @map("person_code") @db.VarChar(20)
  /// The estate that registered the person: decides who sees them until a profile places them (D-2.01-2).
  registeredEstateId         BigInt?   @map("registered_estate_id") @db.UnsignedBigInt
  /// mr | mrs | ms | other
  title                      String?   @db.VarChar(10)
  firstName                  String    @map("first_name") @db.VarChar(100)
  middleName                 String?   @map("middle_name") @db.VarChar(100)
  lastName                   String?   @map("last_name") @db.VarChar(100)
  /// Maintained by the application from the name parts, for search and printing.
  fullName                   String    @map("full_name") @db.VarChar(200)
  fatherName                 String?   @map("father_name") @db.VarChar(150)
  motherName                 String?   @map("mother_name") @db.VarChar(150)
  spouseName                 String?   @map("spouse_name") @db.VarChar(150)
  dateOfBirth                DateTime? @map("date_of_birth") @db.Date
  /// male | female | other
  gender                     String?   @db.VarChar(30)
  /// single | married | widowed | divorced
  maritalStatus              String?   @map("marital_status") @db.VarChar(30)
  bloodGroup                 String?   @map("blood_group") @db.VarChar(10)
  nationalityCountryId       BigInt?   @map("nationality_country_id") @db.UnsignedBigInt
  religionId                 BigInt?   @map("religion_id") @db.UnsignedBigInt
  /// Unique where present (several NULLs allowed).
  nationalId                 String?   @map("national_id") @db.VarChar(30)
  birthCertificateNo         String?   @map("birth_certificate_no") @db.VarChar(30)
  passportNo                 String?   @map("passport_no") @db.VarChar(30)
  drivingLicenseNo           String?   @map("driving_license_no") @db.VarChar(30)
  tin                        String?   @db.VarChar(30)
  phone                      String?   @db.VarChar(30)
  alternatePhone             String?   @map("alternate_phone") @db.VarChar(30)
  personalEmail              String?   @map("personal_email") @db.VarChar(150)
  presentAddress             String?   @map("present_address") @db.VarChar(300)
  presentDistrict            String?   @map("present_district") @db.VarChar(100)
  presentUpazila             String?   @map("present_upazila") @db.VarChar(100)
  presentPostalCode          String?   @map("present_postal_code") @db.VarChar(20)
  permanentAddress           String?   @map("permanent_address") @db.VarChar(300)
  permanentDistrict          String?   @map("permanent_district") @db.VarChar(100)
  permanentUpazila           String?   @map("permanent_upazila") @db.VarChar(100)
  permanentPostalCode        String?   @map("permanent_postal_code") @db.VarChar(20)
  educationLevelId           BigInt?   @map("education_level_id") @db.UnsignedBigInt
  experienceYears            Int?      @map("experience_years")
  emergencyContactName       String?   @map("emergency_contact_name") @db.VarChar(150)
  emergencyContactPhone      String?   @map("emergency_contact_phone") @db.VarChar(30)
  emergencyContactAltPhone   String?   @map("emergency_contact_alt_phone") @db.VarChar(30)
  emergencyContactRelation   String?   @map("emergency_contact_relation") @db.VarChar(30)
  emergencyContactAddress    String?   @map("emergency_contact_address") @db.VarChar(300)
  /// bank | cash | mobile_banking
  paymentMethod              String?   @map("payment_method") @db.VarChar(30)
  bankName                   String?   @map("bank_name") @db.VarChar(150)
  bankBranch                 String?   @map("bank_branch") @db.VarChar(150)
  /// Payment details belong to the person, not the profile (P3 §8.1).
  bankAccountNumber          String?   @map("bank_account_number") @db.VarChar(40)
  /// bkash | nagad | rocket | upay | other
  mobileBankingProvider      String?   @map("mobile_banking_provider") @db.VarChar(30)
  mobileBankingNumber        String?   @map("mobile_banking_number") @db.VarChar(30)
  remarks                    String?   @db.VarChar(500)
  /// active | inactive
  status                     String    @default("active") @db.VarChar(30)
  version                    Int       @default(1)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy                  BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt                  DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy                  BigInt?   @map("updated_by") @db.UnsignedBigInt

  registeredEstate Estate?          @relation(fields: [registeredEstateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_person_registered_estate")
  nationality      Country?         @relation(fields: [nationalityCountryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_person_nationality")
  religion         Religion?        @relation(fields: [religionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_person_religion")
  educationLevel   EducationLevel?  @relation(fields: [educationLevelId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_person_education_level")
  dependents       PersonDependent[]
  profiles         EmploymentProfile[]
  skillLinks       PersonSkill[]
  languageLinks    PersonLanguage[]
  creator          User             @relation("PersonCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_person_created_by")
  updater          User?            @relation("PersonUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_person_updated_by")

  @@unique([personCode], map: "ux_person_code")
  @@unique([nationalId], map: "ux_person_nid")
  @@index([firstName], map: "ix_person_first_name")
  @@index([fullName], map: "ix_person_full_name")
  @@index([phone], map: "ix_person_phone")
  @@index([registeredEstateId], map: "ix_person_registered_estate")
  @@index([nationalityCountryId], map: "ix_person_nationality")
  @@index([religionId], map: "ix_person_religion")
  @@index([educationLevelId], map: "ix_person_education_level")
  @@index([status], map: "ix_person_status")
  @@index([createdBy], map: "ix_person_created_by")
  @@index([updatedBy], map: "ix_person_updated_by")
  @@map("person")
}

