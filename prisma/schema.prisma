/// Contacts of any owner (P3 §6.2), so phone numbers are never comma-separated text. Polymorphic:
/// owner_id has no foreign key (P2 §7.2); the service checks the owner exists and is in scope.
model PartyContact {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// buyer | broker | supplier | leaf_supplier | contractor | warehouse | party | auction_centre
  ownerType   String    @map("owner_type") @db.VarChar(30)
  ownerId     BigInt    @map("owner_id") @db.UnsignedBigInt
  contactName String    @map("contact_name") @db.VarChar(150)
  designation String?   @db.VarChar(100)
  /// primary | accounts | operations | emergency | other
  contactType String    @map("contact_type") @db.VarChar(30)
  phone       String?   @db.VarChar(30)
  phoneAlt    String?   @map("phone_alt") @db.VarChar(30)
  email       String?   @db.VarChar(150)
  isPrimary   Boolean   @default(false) @map("is_primary")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  /// GENERATED column (see migration SQL): the owner while this is its active primary contact, else
  /// NULL. Its unique index makes "at most one primary per owner" a database guarantee.
  primaryKey  String?   @map("primary_key") @db.VarChar(60)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy   BigInt?   @map("updated_by") @db.UnsignedBigInt

  creator User  @relation("PartyContactCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_party_contact_created_by")
  updater User? @relation("PartyContactUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_party_contact_updated_by")

  @@unique([primaryKey], map: "ux_party_contact_primary")
  @@index([ownerType, ownerId], map: "ix_party_contact_owner")
  @@index([createdBy], map: "ix_party_contact_created_by")
  @@index([updatedBy], map: "ix_party_contact_updated_by")
  @@map("party_contact")
}

// ---- P1.09 calendars (Spec P3 §4.8–§4.10, P1 §5.2, §14) ------------------------------------------

/// The agricultural calendar of ONE estate (P3 §4.8). Independent of the fiscal calendar: nothing may
/// infer one from the other (P1 §5.2). Seasons of an estate never overlap; a closed season rejects new
/// operational transactions dated within it.
model Season {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  estateId  BigInt    @map("estate_id") @db.UnsignedBigInt
  /// For example 2026-27. Unique within the estate.
  code      String    @db.VarChar(20)
  name      String    @db.VarChar(150)
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  /// planned | active | closed
  state     String    @default("planned") @db.VarChar(30)
  closedAt  DateTime? @map("closed_at") @db.DateTime(0)
  closedBy  BigInt?   @map("closed_by") @db.UnsignedBigInt
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy BigInt?   @map("updated_by") @db.UnsignedBigInt

  estate  Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_season_estate")
  closer  User?  @relation("SeasonClosedBy", fields: [closedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_season_closed_by")
  creator User   @relation("SeasonCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_season_created_by")
  updater User?  @relation("SeasonUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_season_updated_by")

  @@unique([estateId, code], map: "ux_season_code")
  @@index([estateId, startDate, endDate], map: "ix_season_dates")
  @@index([state], map: "ix_season_state")
  @@index([closedBy], map: "ix_season_closed_by")
  @@index([createdBy], map: "ix_season_created_by")
  @@index([updatedBy], map: "ix_season_updated_by")
  @@map("season")
}

/// The accounting calendar of the whole organisation (P3 §4.9, decision O-17): no estate_id, ever.
model FiscalYear {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organisationId BigInt    @map("organisation_id") @db.UnsignedBigInt
  /// For example FY2026-27.
  code           String    @db.VarChar(20)
  name           String    @db.VarChar(150)
  /// Derived from organisation.fiscal_year_start_month on creation.
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  /// future | open | closed
  state          String    @default("future") @db.VarChar(30)
  closedAt       DateTime? @map("closed_at") @db.DateTime(0)
  closedBy       BigInt?   @map("closed_by") @db.UnsignedBigInt
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy      BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt      DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy      BigInt?   @map("updated_by") @db.UnsignedBigInt

  organisation Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_year_organisation")
  closer       User?              @relation("FiscalYearClosedBy", fields: [closedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_year_closed_by")
  creator      User               @relation("FiscalYearCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_year_created_by")
  updater      User?              @relation("FiscalYearUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_year_updated_by")
  periods      AccountingPeriod[]

  @@unique([organisationId, code], map: "ux_fiscal_year_code")
  @@unique([organisationId, startDate], map: "ux_fiscal_year_start")
  @@index([startDate, endDate], map: "ix_fiscal_year_dates")
  @@index([state], map: "ix_fiscal_year_state")
  @@index([closedBy], map: "ix_fiscal_year_closed_by")
  @@index([createdBy], map: "ix_fiscal_year_created_by")
  @@index([updatedBy], map: "ix_fiscal_year_updated_by")
  @@map("fiscal_year")
}

/// One period of a fiscal year (P3 §4.10): 1–12 monthly, 13 reserved for year-end adjustments. Every
/// posting tests this row's state: the single point of period control (P1 §14).
model AccountingPeriod {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  fiscalYearId BigInt    @map("fiscal_year_id") @db.UnsignedBigInt
  periodNumber Int       @map("period_number") @db.SmallInt
  name         String    @db.VarChar(100)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  /// future | open | soft_closed | closed | reopened (P1 Table 14.1)
  state        String    @default("future") @db.VarChar(30)
  closedAt     DateTime? @map("closed_at") @db.DateTime(0)
  closedBy     BigInt?   @map("closed_by") @db.UnsignedBigInt
  reopenedAt   DateTime? @map("reopened_at") @db.DateTime(0)
  reopenedBy   BigInt?   @map("reopened_by") @db.UnsignedBigInt
  /// Required when reopened_at is set.
  reopenReason String?   @map("reopen_reason") @db.VarChar(500)
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy    BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt    DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy    BigInt?   @map("updated_by") @db.UnsignedBigInt

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_period_fiscal_year")
  closer     User?      @relation("AccountingPeriodClosedBy", fields: [closedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_period_closed_by")
  reopener   User?      @relation("AccountingPeriodReopenedBy", fields: [reopenedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_period_reopened_by")
  creator    User       @relation("AccountingPeriodCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_period_created_by")
  updater    User?      @relation("AccountingPeriodUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_period_updated_by")

  @@unique([fiscalYearId, periodNumber], map: "ux_period")
  @@index([startDate, endDate], map: "ix_accounting_period_dates")
  @@index([state], map: "ix_accounting_period_state")
  @@index([closedBy], map: "ix_accounting_period_closed_by")
  @@index([reopenedBy], map: "ix_accounting_period_reopened_by")
  @@index([createdBy], map: "ix_accounting_period_created_by")
  @@index([updatedBy], map: "ix_accounting_period_updated_by")
  @@map("accounting_period")
}

