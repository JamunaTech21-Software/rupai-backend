/// P3 §28.1, plus granted_at / granted_by / expires_at for temporary role grants (P6 §11.2).
model UserRole {
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  roleId    BigInt    @map("role_id") @db.UnsignedBigInt
  grantedAt DateTime  @default(now()) @map("granted_at") @db.DateTime(0)
  grantedBy BigInt    @map("granted_by") @db.UnsignedBigInt
  /// NULL = permanent. A lapsed grant confers nothing; no job is needed to revoke it.
  expiresAt DateTime? @map("expires_at") @db.DateTime(0)

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_role_user")
  role    Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_role_role")
  granter User @relation("UserRoleGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_role_granted_by")

  @@id([userId, roleId])
  @@index([roleId], map: "ix_user_role_role")
  @@index([grantedBy], map: "ix_user_role_granted_by")
  @@index([expiresAt], map: "ix_user_role_expires")
  @@map("user_role")
}

// ---------------------------------------------------------------------------------------------
// P1.02 — Authentication & sessions (P4 §2.2, P1 §12.4). Not in P3: the server-side revocation
// state that P4 §2.2.1 requires ("a store of active token identifiers ... with a database fallback").
// ---------------------------------------------------------------------------------------------

/// One sign-in = one session = one refresh-token family. Revoking it ends the family at once.
model AuthSession {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt    @map("user_id") @db.UnsignedBigInt
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.DateTime(0)
  /// Absolute end of the session, however often it is refreshed.
  expiresAt     DateTime  @map("expires_at") @db.DateTime(0)
  revokedAt     DateTime? @map("revoked_at") @db.DateTime(0)
  /// logout | logout_all | session_revoked | refresh_reuse | user_disabled | password_changed | password_reset
  revokedReason String?   @map("revoked_reason") @db.VarChar(30)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.VarChar(255)

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_auth_session_user")
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt], map: "ix_auth_session_user_revoked")
  @@index([expiresAt], map: "ix_auth_session_expires")
  @@map("auth_session")
}

/// Every refresh token ever issued in a session. Only the SHA-256 of the token is stored. A token that
/// was already used (rotated) and is presented again is theft: the whole session is revoked.
model AuthRefreshToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sessionId BigInt    @map("session_id") @db.UnsignedBigInt
  tokenHash String    @map("token_hash") @db.Char(64)
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.DateTime(0)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  /// Set when the token is rotated. A used token is never valid again.
  usedAt    DateTime? @map("used_at") @db.DateTime(0)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_auth_refresh_token_session")

  @@unique([tokenHash], map: "ux_auth_refresh_token_hash")
  @@index([sessionId], map: "ix_auth_refresh_token_session")
  @@map("auth_refresh_token")
}

/// Single-use password reset links (P4 §2.2.3). Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash   String    @map("token_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(0)
  usedAt      DateTime? @map("used_at") @db.DateTime(0)
  requestedIp String?   @map("requested_ip") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_password_reset_token_user")

  @@unique([tokenHash], map: "ux_password_reset_token_hash")
  @@index([userId], map: "ix_password_reset_token_user")
  @@map("password_reset_token")
}

// ---------------------------------------------------------------------------------------------
// P1.03 — Data scope (P3 §28.2, P6 §4, P1 §12.2). Which records a user may touch; permission (P1.01)
// decides what they may do. Both must pass.
// ---------------------------------------------------------------------------------------------

/// P3 §28.2 + audit block + `version` (P4 §5.1). scope_id is polymorphic (estate, division, section,
/// department, factory or warehouse id), so it has no foreign key; the API checks the target exists once its
/// table does (P1.07 estate hierarchy, P2 departments).
model UserScope {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  /// all_estates | estate | division | section | department | factory | warehouse | self
  scopeType String    @map("scope_type") @db.VarChar(30)
  /// NULL for all_estates and self.
  scopeId   BigInt?   @map("scope_id") @db.UnsignedBigInt
  /// GENERATED column (see migration SQL): IFNULL(scope_id, 0), so the unique key also covers the
  /// NULL-id types (MySQL treats NULLs as distinct). Read-only: never set it from code.
  scopeKey  BigInt?   @map("scope_key") @db.UnsignedBigInt
  grantedAt DateTime  @default(now()) @map("granted_at") @db.DateTime(0)
  grantedBy BigInt    @map("granted_by") @db.UnsignedBigInt
  /// NULL = permanent. A lapsed grant confers nothing; no job is needed to revoke it.
  expiresAt DateTime? @map("expires_at") @db.DateTime(0)
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy BigInt?   @map("updated_by") @db.UnsignedBigInt

  user    User  @relation("UserScopeUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_scope_user")
  granter User  @relation("UserScopeGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_scope_granted_by")
  creator User  @relation("UserScopeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_scope_created_by")
  updater User? @relation("UserScopeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_scope_updated_by")

  @@unique([userId, scopeType, scopeKey], map: "ux_user_scope")
  @@index([expiresAt], map: "ix_user_scope_expires")
  @@index([scopeType, scopeId], map: "ix_user_scope_target")
  @@index([grantedBy], map: "ix_user_scope_granted_by")
  @@index([createdBy], map: "ix_user_scope_created_by")
  @@index([updatedBy], map: "ix_user_scope_updated_by")
  @@map("user_scope")
}

// ---------------------------------------------------------------------------------------------
// P1.04 — Separation of duties and sensitive permissions (P6 §5.3, §9, §10). Not in P3: the record
// P6 requires of each override ("the user, the conflicting permissions, the rule, the reason, who
// authorised it, and when") and of each sensitive grant ("named written authorisation ... recorded").
// ---------------------------------------------------------------------------------------------

/// One recorded, named authorisation for one user: an override of a prohibited combination
/// (sod_override) or the grant of a sensitive permission (sensitive_grant). It stays on the
/// concentration report until it is removed. Never deleted by the application.
model AccessAuthorisation {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt    @map("user_id") @db.UnsignedBigInt
  /// sod_override | sensitive_grant
  kind             String    @db.VarChar(30)
  /// The P6 Table 5.1 rule (SOD-1 … SOD-7), or SENSITIVE.
  ruleCode         String    @map("rule_code") @db.VarChar(20)
  /// Stable identity of what was authorised, e.g. "SOD-2:payroll.approve+payroll.post".
  authorisationKey String    @map("authorisation_key") @db.VarChar(255)
  /// The permissions involved, comma-separated and sorted.
  permissions      String    @db.VarChar(500)
  reason           String    @db.VarChar(1000)
  authorisedBy     BigInt    @map("authorised_by") @db.UnsignedBigInt
  authorisedAt     DateTime  @default(now()) @map("authorised_at") @db.DateTime(0)
  removedAt        DateTime? @map("removed_at") @db.DateTime(0)
  removedBy        BigInt?   @map("removed_by") @db.UnsignedBigInt
  /// GENERATED column (see migration SQL): the key while active, NULL once removed. Read-only.
  activeKey        String?   @map("active_key") @db.VarChar(255)

  user       User  @relation("AccessAuthorisationUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_access_authorisation_user")
  authoriser User  @relation("AccessAuthorisationBy", fields: [authorisedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_access_authorisation_by")
  remover    User? @relation("AccessAuthorisationRemovedBy", fields: [removedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_access_authorisation_removed_by")

  @@unique([userId, activeKey], map: "ux_access_authorisation_active")
  @@index([kind, removedAt], map: "ix_access_authorisation_kind")
  @@index([authorisedBy], map: "ix_access_authorisation_by")
  @@index([removedBy], map: "ix_access_authorisation_removed_by")
  @@map("access_authorisation")
}

// ---------------------------------------------------------------------------------------------
// P1.05 — Audit (P3 §29, P1 §13, P2 §6.3). Four APPEND-ONLY tables: the application account holds no
// UPDATE or DELETE grant on any of them, at any permission level, including administrator.
// ---------------------------------------------------------------------------------------------

/// P3 §29.1. Field-level before/after values. Depth per record class (P1 Table 13.1).
model AuditChange {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// Short entity key (user, role, user_scope, …), never a class or model name.
  recordType      String   @map("record_type") @db.VarChar(40)
  /// Wide enough for both BIGINT (as a decimal string) and ULID keys.
  recordId        String   @map("record_id") @db.VarChar(26)
  /// create | update | delete | approve | reject | post | reverse | cancel
  action          String   @db.VarChar(20)
  /// NULL for whole-record actions (create and delete carry a snapshot instead).
  field           String?  @db.VarChar(64)
  oldValue        String?  @map("old_value") @db.LongText
  newValue        String?  @map("new_value") @db.LongText
  changedBy       BigInt   @map("changed_by") @db.UnsignedBigInt
  actingForUserId BigInt?  @map("acting_for_user_id") @db.UnsignedBigInt
  changedAt       DateTime @default(now()) @map("changed_at") @db.DateTime(0)
  /// Financial and policy records only.
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent") @db.VarChar(255)
  reason          String?  @db.VarChar(500)

  changer   User  @relation("AuditChangeBy", fields: [changedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_change_changed_by")
  actingFor User? @relation("AuditChangeActingFor", fields: [actingForUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_change_acting_for")

  @@index([recordType, recordId, changedAt], map: "ix_audit_record")
  @@index([changedBy, changedAt], map: "ix_audit_user")
  @@index([changedAt], map: "ix_audit_changed_at")
  @@index([actingForUserId], map: "ix_audit_acting_for")
  @@map("audit_change")
}

/// P3 §29.2. Lifecycle transitions. A record's current state must be reproducible from it.
model StatusHistory {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  recordType     String   @map("record_type") @db.VarChar(40)
  recordId       String   @map("record_id") @db.VarChar(26)
  /// NULL for the first state (creation).
  fromState      String?  @map("from_state") @db.VarChar(30)
  toState        String   @map("to_state") @db.VarChar(30)
  changedBy      BigInt   @map("changed_by") @db.UnsignedBigInt
  changedAt      DateTime @default(now()) @map("changed_at") @db.DateTime(0)
  /// FK to workflow_step when the workflow engine arrives (P1.13).
  workflowStepId BigInt?  @map("workflow_step_id") @db.UnsignedBigInt
  comment        String?  @db.VarChar(1000)

  changer User @relation(fields: [changedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_status_history_changed_by")

  @@index([recordType, recordId, changedAt], map: "ix_status_history_record")
  @@index([changedAt], map: "ix_status_history_changed_at")
  @@index([changedBy], map: "ix_status_history_changed_by")
  @@index([workflowStepId], map: "ix_status_history_workflow_step")
  @@map("status_history")
}

/// P3 §29.2 + P1 §12.4: authentication events, permission and scope denials, exports and prints.
model AccessLog {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// NULL when no user is known (a sign-in attempt for an unknown username).
  userId          BigInt?  @map("user_id") @db.UnsignedBigInt
  eventType       String   @map("event_type") @db.VarChar(30)
  module          String?  @db.VarChar(40)
  recordReference String?  @map("record_reference") @db.VarChar(100)
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent") @db.VarChar(255)
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.DateTime(0)
  /// Structured context (reason, session, filters of an export). Never a password or token.
  detail          Json?

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_access_log_user")

  @@index([userId, occurredAt], map: "ix_access_log_user")
  @@index([occurredAt], map: "ix_access_log_occurred_at")
  @@index([eventType, occurredAt], map: "ix_access_log_event")
  @@map("access_log")
}

/// P3 §29.2. Calls to and from external systems. Never stores a biometric payload (P3 §9.4).
model IntegrationLog {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// face_recognition | broker_import | other
  integrationKey   String   @map("integration_key") @db.VarChar(40)
  /// inbound | outbound
  direction        String   @db.VarChar(10)
  requestReference String?  @map("request_reference") @db.VarChar(100)
  endpoint         String?  @db.VarChar(255)
  statusCode       Int?     @map("status_code")
  /// success | failure
  outcome          String   @db.VarChar(20)
  durationMs       Int?     @map("duration_ms")
  errorMessage     String?  @map("error_message") @db.VarChar(1000)
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.DateTime(0)
  relatedType      String?  @map("related_type") @db.VarChar(40)
  relatedId        String?  @map("related_id") @db.VarChar(26)

  @@index([occurredAt], map: "ix_integration_log_occurred_at")
  @@index([integrationKey, occurredAt], map: "ix_integration_log_key")
  @@index([relatedType, relatedId], map: "ix_integration_log_related")
  @@map("integration_log")
}

// ---- P1.07 organisation and estate hierarchy (Spec P3 §4.1–§4.5) ---------------------------------

/// One row per deployment (P3 §4.1): the GENERATED singleton key makes a second row impossible, and the
/// API refuses to start without one. country_id and base_currency_id gain their foreign keys and NOT NULL
/// in P1.10, which creates country and currency (BACKLOG D-1.07-1).
model Organisation {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String    @db.VarChar(150)
  shortName            String    @map("short_name") @db.VarChar(50)
  registrationNumber   String?   @map("registration_number") @db.VarChar(50)
  tin                  String?   @db.VarChar(30)
  vatRegistration      String?   @map("vat_registration") @db.VarChar(30)
  addressLine1         String?   @map("address_line1") @db.VarChar(200)
  addressLine2         String?   @map("address_line2") @db.VarChar(200)
  city                 String?   @db.VarChar(100)
  postalCode           String?   @map("postal_code") @db.VarChar(20)
  countryId            BigInt    @map("country_id") @db.UnsignedBigInt
  phone                String?   @db.VarChar(30)
  email                String?   @db.VarChar(150)
  website              String?   @db.VarChar(150)
  logoPath             String?   @map("logo_path") @db.VarChar(255)
  baseCurrencyId       BigInt    @map("base_currency_id") @db.UnsignedBigInt
  /// 1 to 12. Governs every estate (O-17).
  fiscalYearStartMonth Int       @map("fiscal_year_start_month") @db.SmallInt
  /// active | inactive
  status               String    @default("active") @db.VarChar(30)
  /// GENERATED column (see migration SQL): always 1, under a unique index, so there is one row at most.
  singleton            Int?      @db.TinyInt
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy            BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt            DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy            BigInt?   @map("updated_by") @db.UnsignedBigInt

  creator      User         @relation("OrganisationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_organisation_created_by")
  updater      User?        @relation("OrganisationUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_organisation_updated_by")
  estates      Estate[]
  factories    Factory[]
  warehouses   Warehouse[]
  fiscalYears  FiscalYear[]
  country      Country      @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_organisation_country")
  baseCurrency Currency     @relation(fields: [baseCurrencyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_organisation_base_currency")

  @@unique([singleton], map: "ux_organisation_singleton")
  @@index([countryId], map: "ix_organisation_country")
  @@index([baseCurrencyId], map: "ix_organisation_base_currency")
  @@index([createdBy], map: "ix_organisation_created_by")
  @@index([updatedBy], map: "ix_organisation_updated_by")
  @@map("organisation")
}

/// Estate tier root (P3 §4.2). Deactivated, never deleted once referenced. manager_profile_id gains its
/// foreign key to employment_profile in Phase 2 (BACKLOG D-1.07-2).
model Estate {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organisationId   BigInt    @map("organisation_id") @db.UnsignedBigInt
  /// Unique within the organisation; appears in document numbers.
  code             String    @db.VarChar(20)
  name             String    @db.VarChar(150)
  location         String?   @db.VarChar(200)
  addressLine1     String?   @map("address_line1") @db.VarChar(200)
  district         String?   @db.VarChar(100)
  /// ACRES (D-R.2-1). Declared total land area: the authoritative figure is the sum of land_parcel
  /// once the land register exists.
  totalArea        Decimal?  @map("total_area") @db.Decimal(14, 3)
  managerProfileId BigInt?   @map("manager_profile_id") @db.UnsignedBigInt
  phone            String?   @db.VarChar(30)
  email            String?   @db.VarChar(150)
  /// DEPRECATED (R.2): replaced by established_year; kept until the contract migration.
  establishedOn    DateTime? @map("established_on") @db.Date
  /// DEPRECATED (R.2): replaced by estate_type; kept until the contract migration.
  ownershipType    String?   @map("ownership_type") @db.VarChar(30)
  // ---- R.2 Estate profile (the manager's design, 2026-10-14) ----
  establishedYear  Int?      @map("established_year") @db.SmallInt
  /// The company or person that owns the estate.
  ownerName        String?   @map("owner_name") @db.VarChar(150)
  /// company_owned | private_estate | government_estate
  estateType       String?   @map("estate_type") @db.VarChar(30)
  /// large | medium | small
  estateCategory   String?   @map("estate_category") @db.VarChar(30)
  policeStation    String?   @map("police_station") @db.VarChar(100)
  /// The administrative division of the country (e.g. Rangpur), not one of the estate's own divisions.
  adminDivision    String?   @map("admin_division") @db.VarChar(100)
  countryId        BigInt?   @map("country_id") @db.UnsignedBigInt
  postalCode       String?   @map("postal_code") @db.VarChar(20)
  website          String?   @db.VarChar(150)
  latitude         Decimal?  @db.Decimal(9, 6)
  longitude        Decimal?  @db.Decimal(9, 6)
  description      String?   @db.Text
  /// Facilities that are not on the amenity list ("Other").
  otherAmenities   String?   @map("other_amenities") @db.VarChar(300)
  // ---- Estate Overview figures as entered (RUP-625). NULL: not entered, the computed one is shown ----
  /// Acres.
  teaArea          Decimal?  @map("tea_area") @db.Decimal(14, 3)
  /// Acres.
  nonTeaArea       Decimal?  @map("non_tea_area") @db.Decimal(14, 3)
  divisionCount    Int?      @map("division_count")
  sectionCount     Int?      @map("section_count")
  fieldCount       Int?      @map("field_count")
  workerCount      Int?      @map("worker_count")
  familyCount      Int?      @map("family_count")
  /// active | inactive
  status           String    @default("active") @db.VarChar(30)
  remarks          String?   @db.VarChar(500)
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy        BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt        DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy        BigInt?   @map("updated_by") @db.UnsignedBigInt

  organisation          Organisation           @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_estate_organisation")
  creator               User                   @relation("EstateCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_estate_created_by")
  updater               User?                  @relation("EstateUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_estate_updated_by")
  divisions             Division[]
  fields                Field[]
  country               Country?               @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_estate_country")
  amenityLinks          EstateAmenity[]
  factories             Factory[]
  seasons               Season[]
  persons               Person[]
  profiles              EmploymentProfile[]    @relation("ProfileEstate")
  assignments           EmploymentAssignment[]
  workerTeams           WorkerTeam[]
  registeredContractors Contractor[]
  contractorContracts   ContractorContract[]
  leaveRequests         LeaveRequest[]
  welfareCases          WelfareCase[]
  trainingPrograms      TrainingProgram[]
  goals                 Goal[]
  evaluations           Evaluation[]
  manager               EmploymentProfile?     @relation("EstateManager", fields: [managerProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_estate_manager")
  shifts                Shift[]                @relation("ShiftEstate")

  workflows Workflow[]

  @@unique([organisationId, code], map: "ux_estate_code")
  @@index([status], map: "ix_estate_status")
  @@index([managerProfileId], map: "ix_estate_manager")
  @@index([countryId], map: "ix_estate_country")
  @@index([createdBy], map: "ix_estate_created_by")
  @@index([updatedBy], map: "ix_estate_updated_by")
  @@map("estate")
}

/// P3 §4.3.
model Division {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  estateId         BigInt    @map("estate_id") @db.UnsignedBigInt
  /// Unique within the estate.
  code             String    @db.VarChar(20)
  name             String    @db.VarChar(150)
  managerProfileId BigInt?   @map("manager_profile_id") @db.UnsignedBigInt
  /// Acres.
  area             Decimal?  @db.Decimal(14, 3)
  /// R.3 (the manager's design).
  description      String?   @db.VarChar(1000)
  /// active | inactive
  status           String    @default("active") @db.VarChar(30)
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy        BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt        DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy        BigInt?   @map("updated_by") @db.UnsignedBigInt

  estate              Estate                 @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_division_estate")
  creator             User                   @relation("DivisionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_division_created_by")
  updater             User?                  @relation("DivisionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_division_updated_by")
  sections            Section[]
  assignments         EmploymentAssignment[]
  workerTeams         WorkerTeam[]
  contractorContracts ContractorContract[]
  manager             EmploymentProfile?     @relation("DivisionManager", fields: [managerProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_division_manager")

  @@unique([estateId, code], map: "ux_division_code")
  @@index([status], map: "ix_division_status")
  @@index([managerProfileId], map: "ix_division_manager")
  @@index([createdBy], map: "ix_division_created_by")
  @@index([updatedBy], map: "ix_division_updated_by")
  @@map("division")
}

/// P3 §4.4. estate_id is deliberately absent: it is reached through division.
model Section {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  divisionId          BigInt    @map("division_id") @db.UnsignedBigInt
  /// Unique within the division.
  code                String    @db.VarChar(20)
  name                String    @db.VarChar(150)
  supervisorProfileId BigInt?   @map("supervisor_profile_id") @db.UnsignedBigInt
  area                Decimal?  @db.Decimal(14, 3)
  /// R.3: a section inside another section of the same division.
  parentSectionId     BigInt?   @map("parent_section_id") @db.UnsignedBigInt
  description         String?   @db.VarChar(1000)
  /// R.3 GIS (RUP-655): the section's outline (GeoJSON Polygon), the design's "Section Boundary" layer.
  boundary            Json?
  /// Computed from the boundary, acres.
  mappedAreaAcres     Decimal?  @map("mapped_area_acres") @db.Decimal(14, 3)
  /// active | inactive
  status              String    @default("active") @db.VarChar(30)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  division    Division               @relation(fields: [divisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_section_division")
  parent      Section?               @relation("SectionParent", fields: [parentSectionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_section_parent")
  children    Section[]              @relation("SectionParent")
  supervisor  EmploymentProfile?     @relation("SectionSupervisor", fields: [supervisorProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_section_supervisor")
  creator     User                   @relation("SectionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_section_created_by")
  updater     User?                  @relation("SectionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_section_updated_by")
  fields      Field[]
  assignments EmploymentAssignment[]
  workerTeams WorkerTeam[]

  @@unique([divisionId, code], map: "ux_section_code")
  @@index([status], map: "ix_section_status")
  @@index([supervisorProfileId], map: "ix_section_supervisor")
  @@index([parentSectionId], map: "ix_section_parent")
  @@index([createdBy], map: "ix_section_created_by")
  @@index([updatedBy], map: "ix_section_updated_by")
  @@map("section")
}

/// P3 §4.5. The field is permanent; what is planted on it is plantation_record (Phase 5). estate_id is
/// denormalised on purpose (query volume) and kept equal to the section's estate by the application.
model Field {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sectionId            BigInt    @map("section_id") @db.UnsignedBigInt
  estateId             BigInt    @map("estate_id") @db.UnsignedBigInt
  /// Unique within the estate.
  fieldNumber          String    @map("field_number") @db.VarChar(20)
  name                 String?   @db.VarChar(150)
  /// Acres.
  grossArea            Decimal   @map("gross_area") @db.Decimal(14, 3)
  /// Acres. Set here until plantation_record derives it (BACKLOG D-1.07-6).
  plantedArea          Decimal?  @map("planted_area") @db.Decimal(14, 3)
  /// producing | young | nursery | uprooted | fallow | abandoned
  fieldStatus          String    @map("field_status") @db.VarChar(30)
  /// When the field joined its current section.
  sectionEffectiveFrom DateTime? @map("section_effective_from") @db.Date
  /// active | inactive
  status               String    @default("active") @db.VarChar(30)
  remarks              String?   @db.VarChar(500)
  // ---- R.3 Field / Block details (the manager's design) ----
  /// tea_field | nursery | extension | infrastructure | drain | road_reserve | shade_area | road_side | water_body
  fieldType            String    @default("tea_field") @map("field_type") @db.VarChar(30)
  /// A block inside another field of the same estate.
  parentFieldId        BigInt?   @map("parent_field_id") @db.UnsignedBigInt
  /// Set here until plantation_record holds it (as planted_area, D-1.07-6).
  plantingYear         Int?      @map("planting_year") @db.SmallInt
  /// Bush type / clone. Set here until plantation_record holds it.
  teaVarietyId         BigInt?   @map("tea_variety_id") @db.UnsignedBigInt
  /// Free text as the estate writes it, e.g. "4ft × 2.5ft".
  spacing              String?   @db.VarChar(50)
  /// Feet above sea level.
  altitude             Decimal?  @db.Decimal(8, 2)
  /// Degrees.
  averageSlope         Decimal?  @map("average_slope") @db.Decimal(5, 2)
  irrigationSourceId   BigInt?   @map("irrigation_source_id") @db.UnsignedBigInt
  soilTypeId           BigInt?   @map("soil_type_id") @db.UnsignedBigInt
  drainageClassId      BigInt?   @map("drainage_class_id") @db.UnsignedBigInt
  // ---- R.3 GIS (RUP-655): the field's shape on the map, as the manager's design shows it ----
  /// GeoJSON geometry, longitude/latitude (WGS 84): Polygon, or LineString for road and drain types.
  boundary             Json?
  /// Computed by the server from the boundary on every save; never sent.
  centroidLatitude     Decimal?  @map("centroid_latitude") @db.Decimal(9, 6)
  centroidLongitude    Decimal?  @map("centroid_longitude") @db.Decimal(9, 6)
  /// Perimeter of a polygon, or length of a line, in km.
  perimeterKm          Decimal?  @map("perimeter_km") @db.Decimal(10, 3)
  /// Area enclosed by the boundary, acres (a check against the typed gross area). NULL for a line.
  mappedAreaAcres      Decimal?  @map("mapped_area_acres") @db.Decimal(14, 3)
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy            BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt            DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy            BigInt?   @map("updated_by") @db.UnsignedBigInt

  section          Section           @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_section")
  parent           Field?            @relation("FieldParent", fields: [parentFieldId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_parent")
  children         Field[]           @relation("FieldParent")
  teaVariety       TeaVariety?       @relation(fields: [teaVarietyId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_tea_variety")
  irrigationSource IrrigationSource? @relation(fields: [irrigationSourceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_irrigation_source")
  soilType         SoilType?         @relation(fields: [soilTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_soil_type")
  drainageClass    DrainageClass?    @relation(fields: [drainageClassId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_drainage_class")
  estate           Estate            @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_estate")
  creator          User              @relation("FieldCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_created_by")
  updater          User?             @relation("FieldUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_updated_by")

  @@unique([estateId, fieldNumber], map: "ux_field_number")
  @@index([sectionId], map: "ix_field_section")
  @@index([fieldStatus], map: "ix_field_status")
  @@index([fieldType], map: "ix_field_type")
  @@index([parentFieldId], map: "ix_field_parent")
  @@index([teaVarietyId], map: "ix_field_tea_variety")
  @@index([irrigationSourceId], map: "ix_field_irrigation_source")
  @@index([soilTypeId], map: "ix_field_soil_type")
  @@index([drainageClassId], map: "ix_field_drainage_class")
  @@index([createdBy], map: "ix_field_created_by")
  @@index([updatedBy], map: "ix_field_updated_by")
  @@map("field")
}

// ---- P1.08 facilities, parties and contacts (Spec P3 §4.6–§4.7, §6.1–§6.2) -----------------------

/// Facility tier (P1 §4.4): belongs to the organisation, not to an estate, because a central factory
/// serves several. Scoped by factory grant. primary_estate_id is informational and never used for
/// scoping or production reporting (estate-wise production derives from leaf origin, P3 §11.2).
model Factory {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organisationId   BigInt    @map("organisation_id") @db.UnsignedBigInt
  code             String    @db.VarChar(20)
  name             String    @db.VarChar(150)
  /// own | external
  factoryType      String    @map("factory_type") @db.VarChar(30)
  primaryEstateId  BigInt?   @map("primary_estate_id") @db.UnsignedBigInt
  location         String?   @db.VarChar(200)
  /// Green leaf intake capacity, kg.
  dailyCapacityKg  Decimal?  @map("daily_capacity_kg") @db.Decimal(14, 3)
  managerProfileId BigInt?   @map("manager_profile_id") @db.UnsignedBigInt
  licenceNumber    String?   @map("licence_number") @db.VarChar(50)
  /// Drives the licence-expiry alert.
  licenceExpiry    DateTime? @map("licence_expiry") @db.Date
  /// active | inactive
  status           String    @default("active") @db.VarChar(30)
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy        BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt        DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy        BigInt?   @map("updated_by") @db.UnsignedBigInt

  organisation  Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_organisation")
  primaryEstate Estate?      @relation(fields: [primaryEstateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_primary_estate")
  creator       User         @relation("FactoryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_created_by")
  updater       User?        @relation("FactoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_updated_by")

  manager EmploymentProfile? @relation("FactoryManager", fields: [managerProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_factory_manager")

  @@unique([organisationId, code], map: "ux_factory_code")
  @@index([primaryEstateId], map: "ix_factory_primary_estate")
  @@index([licenceExpiry], map: "ix_factory_licence_expiry")
  @@index([status], map: "ix_factory_status")
  @@index([createdBy], map: "ix_factory_created_by")
  @@index([updatedBy], map: "ix_factory_updated_by")
  @@map("factory")
}

/// Facility tier, scoped by warehouse grant (P3 §4.7). phone is a CACHE of the primary contact's phone,
/// maintained by the contacts service; party_contact is authoritative (P3 §8 note).
model Warehouse {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organisationId  BigInt    @map("organisation_id") @db.UnsignedBigInt
  code            String    @db.VarChar(20)
  name            String    @db.VarChar(150)
  /// own | rented | third_party
  warehouseType   String    @map("warehouse_type") @db.VarChar(30)
  location        String?   @db.VarChar(200)
  capacityKg      Decimal?  @map("capacity_kg") @db.Decimal(14, 3)
  keeperProfileId BigInt?   @map("keeper_profile_id") @db.UnsignedBigInt
  phone           String?   @db.VarChar(30)
  licenceNumber   String?   @map("licence_number") @db.VarChar(50)
  licenceExpiry   DateTime? @map("licence_expiry") @db.Date
  tin             String?   @db.VarChar(30)
  vatRegistration String?   @map("vat_registration") @db.VarChar(30)
  /// active | inactive
  status          String    @default("active") @db.VarChar(30)
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy       BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt       DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy       BigInt?   @map("updated_by") @db.UnsignedBigInt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_warehouse_organisation")
  creator      User         @relation("WarehouseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_warehouse_created_by")
  updater      User?        @relation("WarehouseUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_warehouse_updated_by")

  @@unique([organisationId, code], map: "ux_warehouse_code")
  @@index([licenceExpiry], map: "ix_warehouse_licence_expiry")
  @@index([status], map: "ix_warehouse_status")
  @@index([createdBy], map: "ix_warehouse_created_by")
  @@index([updatedBy], map: "ix_warehouse_updated_by")
  @@map("warehouse")
}

/// The shared counterparty for lessees and external land-allocation recipients (P3 §6.1).
/// Organisation tier: no estate.
model Party {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// individual | organisation | government
  partyType          String    @map("party_type") @db.VarChar(30)
  code               String    @db.VarChar(20)
  name               String    @db.VarChar(150)
  /// For individuals. Personal data: redacted from logs (P0.02).
  nationalId         String?   @map("national_id") @db.VarChar(30)
  /// For organisations.
  registrationNumber String?   @map("registration_number") @db.VarChar(50)
  addressLine1       String?   @map("address_line1") @db.VarChar(200)
  district           String?   @db.VarChar(100)
  phone              String?   @db.VarChar(30)
  email              String?   @db.VarChar(150)
  /// active | inactive
  status             String    @default("active") @db.VarChar(30)
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy          BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt          DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy          BigInt?   @map("updated_by") @db.UnsignedBigInt

  creator User  @relation("PartyCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_party_created_by")
  updater User? @relation("PartyUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_party_updated_by")

  @@unique([code], map: "ux_party_code")
  @@index([partyType], map: "ix_party_type")
  @@index([name], map: "ix_party_name")
  @@index([createdBy], map: "ix_party_created_by")
  @@index([updatedBy], map: "ix_party_updated_by")
  @@map("party")
}

/// Contacts of any owner (P3 §6.2), so phone numbers are never comma-separated text. Polymorphic:
/// owner_id has no foreign key (P2 §7.2); the service checks the owner exists and is in scope.
model PartyContact {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// buyer | broker | supplier | leaf_supplier | contractor | warehouse | party | auction_centre
  ownerType   String    @map("owner_type") @db.VarChar(30)
  ownerId     BigInt    @map("owner_id") @db.UnsignedBigInt
  contactName String    @map("contact_name") @db.VarChar(150)
  designation String?   @db.VarChar(100)
  /// primary | accounts | operations | emergency | other
  contactType String    @map("contact_type") @db.VarChar(30)
  phone       String?   @db.VarChar(30)
  phoneAlt    String?   @map("phone_alt") @db.VarChar(30)
  email       String?   @db.VarChar(150)
  isPrimary   Boolean   @default(false) @map("is_primary")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  /// GENERATED column (see migration SQL): the owner while this is its active primary contact, else
  /// NULL. Its unique index makes "at most one primary per owner" a database guarantee.
  primaryKey  String?   @map("primary_key") @db.VarChar(60)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy   BigInt?   @map("updated_by") @db.UnsignedBigInt

  creator User  @relation("PartyContactCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_party_contact_created_by")
  updater User? @relation("PartyContactUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_party_contact_updated_by")

  @@unique([primaryKey], map: "ux_party_contact_primary")
  @@index([ownerType, ownerId], map: "ix_party_contact_owner")
  @@index([createdBy], map: "ix_party_contact_created_by")
  @@index([updatedBy], map: "ix_party_contact_updated_by")
  @@map("party_contact")
}

// ---- P1.09 calendars (Spec P3 §4.8–§4.10, P1 §5.2, §14) ------------------------------------------

/// The agricultural calendar of ONE estate (P3 §4.8). Independent of the fiscal calendar: nothing may
/// infer one from the other (P1 §5.2). Seasons of an estate never overlap; a closed season rejects new
/// operational transactions dated within it.
model Season {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  estateId  BigInt    @map("estate_id") @db.UnsignedBigInt
  /// For example 2026-27. Unique within the estate.
  code      String    @db.VarChar(20)
  name      String    @db.VarChar(150)
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  /// planned | active | closed
  state     String    @default("planned") @db.VarChar(30)
  closedAt  DateTime? @map("closed_at") @db.DateTime(0)
  closedBy  BigInt?   @map("closed_by") @db.UnsignedBigInt
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy BigInt?   @map("updated_by") @db.UnsignedBigInt

  estate  Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_season_estate")
  closer  User?  @relation("SeasonClosedBy", fields: [closedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_season_closed_by")
  creator User   @relation("SeasonCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_season_created_by")
  updater User?  @relation("SeasonUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_season_updated_by")

  @@unique([estateId, code], map: "ux_season_code")
  @@index([estateId, startDate, endDate], map: "ix_season_dates")
  @@index([state], map: "ix_season_state")
  @@index([closedBy], map: "ix_season_closed_by")
  @@index([createdBy], map: "ix_season_created_by")
  @@index([updatedBy], map: "ix_season_updated_by")
  @@map("season")
}

/// The accounting calendar of the whole organisation (P3 §4.9, decision O-17): no estate_id, ever.
model FiscalYear {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organisationId BigInt    @map("organisation_id") @db.UnsignedBigInt
  /// For example FY2026-27.
  code           String    @db.VarChar(20)
  name           String    @db.VarChar(150)
  /// Derived from organisation.fiscal_year_start_month on creation.
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  /// future | open | closed
  state          String    @default("future") @db.VarChar(30)
  closedAt       DateTime? @map("closed_at") @db.DateTime(0)
  closedBy       BigInt?   @map("closed_by") @db.UnsignedBigInt
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy      BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt      DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy      BigInt?   @map("updated_by") @db.UnsignedBigInt

  organisation      Organisation       @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_year_organisation")
  closer            User?              @relation("FiscalYearClosedBy", fields: [closedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_year_closed_by")
  creator           User               @relation("FiscalYearCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_year_created_by")
  updater           User?              @relation("FiscalYearUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_fiscal_year_updated_by")
  periods           AccountingPeriod[]
  leaveEntitlements LeaveEntitlement[]

  @@unique([organisationId, code], map: "ux_fiscal_year_code")
  @@unique([organisationId, startDate], map: "ux_fiscal_year_start")
  @@index([startDate, endDate], map: "ix_fiscal_year_dates")
  @@index([state], map: "ix_fiscal_year_state")
  @@index([closedBy], map: "ix_fiscal_year_closed_by")
  @@index([createdBy], map: "ix_fiscal_year_created_by")
  @@index([updatedBy], map: "ix_fiscal_year_updated_by")
  @@map("fiscal_year")
}

/// One period of a fiscal year (P3 §4.10): 1–12 monthly, 13 reserved for year-end adjustments. Every
/// posting tests this row's state: the single point of period control (P1 §14).
model AccountingPeriod {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  fiscalYearId BigInt    @map("fiscal_year_id") @db.UnsignedBigInt
  periodNumber Int       @map("period_number") @db.SmallInt
  name         String    @db.VarChar(100)
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime  @map("end_date") @db.Date
  /// future | open | soft_closed | closed | reopened (P1 Table 14.1)
  state        String    @default("future") @db.VarChar(30)
  closedAt     DateTime? @map("closed_at") @db.DateTime(0)
  closedBy     BigInt?   @map("closed_by") @db.UnsignedBigInt
  reopenedAt   DateTime? @map("reopened_at") @db.DateTime(0)
  reopenedBy   BigInt?   @map("reopened_by") @db.UnsignedBigInt
  /// Required when reopened_at is set.
  reopenReason String?   @map("reopen_reason") @db.VarChar(500)
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy    BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt    DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy    BigInt?   @map("updated_by") @db.UnsignedBigInt

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_period_fiscal_year")
  closer     User?      @relation("AccountingPeriodClosedBy", fields: [closedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_period_closed_by")
  reopener   User?      @relation("AccountingPeriodReopenedBy", fields: [reopenedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_period_reopened_by")
  creator    User       @relation("AccountingPeriodCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_period_created_by")
  updater    User?      @relation("AccountingPeriodUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accounting_period_updated_by")

  @@unique([fiscalYearId, periodNumber], map: "ux_period")
  @@index([startDate, endDate], map: "ix_accounting_period_dates")
  @@index([state], map: "ix_accounting_period_state")
  @@index([closedBy], map: "ix_accounting_period_closed_by")
  @@index([reopenedBy], map: "ix_accounting_period_reopened_by")
  @@index([createdBy], map: "ix_accounting_period_created_by")
  @@index([updatedBy], map: "ix_accounting_period_updated_by")
  @@map("accounting_period")
}

// ---- P1.10 reference lookups and units (Spec P3 §5, §7.1) -----------------------------------------
/// Generated from the lookup definitions: 16 common-shape lookups (P3 §5.1) and the lookups with
/// additional columns (§5.2–§5.4, §7.1). is_system rows are seeded and may be renamed, never deleted or
/// deactivated. The API is served by one engine (src/modules/lookups).

model Department {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isSystem    Boolean   @default(false) @map("is_system")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy   BigInt?   @map("updated_by") @db.UnsignedBigInt

  workflows   Workflow[]
  assignments EmploymentAssignment[]

  creator User  @relation("DepartmentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_department_created_by")
  updater User? @relation("DepartmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_department_updated_by")

  @@unique([code], map: "ux_department_code")
  @@index([status], map: "ix_department_status")
  @@index([createdBy], map: "ix_department_created_by")
  @@index([updatedBy], map: "ix_department_updated_by")
  @@map("department")
}

model Designation {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isSystem    Boolean   @default(false) @map("is_system")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
