// =============================================================================================
// RupAI database schema — a typed MIRROR of spec Part 3. Part 3 is the authority, not this file.
//
// Read prisma/README.md before changing anything here. In short:
//   * Every model maps to its Part 3 table and column names with @@map / @map (snake_case singular).
//   * Surrogate keys:  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
//     ULID keys (the six field-capture tables, P3 §2.2):  id String @id @db.Char(26)
//   * Money Decimal @db.Decimal(18,4) · qty (14,3) · rate (18,8) · pct (9,4). Never Float.
//   * States and enums are String @db.VarChar(30), validated in TypeScript. Never a Prisma enum.
//   * Generated columns and CHECK constraints are added by hand in the migration SQL.
//   * Migrations are created with `npm run db:migrate:new -- --name <x>` (create-only), then the
//     SQL is reviewed and edited. `prisma db push` is never used.
// =============================================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// Models are added epic by epic.

// ---------------------------------------------------------------------------------------------
// P1.01 — Platform prerequisites: permission, role, role_permission, user, user_role (P3 §28.1,
// migration step 1 of P3 §32). Every audit column in the schema references user.
// ---------------------------------------------------------------------------------------------

/// P3 §28.1. System data: seeded from the catalogue in code, never written by the app account.
model Permission {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  module      String  @db.VarChar(40)
  action      String  @db.VarChar(20)
  description String? @db.VarChar(500)

  roles RolePermission[]

  @@unique([module, action], map: "ux_permission_module_action")
  @@map("permission")
}

/// P3 §28.1: the common lookup shape (P3 §5.1) + audit block. `version` per P4 §5.1.
model Role {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  /// The Administrator role is is_system: it may be renamed but not deleted or deactivated.
  isSystem    Boolean   @default(false) @map("is_system")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy   BigInt?   @map("updated_by") @db.UnsignedBigInt

  workflowSteps     WorkflowStep[]
  notificationRules NotificationRule[]
  creator           User               @relation("RoleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_created_by")
  updater           User?              @relation("RoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_updated_by")
  permissions       RolePermission[]
  users             UserRole[]

  @@unique([code], map: "ux_role_code")
  @@index([status], map: "ix_role_status")
  @@index([createdBy], map: "ix_role_created_by")
  @@index([updatedBy], map: "ix_role_updated_by")
  @@map("role")
}

/// P3 §28.1. Junction; rows go with their role (P2 §7.1, line-to-header).
model RolePermission {
  roleId       BigInt @map("role_id") @db.UnsignedBigInt
  permissionId BigInt @map("permission_id") @db.UnsignedBigInt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_role_permission_role")
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_permission_permission")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "ix_role_permission_permission")
  @@map("role_permission")
}

/// P3 §28.1 + audit block. `version` per P4 §5.1. person_id / employment_profile_id get their foreign
/// keys when person (P2.01) and employment_profile (P2.02) exist.
model User {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  personId            BigInt?   @map("person_id") @db.UnsignedBigInt
  employmentProfileId BigInt?   @map("employment_profile_id") @db.UnsignedBigInt
  username            String    @db.VarChar(50)
  email               String?   @db.VarChar(254)
  /// PHC string (argon2id). Never returned in any payload (P4 §14.1).
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  phone               String?   @db.VarChar(20)
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  lastLoginAt         DateTime? @map("last_login_at") @db.DateTime(0)
  failedAttempts      Int       @default(0) @map("failed_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.DateTime(0)
  twoFactorSecret     String?   @map("two_factor_secret") @db.VarChar(255)
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  /// active | disabled
  status              String    @default("active") @db.VarChar(30)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  /// The bootstrap administrator (P3 §32.2) is created by itself.
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  creator User?      @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_created_by")
  updater User?      @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_updated_by")
  roles   UserRole[]

  // Back-relations of the audit columns. Every audited table adds a pair here.
  createdUsers     User[]     @relation("UserCreatedBy")
  updatedUsers     User[]     @relation("UserUpdatedBy")
  createdRoles     Role[]     @relation("RoleCreatedBy")
  updatedRoles     Role[]     @relation("RoleUpdatedBy")
  grantedUserRoles UserRole[] @relation("UserRoleGrantedBy")

  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]

  auditChanges          AuditChange[]   @relation("AuditChangeBy")
  auditChangesActingFor AuditChange[]   @relation("AuditChangeActingFor")
  statusChanges         StatusHistory[]
  accessEvents          AccessLog[]

  authorisations        AccessAuthorisation[] @relation("AccessAuthorisationUser")
  authorisationsGiven   AccessAuthorisation[] @relation("AccessAuthorisationBy")
  authorisationsRemoved AccessAuthorisation[] @relation("AccessAuthorisationRemovedBy")

  createdOrganisations        Organisation[]        @relation("OrganisationCreatedBy")
  updatedOrganisations        Organisation[]        @relation("OrganisationUpdatedBy")
  createdEstates              Estate[]              @relation("EstateCreatedBy")
  updatedEstates              Estate[]              @relation("EstateUpdatedBy")
  createdDivisions            Division[]            @relation("DivisionCreatedBy")
  updatedDivisions            Division[]            @relation("DivisionUpdatedBy")
  createdSections             Section[]             @relation("SectionCreatedBy")
  updatedSections             Section[]             @relation("SectionUpdatedBy")
  createdFields               Field[]               @relation("FieldCreatedBy")
  updatedFields               Field[]               @relation("FieldUpdatedBy")
  createdFactories            Factory[]             @relation("FactoryCreatedBy")
  updatedFactories            Factory[]             @relation("FactoryUpdatedBy")
  createdWarehouses           Warehouse[]           @relation("WarehouseCreatedBy")
  updatedWarehouses           Warehouse[]           @relation("WarehouseUpdatedBy")
  createdParties              Party[]               @relation("PartyCreatedBy")
  updatedParties              Party[]               @relation("PartyUpdatedBy")
  createdContacts             PartyContact[]        @relation("PartyContactCreatedBy")
  updatedContacts             PartyContact[]        @relation("PartyContactUpdatedBy")
  createdSeasons              Season[]              @relation("SeasonCreatedBy")
  updatedSeasons              Season[]              @relation("SeasonUpdatedBy")
  closedSeasons               Season[]              @relation("SeasonClosedBy")
  createdFiscalYears          FiscalYear[]          @relation("FiscalYearCreatedBy")
  updatedFiscalYears          FiscalYear[]          @relation("FiscalYearUpdatedBy")
  closedFiscalYears           FiscalYear[]          @relation("FiscalYearClosedBy")
  createdPeriods              AccountingPeriod[]    @relation("AccountingPeriodCreatedBy")
  updatedPeriods              AccountingPeriod[]    @relation("AccountingPeriodUpdatedBy")
  closedPeriods               AccountingPeriod[]    @relation("AccountingPeriodClosedBy")
  reopenedPeriods             AccountingPeriod[]    @relation("AccountingPeriodReopenedBy")
  createdDepartments          Department[]          @relation("DepartmentCreatedBy")
  updatedDepartments          Department[]          @relation("DepartmentUpdatedBy")
  createdDesignations         Designation[]         @relation("DesignationCreatedBy")
  updatedDesignations         Designation[]         @relation("DesignationUpdatedBy")
  createdWorkerCategorys      WorkerCategory[]      @relation("WorkerCategoryCreatedBy")
  updatedWorkerCategorys      WorkerCategory[]      @relation("WorkerCategoryUpdatedBy")
  createdEmployeeCategorys    EmployeeCategory[]    @relation("EmployeeCategoryCreatedBy")
  updatedEmployeeCategorys    EmployeeCategory[]    @relation("EmployeeCategoryUpdatedBy")
  createdEmploymentTypes      EmploymentType[]      @relation("EmploymentTypeCreatedBy")
  updatedEmploymentTypes      EmploymentType[]      @relation("EmploymentTypeUpdatedBy")
  createdLeaveTypes           LeaveType[]           @relation("LeaveTypeCreatedBy")
  updatedLeaveTypes           LeaveType[]           @relation("LeaveTypeUpdatedBy")
  createdBuyerTypes           BuyerType[]           @relation("BuyerTypeCreatedBy")
  updatedBuyerTypes           BuyerType[]           @relation("BuyerTypeUpdatedBy")
  createdTradingTypes         TradingType[]         @relation("TradingTypeCreatedBy")
  updatedTradingTypes         TradingType[]         @relation("TradingTypeUpdatedBy")
  createdPackagingTypes       PackagingType[]       @relation("PackagingTypeCreatedBy")
  updatedPackagingTypes       PackagingType[]       @relation("PackagingTypeUpdatedBy")
  createdChargeTypes          ChargeType[]          @relation("ChargeTypeCreatedBy")
  updatedChargeTypes          ChargeType[]          @relation("ChargeTypeUpdatedBy")
  createdDocumentTypes        DocumentType[]        @relation("DocumentTypeCreatedBy")
  updatedDocumentTypes        DocumentType[]        @relation("DocumentTypeUpdatedBy")
  createdPaymentMethods       PaymentMethod[]       @relation("PaymentMethodCreatedBy")
  updatedPaymentMethods       PaymentMethod[]       @relation("PaymentMethodUpdatedBy")
  createdLandTypes            LandType[]            @relation("LandTypeCreatedBy")
  createdAmenities            Amenity[]             @relation("AmenityCreatedBy")
  createdImportBatches        ImportBatch[]         @relation("ImportBatchCreatedBy")
  createdPersons              Person[]              @relation("PersonCreatedBy")
  createdProfiles             EmploymentProfile[]   @relation("EmploymentProfileCreatedBy")
  updatedProfiles             EmploymentProfile[]   @relation("EmploymentProfileUpdatedBy")
  createdJobGrades            JobGrade[]            @relation("JobGradeCreatedBy")
  updatedJobGrades            JobGrade[]            @relation("JobGradeUpdatedBy")
  updatedPersons              Person[]              @relation("PersonUpdatedBy")
  createdPersonDependents     PersonDependent[]     @relation("PersonDependentCreatedBy")
  updatedPersonDependents     PersonDependent[]     @relation("PersonDependentUpdatedBy")
  createdReligions            Religion[]            @relation("ReligionCreatedBy")
  updatedReligions            Religion[]            @relation("ReligionUpdatedBy")
  createdEducationLevels      EducationLevel[]      @relation("EducationLevelCreatedBy")
  updatedEducationLevels      EducationLevel[]      @relation("EducationLevelUpdatedBy")
  createdSkills               Skill[]               @relation("SkillCreatedBy")
  updatedSkills               Skill[]               @relation("SkillUpdatedBy")
  createdLanguages            Language[]            @relation("LanguageCreatedBy")
  updatedLanguages            Language[]            @relation("LanguageUpdatedBy")
  updatedImportBatches        ImportBatch[]         @relation("ImportBatchUpdatedBy")
  createdIrrigationSources    IrrigationSource[]    @relation("IrrigationSourceCreatedBy")
  updatedIrrigationSources    IrrigationSource[]    @relation("IrrigationSourceUpdatedBy")
  createdSoilTypes            SoilType[]            @relation("SoilTypeCreatedBy")
  updatedSoilTypes            SoilType[]            @relation("SoilTypeUpdatedBy")
  createdDrainageClasses      DrainageClass[]       @relation("DrainageClassCreatedBy")
  updatedDrainageClasses      DrainageClass[]       @relation("DrainageClassUpdatedBy")
  updatedAmenities            Amenity[]             @relation("AmenityUpdatedBy")
  createdEstateAmenities      EstateAmenity[]       @relation("EstateAmenityCreatedBy")
  updatedLandTypes            LandType[]            @relation("LandTypeUpdatedBy")
  createdAdjustmentReasons    AdjustmentReason[]    @relation("AdjustmentReasonCreatedBy")
  updatedAdjustmentReasons    AdjustmentReason[]    @relation("AdjustmentReasonUpdatedBy")
  createdQualityGrades        QualityGrade[]        @relation("QualityGradeCreatedBy")
  updatedQualityGrades        QualityGrade[]        @relation("QualityGradeUpdatedBy")
  createdCollectionPointTypes CollectionPointType[] @relation("CollectionPointTypeCreatedBy")
  updatedCollectionPointTypes CollectionPointType[] @relation("CollectionPointTypeUpdatedBy")
  createdTeaTypes             TeaType[]             @relation("TeaTypeCreatedBy")
  updatedTeaTypes             TeaType[]             @relation("TeaTypeUpdatedBy")
  createdTeaGrades            TeaGrade[]            @relation("TeaGradeCreatedBy")
  updatedTeaGrades            TeaGrade[]            @relation("TeaGradeUpdatedBy")
  createdActivityTypes        ActivityType[]        @relation("ActivityTypeCreatedBy")
  updatedActivityTypes        ActivityType[]        @relation("ActivityTypeUpdatedBy")
  createdShifts               Shift[]               @relation("ShiftCreatedBy")
  updatedShifts               Shift[]               @relation("ShiftUpdatedBy")
  createdUomCategorys         UomCategory[]         @relation("UomCategoryCreatedBy")
  updatedUomCategorys         UomCategory[]         @relation("UomCategoryUpdatedBy")
  createdTeaVarietys          TeaVariety[]          @relation("TeaVarietyCreatedBy")
  updatedTeaVarietys          TeaVariety[]          @relation("TeaVarietyUpdatedBy")
  createdUoms                 Uom[]                 @relation("UomCreatedBy")
  updatedUoms                 Uom[]                 @relation("UomUpdatedBy")
  createdCurrencys            Currency[]            @relation("CurrencyCreatedBy")
  updatedCurrencys            Currency[]            @relation("CurrencyUpdatedBy")
  createdCountrys             Country[]             @relation("CountryCreatedBy")
  updatedCountrys             Country[]             @relation("CountryUpdatedBy")

  scopes               UserScope[]          @relation("UserScopeUser")
  grantedScopes        UserScope[]          @relation("UserScopeGrantedBy")
  createdScopes        UserScope[]          @relation("UserScopeCreatedBy")
  updatedScopes        UserScope[]          @relation("UserScopeUpdatedBy")
  createdNumberFormats NumberFormat[]       @relation("NumberFormatCreatedBy")
  updatedNumberFormats NumberFormat[]       @relation("NumberFormatUpdatedBy")
  createdSettings      SystemSetting[]      @relation("SystemSettingCreatedBy")
  updatedSettings      SystemSetting[]      @relation("SystemSettingUpdatedBy")
  createdDocuments     DocumentFile[]       @relation("DocumentFileCreatedBy")
  updatedDocuments     DocumentFile[]       @relation("DocumentFileUpdatedBy")
