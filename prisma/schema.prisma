  createdBy          BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt          DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy          BigInt?   @map("updated_by") @db.UnsignedBigInt

  fields  Field[]
  creator User    @relation("TeaVarietyCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tea_variety_created_by")
  updater User?   @relation("TeaVarietyUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_tea_variety_updated_by")

  @@unique([code], map: "ux_tea_variety_code")
  @@index([status], map: "ix_tea_variety_status")
  @@index([createdBy], map: "ix_tea_variety_created_by")
  @@index([updatedBy], map: "ix_tea_variety_updated_by")
  @@map("tea_variety")
}

model Uom {
