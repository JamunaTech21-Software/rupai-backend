// ---- P1.11 document numbering and system settings (Spec P3 §28.6, P2 §6.5) -----------------------

/// How one document type is numbered (P2 §6.5): one row per document type the system has. The set of
/// rows is the system's (seeded); the client edits the format. is_gapless follows the document's
/// lifecycle (financial: allocated at posting) and is not editable.
model NumberFormat {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  documentType      String    @map("document_type") @db.VarChar(40)
  prefix            String    @db.VarChar(20)
  includeFiscalYear Boolean   @default(false) @map("include_fiscal_year")
  includeSeason     Boolean   @default(false) @map("include_season")
  includeEstateCode Boolean   @default(false) @map("include_estate_code")
  separator         String    @default("-") @db.VarChar(5)
  sequenceWidth     Int       @default(5) @map("sequence_width") @db.SmallInt
  /// never | yearly | monthly
  resetFrequency    String    @default("never") @map("reset_frequency") @db.VarChar(30)
  isGapless         Boolean   @default(false) @map("is_gapless")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy         BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt         DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy         BigInt?   @map("updated_by") @db.UnsignedBigInt

  creator User  @relation("NumberFormatCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_number_format_created_by")
  updater User? @relation("NumberFormatUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_number_format_updated_by")

  @@unique([documentType], map: "ux_number_format_document_type")
  @@index([createdBy], map: "ix_number_format_created_by")
  @@index([updatedBy], map: "ix_number_format_updated_by")
  @@map("number_format")
}

/// The last number allocated per (document type, scope). The row is locked by the allocating
/// transaction, so numbers in a scope are unique and, for gapless documents, without holes.
model NumberSequence {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  documentType String   @map("document_type") @db.VarChar(40)
  /// Estate, fiscal year, season and reset period, as the format includes them. "*" when none.
  scopeKey     String   @map("scope_key") @db.VarChar(120)
  lastNumber   BigInt   @default(0) @map("last_number") @db.UnsignedBigInt
  updatedAt    DateTime @default(now()) @map("updated_at") @db.DateTime(0)

  @@unique([documentType, scopeKey], map: "ux_number_sequence")
  @@map("number_sequence")
}

/// Organisation-wide configuration values (P3 §28.6). An encrypted value is stored as ciphertext and is
/// write-only through the API.
model SystemSetting {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  settingKey   String    @map("setting_key") @db.VarChar(100)
  settingValue String?   @map("setting_value") @db.Text
  /// string | integer | decimal | boolean | json
  valueType    String    @map("value_type") @db.VarChar(30)
  settingGroup String    @map("setting_group") @db.VarChar(50)
  isEncrypted  Boolean   @default(false) @map("is_encrypted")
  description  String?   @db.VarChar(500)
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy    BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt    DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy    BigInt?   @map("updated_by") @db.UnsignedBigInt

  creator User  @relation("SystemSettingCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_system_setting_created_by")
  updater User? @relation("SystemSettingUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_system_setting_updated_by")

  @@unique([settingKey], map: "ux_system_setting_key")
  @@index([settingGroup], map: "ix_system_setting_group")
  @@index([createdBy], map: "ix_system_setting_created_by")
  @@index([updatedBy], map: "ix_system_setting_updated_by")
  @@map("system_setting")
}

/// A file attached to any business record (P3 §28.4, P2 §6.2). The owner is polymorphic and decides who
/// may see the file. Replacing a file adds a version and keeps the previous one; nothing is deleted.
model DocumentFile {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// estate | field | factory | warehouse | party, and later owners as their modules arrive
  ownerType      String    @map("owner_type") @db.VarChar(50)
  ownerId        BigInt    @map("owner_id") @db.UnsignedBigInt
  documentTypeId BigInt    @map("document_type_id") @db.UnsignedBigInt
  /// Which document of this type, for this owner: an owner may hold several licences or agreements.
  seriesNo       Int       @default(1) @map("series_no")
  /// What tells two documents of the same type apart ("Fire licence").
  title          String?   @db.VarChar(150)
  /// The original name as uploaded. Metadata only: never part of a path.
  fileName       String    @map("file_name") @db.VarChar(200)
  /// Relative storage key, resolved through the storage abstraction. Never an absolute path.
  storedPath     String    @map("stored_path") @db.VarChar(255)
  mimeType       String    @map("mime_type") @db.VarChar(100)
  fileSizeBytes  Int       @map("file_size_bytes") @db.UnsignedInt
  /// SHA-256, hex.
  checksum       String?   @db.VarChar(64)
  /// The document's version within its series: 1, 2, 3 …
  version        Int       @default(1)
  issueDate      DateTime? @map("issue_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  isCurrent      Boolean   @default(true) @map("is_current")
  uploadedBy     BigInt    @map("uploaded_by") @db.UnsignedBigInt
  /// active | superseded | archived
  status         String    @default("active") @db.VarChar(30)
  /// GENERATED column (see migration SQL): the series while this is its current version, else NULL. Its
  /// unique index makes "one current version per document" a database guarantee.
  currentKey     String?   @map("current_key") @db.VarChar(120)
  /// Optimistic-concurrency counter (If-Match). `version` above is the document's own version number.
  rowVersion     Int       @default(1) @map("row_version")
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy      BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt      DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy      BigInt?   @map("updated_by") @db.UnsignedBigInt

  documentType DocumentType @relation(fields: [documentTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_document_file_type")
  uploader     User         @relation("DocumentFileUploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_document_file_uploaded_by")
  creator      User         @relation("DocumentFileCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_document_file_created_by")
  updater      User?        @relation("DocumentFileUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_document_file_updated_by")

  @@unique([ownerType, ownerId, documentTypeId, seriesNo, version], map: "ux_document_version")
  @@unique([currentKey], map: "ux_document_current")
  @@index([expiryDate, isCurrent], map: "ix_document_expiry")
  @@index([documentTypeId], map: "ix_document_file_type")
  @@index([uploadedBy], map: "ix_document_file_uploaded_by")
  @@index([createdBy], map: "ix_document_file_created_by")
  @@index([updatedBy], map: "ix_document_file_updated_by")
  @@map("document_file")
}

/// An approval workflow (P7 §3, P3 §28.3): which steps a document of one type goes through. It is an
/// effective-dated policy record and carries the rule block of core/rules (rule-sql.ts): versions are
/// drafted, approved and superseded, never edited in place or deleted. `method` and `parameters` are the
/// block's and unused here.
model Workflow {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// The workflow's code. One code names one chain of versions.
  ruleCode          String    @map("rule_code") @db.VarChar(30)
  name              String    @db.VarChar(150)
  /// The approvable document type it governs (core/approval/document-types.ts).
  documentType      String    @map("document_type") @db.VarChar(50)
  /// NULL: every estate.
  scopeEstateId     BigInt?   @map("scope_estate_id") @db.UnsignedBigInt
  /// NULL: every department.
  scopeDepartmentId BigInt?   @map("scope_department_id") @db.UnsignedBigInt
  /// GENERATED (see migration SQL): estate 2 + department 1. The most specific workflow wins.
  specificity       Int?      @db.UnsignedSmallInt
  method            String    @db.VarChar(30)
  parameters        Json
  currencyId        BigInt?   @map("currency_id") @db.UnsignedBigInt
  roundingMode      String?   @map("rounding_mode") @db.VarChar(30)
  roundingPrecision Int?      @map("rounding_precision") @db.SmallInt
  effectiveFrom     DateTime  @map("effective_from") @db.Date
  effectiveTo       DateTime? @map("effective_to") @db.Date
  isRetrospective   Boolean   @default(false) @map("is_retrospective")
  supersedesId      BigInt?   @map("supersedes_id") @db.UnsignedBigInt
  notes             String?   @db.VarChar(500)
  /// When the workflow applies at all: a list of conditions, all of which must hold. NULL: always.
  conditionJson     Json?     @map("condition_json")
  /// draft | submitted | active | rejected | superseded
  state             String    @default("draft") @db.VarChar(30)
  stateChangedAt    DateTime? @map("state_changed_at") @db.DateTime(0)
  submittedAt       DateTime? @map("submitted_at") @db.DateTime(0)
  submittedBy       BigInt?   @map("submitted_by") @db.UnsignedBigInt
  approvedAt        DateTime? @map("approved_at") @db.DateTime(0)
  approvedBy        BigInt?   @map("approved_by") @db.UnsignedBigInt
  rejectedAt        DateTime? @map("rejected_at") @db.DateTime(0)
  rejectedBy        BigInt?   @map("rejected_by") @db.UnsignedBigInt
  rejectionReason   String?   @map("rejection_reason") @db.VarChar(500)
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy         BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt         DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy         BigInt?   @map("updated_by") @db.UnsignedBigInt
  /// GENERATED (see migration SQL): document type + scope + effective_from while ACTIVE, else NULL.
  activeKey         String?   @map("active_key") @db.VarChar(255)

  supersedes   Workflow?         @relation("WorkflowSupersedes", fields: [supersedesId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_supersedes")
  supersededBy Workflow[]        @relation("WorkflowSupersedes")
  estate       Estate?           @relation(fields: [scopeEstateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_estate")
  department   Department?       @relation(fields: [scopeDepartmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_department")
  creator      User              @relation("WorkflowCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_created_by")
  updater      User?             @relation("WorkflowUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_updated_by")
  submitter    User?             @relation("WorkflowSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_submitted_by")
  approver     User?             @relation("WorkflowApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_approved_by")
  rejecter     User?             @relation("WorkflowRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_rejected_by")
  steps        WorkflowStep[]
  requests     ApprovalRequest[]

  @@unique([activeKey], map: "ux_workflow_scope_from")
  @@index([documentType, specificity, effectiveFrom, effectiveTo, state], map: "ix_workflow_resolution")
  @@index([ruleCode, effectiveFrom], map: "ix_workflow_code")
  @@index([state], map: "ix_workflow_state")
  @@index([isRetrospective], map: "ix_workflow_retrospective")
  @@index([supersedesId], map: "ix_workflow_supersedes")
  @@index([scopeEstateId], map: "ix_workflow_estate")
  @@index([scopeDepartmentId], map: "ix_workflow_department")
  @@index([createdBy], map: "ix_workflow_created_by")
  @@index([updatedBy], map: "ix_workflow_updated_by")
  @@index([submittedBy], map: "ix_workflow_submitted_by")
  @@index([approvedBy], map: "ix_workflow_approved_by")
  @@index([rejectedBy], map: "ix_workflow_rejected_by")
  @@map("workflow")
}

/// One step of a workflow (P7 §3.1, P3 §28.3). It stores a RULE for finding the approver, never a
/// resolved user: approvers are resolved when the step becomes current (P7 §4.2). Steps change only
/// while their workflow is a draft; an active workflow's steps are fixed.
model WorkflowStep {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  workflowId        BigInt    @map("workflow_id") @db.UnsignedBigInt
  stepNumber        Int       @map("step_number")
  /// What the step is for, shown on the approval timeline ("Accounts verification").
  name              String?   @db.VarChar(100)
  /// by_role | by_reporting_line | by_named_user | by_cost_centre_manager
  approverRule      String    @map("approver_rule") @db.VarChar(30)
  roleId            BigInt?   @map("role_id") @db.UnsignedBigInt
  userId            BigInt?   @map("user_id") @db.UnsignedBigInt
  /// by_reporting_line: 1 is the submitter's supervisor.
  reportingLevel    Int?      @map("reporting_level") @db.UnsignedTinyInt
  /// When the step applies. All three NULL: always.
  conditionField    String?   @map("condition_field") @db.VarChar(50)
  conditionOperator String?   @map("condition_operator") @db.VarChar(20)
  conditionValue    Json?     @map("condition_value")
  allowSelfApproval Boolean   @default(false) @map("allow_self_approval")
  /// Display order. Always equal to step_number.
  sequence          Int
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy         BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt         DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy         BigInt?   @map("updated_by") @db.UnsignedBigInt

  workflow  Workflow          @relation(fields: [workflowId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_step_workflow")
  role      Role?             @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_step_role")
  user      User?             @relation("WorkflowStepUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_step_user")
  creator   User              @relation("WorkflowStepCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_step_created_by")
  updater   User?             @relation("WorkflowStepUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_workflow_step_updated_by")
  currentOf ApprovalRequest[]
  actions   ApprovalAction[]

  @@unique([workflowId, stepNumber], map: "ux_workflow_step_number")
  @@index([roleId], map: "ix_workflow_step_role")
  @@index([userId], map: "ix_workflow_step_user")
  @@index([createdBy], map: "ix_workflow_step_created_by")
  @@index([updatedBy], map: "ix_workflow_step_updated_by")
  @@map("workflow_step")
}

/// One document's run through its workflow (P7 §3.3, P3 §28.3). The path is FROZEN at submission: a
/// later change to the workflow never changes it. A returned document starts a new request when it is
/// resubmitted; the old one stays, as history.
model ApprovalRequest {
  id                BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// The approvable document type (core/approval/document-types.ts).
  documentType      String    @map("document_type") @db.VarChar(50)
  documentId        BigInt    @map("document_id") @db.UnsignedBigInt
  /// The workflow version that governed it, chosen once at submission.
  workflowId        BigInt    @map("workflow_id") @db.UnsignedBigInt
  /// The frozen path: [{ step_id, step_number }], in order.
  path              Json
  /// The step awaiting a decision; NULL once the request is complete.
  currentStepNumber Int?      @map("current_step_number")
  currentStepId     BigInt?   @map("current_step_id") @db.UnsignedBigInt
  /// When the current step became current: the age shown in the queue.
  stepStartedAt     DateTime? @map("step_started_at") @db.DateTime(0)
  /// pending | approved | rejected | returned
  state             String    @default("pending") @db.VarChar(30)
  /// The current step resolves to nobody (P7 §4.3): on the exception list until it does.
  isUnresolved      Boolean   @default(false) @map("is_unresolved")
  /// The document marked itself exceptional at submission: never bulk-approved (P7 §13.2).
  isExceptional     Boolean   @default(false) @map("is_exceptional")
  /// The last refusal of the document's own guards at final approval (P7 §2.2), for the user to see.
  guardFailure      Json?     @map("guard_failure")
  submittedAt       DateTime  @map("submitted_at") @db.DateTime(0)
  submittedBy       BigInt    @map("submitted_by") @db.UnsignedBigInt
  /// Who created the document: neither its creator nor its submitter may approve it (P7 §12.2).
  documentCreatedBy BigInt    @map("document_created_by") @db.UnsignedBigInt
  completedAt       DateTime? @map("completed_at") @db.DateTime(0)
  /// approved | rejected | returned
  finalOutcome      String?   @map("final_outcome") @db.VarChar(30)
  /// Where the document sits, for approver scope (P7 §4.4) and queue filters.
  estateId          BigInt?   @map("estate_id") @db.UnsignedBigInt
  factoryId         BigInt?   @map("factory_id") @db.UnsignedBigInt
  warehouseId       BigInt?   @map("warehouse_id") @db.UnsignedBigInt
  departmentId      BigInt?   @map("department_id") @db.UnsignedBigInt
  /// What the queue shows (P7 §13.1): number, a label, the amount or quantity. Copied at submission.
  documentNumber    String?   @map("document_number") @db.VarChar(50)
  documentLabel     String    @map("document_label") @db.VarChar(200)
  summaryAmount     Decimal?  @map("summary_amount") @db.Decimal(18, 2)
  summaryQuantity   Decimal?  @map("summary_quantity") @db.Decimal(18, 3)
  /// GENERATED (see migration SQL): the document while this request is pending, else NULL. At most one
  /// pending request per document (P3 §28.3: "UNIQUE … where state is active").
  activeKey         String?   @map("active_key") @db.VarChar(80)
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt         DateTime? @map("updated_at") @db.DateTime(0)

  workflow        Workflow         @relation(fields: [workflowId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_request_workflow")
  currentStep     WorkflowStep?    @relation(fields: [currentStepId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_request_step")
  submitter       User             @relation("ApprovalRequestSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_request_submitted_by")
  documentCreator User             @relation("ApprovalRequestDocumentCreatedBy", fields: [documentCreatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_request_document_created_by")
  actions         ApprovalAction[]

  @@unique([activeKey], map: "ux_approval_request_active")
  @@index([documentType, documentId], map: "ix_approval_request_document")
  @@index([state, currentStepId], map: "ix_approval_request_queue")
  @@index([state, isUnresolved], map: "ix_approval_request_unresolved")
  @@index([workflowId], map: "ix_approval_request_workflow")
  @@index([currentStepId], map: "ix_approval_request_step")
  @@index([submittedBy], map: "ix_approval_request_submitted_by")
  @@index([documentCreatedBy], map: "ix_approval_request_document_created_by")
  @@index([estateId], map: "ix_approval_request_estate")
  @@map("approval_request")
}

/// Every decision and remark on a request (P7 §14): append-only, never updated, never deleted, kept for
/// rejected documents too.
model ApprovalAction {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  approvalRequestId BigInt   @map("approval_request_id") @db.UnsignedBigInt
  workflowStepId    BigInt?  @map("workflow_step_id") @db.UnsignedBigInt
  stepNumber        Int?     @map("step_number")
  /// Who acted.
  userId            BigInt   @map("user_id") @db.UnsignedBigInt
  /// Whom they acted for, under a delegation (P7 §11.1): "approved by X acting for Y".
  actingForUserId   BigInt?  @map("acting_for_user_id") @db.UnsignedBigInt
  /// approve | reject | return | comment
  action            String   @db.VarChar(30)
  comment           String?  @db.VarChar(1000)
  actedAt           DateTime @default(now()) @map("acted_at") @db.DateTime(0)
  ipAddress         String?  @map("ip_address") @db.VarChar(45)
  /// The actor created or submitted the document, on a step that allows it (P7 §12.2): flagged.
  isSelfApproval    Boolean  @default(false) @map("is_self_approval")
  /// Shared by the actions of one bulk approval (P7 §13.2).
  bulkReference     String?  @map("bulk_reference") @db.VarChar(30)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(0)

  request   ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_action_request")
  step      WorkflowStep?   @relation(fields: [workflowStepId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_action_step")
  user      User            @relation("ApprovalActionUser", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_action_user")
  actingFor User?           @relation("ApprovalActionActingFor", fields: [actingForUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_action_acting_for")

  @@index([approvalRequestId, id], map: "ix_approval_action_request")
  @@index([workflowStepId], map: "ix_approval_action_step")
  @@index([userId, actedAt], map: "ix_approval_action_user")
  @@index([actingForUserId], map: "ix_approval_action_acting_for")
  @@index([bulkReference], map: "ix_approval_action_bulk")
  @@map("approval_action")
}

/// A time-bounded handover of approval authority (P7 §11.1). It transfers approval only, never a
/// permission: the delegate must already hold the permission being exercised. One hop: a delegate never
/// acts on authority that was itself delegated.
model ApprovalDelegation {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  fromUserId   BigInt    @map("from_user_id") @db.UnsignedBigInt
  toUserId     BigInt    @map("to_user_id") @db.UnsignedBigInt
  /// NULL: every document type.
  documentType String?   @map("document_type") @db.VarChar(50)
  validFrom    DateTime  @map("valid_from") @db.DateTime(0)
  /// Expires by itself; ending it early moves this forward.
  validTo      DateTime  @map("valid_to") @db.DateTime(0)
  reason       String    @db.VarChar(500)
  /// Ended before valid_to by an administrator. An ended delegation never applies again.
  endedAt      DateTime? @map("ended_at") @db.DateTime(0)
  version      Int       @default(1)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy    BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt    DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy    BigInt?   @map("updated_by") @db.UnsignedBigInt

  fromUser User  @relation("ApprovalDelegationFrom", fields: [fromUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_delegation_from")
  toUser   User  @relation("ApprovalDelegationTo", fields: [toUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_delegation_to")
  creator  User  @relation("ApprovalDelegationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_delegation_created_by")
  updater  User? @relation("ApprovalDelegationUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_approval_delegation_updated_by")

  @@index([toUserId, validFrom, validTo], map: "ix_approval_delegation_to")
  @@index([fromUserId, validFrom, validTo], map: "ix_approval_delegation_from")
  @@index([createdBy], map: "ix_approval_delegation_created_by")
  @@index([updatedBy], map: "ix_approval_delegation_updated_by")
  @@map("approval_delegation")
}

// ---- P1.15 Background jobs and scheduler (P4 §5.3, P1 §2.7, §7.7, P14 §2.1, §6) ---------------------

/// Deferred or scheduled work: the job resource a client polls (P4 §5.3). The database row is the truth;
/// the queue only carries its id, so a lost queue entry is found again and a redelivered one is a no-op.
model Job {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// The handler, e.g. payroll.calculate (core/jobs/registry.ts).
  type          String    @db.VarChar(60)
  /// queued | running | completed | failed | partial
  state         String    @default("queued") @db.VarChar(20)
  /// (document, purpose): at most one queued or running job per key (P1 §2.7). NULL: no such limit.
  dedupeKey     String?   @map("dedupe_key") @db.VarChar(160)
  /// GENERATED (see migration SQL): dedupe_key while queued or running, else NULL. Unique.
  activeKey     String?   @map("active_key") @db.VarChar(160)
  payload       Json
  progressDone  Int       @default(0) @map("progress_done")
  progressTotal Int?      @map("progress_total")
  /// Where an interrupted run resumes (P1 §7.7: resume rather than restart).
  checkpoint    Json?
  /// Runs started so far, the current one included.
  attempts      Int       @default(0)
  maxAttempts   Int       @map("max_attempts")
  /// Not to be started before: the backoff after a failed attempt.
  availableAt   DateTime  @default(now()) @map("available_at") @db.DateTime(0)
  /// The run that holds the job, and until when. A run that stops renewing its lease is presumed dead.
  runToken      String?   @map("run_token") @db.Char(26)
  leaseUntil    DateTime? @map("lease_until") @db.DateTime(0)
  /// completed / partial: a summary or a link. failed: NULL.
  result        Json?
  /// The last error: of the final attempt when failed, of the previous attempt while retrying.
  errorCode     String?   @map("error_code") @db.VarChar(60)
  errorMessage  String?   @map("error_message") @db.VarChar(1000)
  /// NULL for scheduled work.
  requestedBy   BigInt?   @map("requested_by") @db.UnsignedBigInt
  scheduleName  String?   @map("schedule_name") @db.VarChar(60)
  queuedAt      DateTime  @default(now()) @map("queued_at") @db.DateTime(0)
  startedAt     DateTime? @map("started_at") @db.DateTime(0)
  finishedAt    DateTime? @map("finished_at") @db.DateTime(0)
  /// When the finished job is purged (results kept seven days by default, P4 §5.3).
  expiresAt     DateTime? @map("expires_at") @db.DateTime(0)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt     DateTime? @map("updated_at") @db.DateTime(0)

  importValidations ImportBatch[] @relation("ImportValidateJob")
  importCommits     ImportBatch[] @relation("ImportCommitJob")
  requester         User?         @relation("JobRequestedBy", fields: [requestedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_requested_by")

  @@unique([activeKey], map: "ux_job_active")
  @@index([state, availableAt], map: "ix_job_due")
  @@index([state, leaseUntil], map: "ix_job_lease")
  @@index([requestedBy, id], map: "ix_job_requested_by")
  @@index([type, state], map: "ix_job_type")
  @@index([expiresAt], map: "ix_job_expires")
  @@map("job")
}

/// The idempotency guard of a job's effects (P1 §7.7): written in the same transaction as the effect,
/// so a repeated attempt finds its key and does nothing. Insert only, never purged: it must outlive the job.
model JobProcessingKey {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// (document, purpose[, part]), e.g. payroll_run:4471:calculate:person:812.
  key       String   @db.VarChar(190)
  /// The job that wrote it. Not a foreign key: finished jobs are purged, their keys are not.
  jobId     BigInt?  @map("job_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(0)

  @@unique([key], map: "ux_job_processing_key")
  @@index([jobId], map: "ix_job_processing_key_job")
  @@map("job_processing_key")
}

/// A recurring job and when it next runs. The schedules themselves are code (the scheduler syncs one
/// row per definition); this row holds their state: paused or not, last and next run.
model JobSchedule {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name      String    @db.VarChar(60)
  jobType   String    @map("job_type") @db.VarChar(60)
  /// Five-field cron, in the organisation's timezone.
  cron      String    @db.VarChar(60)
  isPaused  Boolean   @default(false) @map("is_paused")
  nextRunAt DateTime? @map("next_run_at") @db.DateTime(0)
  lastRunAt DateTime? @map("last_run_at") @db.DateTime(0)
  lastJobId BigInt?   @map("last_job_id") @db.UnsignedBigInt
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy BigInt?   @map("updated_by") @db.UnsignedBigInt

  updater User? @relation("JobScheduleUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_schedule_updated_by")

  @@unique([name], map: "ux_job_schedule_name")
  @@index([updatedBy], map: "ix_job_schedule_updated_by")
  @@map("job_schedule")
}

/// A worker or scheduler process saying it is alive, for /system/health (P4 §14.1, P14 §10).
model ProcessHeartbeat {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// scheduler | worker:<host>:<pid>
  processKey String    @map("process_key") @db.VarChar(120)
  /// scheduler | worker
  kind       String    @db.VarChar(20)
  host       String    @db.VarChar(100)
  pid        Int
  appVersion String    @map("app_version") @db.VarChar(50)
  startedAt  DateTime  @map("started_at") @db.DateTime(0)
  beatAt     DateTime  @map("beat_at") @db.DateTime(0)
  /// Set on a clean shutdown.
  stoppedAt  DateTime? @map("stopped_at") @db.DateTime(0)

  @@unique([processKey], map: "ux_process_heartbeat_key")
  @@map("process_heartbeat")
}

// ---- R.2 Estate profile extension (the manager's design, 2026-10-14) ----------------------------

/// A facility an estate may have (staff quarter, hospital, school …): a reference list in the common
/// lookup shape (P3 §5.1). Factories are not on it: they come from the factory register.
model Amenity {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isSystem    Boolean   @default(false) @map("is_system")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy   BigInt?   @map("updated_by") @db.UnsignedBigInt

  estateLinks EstateAmenity[]
  creator     User            @relation("AmenityCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_amenity_created_by")
  updater     User?           @relation("AmenityUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_amenity_updated_by")

  @@unique([code], map: "ux_amenity_code")
  @@index([status], map: "ix_amenity_status")
  @@index([createdBy], map: "ix_amenity_created_by")
  @@index([updatedBy], map: "ix_amenity_updated_by")
  @@map("amenity")
}

/// Which amenities an estate has. The set is replaced as a whole when the estate is saved.
/// R.3: a Field / Block dropdown of the manager's design. Common lookup shape (P3 §5.1), client-editable.
model IrrigationSource {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isSystem    Boolean   @default(false) @map("is_system")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy   BigInt?   @map("updated_by") @db.UnsignedBigInt

  fields  Field[]
  creator User    @relation("IrrigationSourceCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_irrigation_source_created_by")
  updater User?   @relation("IrrigationSourceUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_irrigation_source_updated_by")

  @@unique([code], map: "ux_irrigation_source_code")
  @@index([status], map: "ix_irrigation_source_status")
  @@index([createdBy], map: "ix_irrigation_source_created_by")
  @@index([updatedBy], map: "ix_irrigation_source_updated_by")
  @@map("irrigation_source")
}

/// R.3: a Field / Block dropdown of the manager's design. Common lookup shape (P3 §5.1), client-editable.
model SoilType {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isSystem    Boolean   @default(false) @map("is_system")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy   BigInt?   @map("updated_by") @db.UnsignedBigInt

  fields  Field[]
  creator User    @relation("SoilTypeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_soil_type_created_by")
  updater User?   @relation("SoilTypeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_soil_type_updated_by")

