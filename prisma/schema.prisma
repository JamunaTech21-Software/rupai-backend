// ---- P2.02 employment profiles (Spec P3 §8.2, P1 §5.5; the manager's design, BACKLOG D-2-2) --------

/// Employment of a person at an estate for a period (P1 §5.5): the subject of attendance, work and pay.
/// A person may hold several over time (worker, then staff); one ACTIVE per type at once.
model EmploymentProfile {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  personId            BigInt    @map("person_id") @db.UnsignedBigInt
  estateId            BigInt    @map("estate_id") @db.UnsignedBigInt
  /// worker | employee. Determines the wage model, not the lifecycle.
  employmentType      String    @map("employment_type") @db.VarChar(30)
  /// The Worker ID / Employee ID. Unique within the estate; numbered by the worker / employee format.
  profileNumber       String    @map("profile_number") @db.VarChar(40)
  /// One of the two by employment_type (P3 §8.2 category_id, split for a real foreign key each).
  workerCategoryId    BigInt?   @map("worker_category_id") @db.UnsignedBigInt
  employeeCategoryId  BigInt?   @map("employee_category_id") @db.UnsignedBigInt
  /// permanent | temporary | seasonal | casual | probation | contractual (the design's Worker Type)
  engagementType      String    @map("engagement_type") @db.VarChar(30)
  /// full_time | part_time
  employmentBasis     String?   @map("employment_basis") @db.VarChar(30)
  /// field | factory | office | technical | supervisory | administrative | operational
  jobNature           String?   @map("job_nature") @db.VarChar(30)
  /// field | factory | office | warehouse | nursery | head_office
  workingLocation     String?   @map("working_location") @db.VarChar(30)
  jobGradeId          BigInt?   @map("job_grade_id") @db.UnsignedBigInt
  workEmail           String?   @map("work_email") @db.VarChar(150)
  joiningDate         DateTime  @map("joining_date") @db.Date
  confirmationDate    DateTime? @map("confirmation_date") @db.Date
  probationEndDate    DateTime? @map("probation_end_date") @db.Date
  separationDate      DateTime? @map("separation_date") @db.Date
  /// resignation | retirement | termination | death | end_of_contract
  separationType      String?   @map("separation_type") @db.VarChar(30)
  separationReason    String?   @map("separation_reason") @db.VarChar(500)
  /// The reporting line (the approval engine's reporting-line resolution).
  supervisorProfileId BigInt?   @map("supervisor_profile_id") @db.UnsignedBigInt
  /// Service under this profile adds to the person's earlier profiles (gratuity, O-11).
  isServiceContinuous Boolean   @default(true) @map("is_service_continuous")
  // ---- nominee (the design's employee form; PF reads it in Phase 9) ----
  nomineeName         String?   @map("nominee_name") @db.VarChar(150)
  /// father | mother | spouse | son | daughter | brother | sister | other
  nomineeRelation     String?   @map("nominee_relation") @db.VarChar(30)
  nomineeDateOfBirth  DateTime? @map("nominee_date_of_birth") @db.Date
  nomineeNationalId   String?   @map("nominee_national_id") @db.VarChar(30)
  nomineePhone        String?   @map("nominee_phone") @db.VarChar(30)
  nomineeAddress      String?   @map("nominee_address") @db.VarChar(300)
  remarks             String?   @db.VarChar(500)
  /// active | suspended | on_leave | separated
  status              String    @default("active") @db.VarChar(30)
  /// GENERATED (migration SQL): person_id + employment_type while active, else NULL. Unique.
  activeKey           String?   @map("active_key") @db.VarChar(60)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  person              Person                 @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_profile_person")
  estate              Estate                 @relation("ProfileEstate", fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_profile_estate")
  workerCategory      WorkerCategory?        @relation(fields: [workerCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_profile_worker_category")
  employeeCategory    EmployeeCategory?      @relation(fields: [employeeCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_profile_employee_category")
  jobGrade            JobGrade?              @relation(fields: [jobGradeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_profile_job_grade")
  supervisor          EmploymentProfile?     @relation("ProfileSupervisor", fields: [supervisorProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_profile_supervisor")
  reports             EmploymentProfile[]    @relation("ProfileSupervisor")
  assignments         EmploymentAssignment[]
  teamMemberships     TeamMember[]
  supervisedTeams     WorkerTeam[]           @relation("TeamSupervisor")
  leaveEntitlements   LeaveEntitlement[]
  leaveRequests       LeaveRequest[]         @relation("LeaveRequestProfile")
  coveringLeave       LeaveRequest[]         @relation("LeaveRequestCovering")
  benefitEntitlements BenefitEntitlement[]
  issuedBenefits      BenefitIssue[]         @relation("BenefitIssueIssuedBy")
  trainings           TrainingParticipant[]
  evaluations         Evaluation[]           @relation("EvaluationProfile")
  reviewedEvaluations Evaluation[]           @relation("EvaluationReviewer")
  users               User[]                 @relation("UserProfile")
  managedEstates      Estate[]               @relation("EstateManager")
  managedDivisions    Division[]             @relation("DivisionManager")
  supervisedSections  Section[]              @relation("SectionSupervisor")
  managedFactories    Factory[]              @relation("FactoryManager")
  creator             User                   @relation("EmploymentProfileCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_profile_created_by")
  updater             User?                  @relation("EmploymentProfileUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_profile_updated_by")

  @@unique([estateId, profileNumber], map: "ux_profile_number")
  @@unique([activeKey], map: "ux_profile_active")
  @@index([personId], map: "ix_profile_person")
  @@index([employmentType], map: "ix_profile_type")
  @@index([joiningDate], map: "ix_profile_joining")
  @@index([separationDate], map: "ix_profile_separation")
  @@index([status], map: "ix_profile_status")
  @@index([workerCategoryId], map: "ix_profile_worker_category")
  @@index([employeeCategoryId], map: "ix_profile_employee_category")
  @@index([jobGradeId], map: "ix_profile_job_grade")
  @@index([supervisorProfileId], map: "ix_profile_supervisor")
  @@index([createdBy], map: "ix_profile_created_by")
  @@index([updatedBy], map: "ix_profile_updated_by")
  @@map("employment_profile")
}

/// P2.02 (the manager's design, employee form): Job Grade. Common lookup shape, client-editable.
model JobGrade {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isSystem    Boolean   @default(false) @map("is_system")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy   BigInt?   @map("updated_by") @db.UnsignedBigInt

  profiles EmploymentProfile[]
  creator  User                @relation("JobGradeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_grade_created_by")
  updater  User?               @relation("JobGradeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_job_grade_updated_by")

  @@unique([code], map: "ux_job_grade_code")
  @@index([status], map: "ix_job_grade_status")
  @@index([createdBy], map: "ix_job_grade_created_by")
  @@index([updatedBy], map: "ix_job_grade_updated_by")
  @@map("job_grade")
}

/// P2.03 (Spec P3 §8.3, P7 §9.6; the manager's design, BACKLOG D-2-3): where and on what terms a profile
/// works, effective-dated. A transfer, promotion or wage revision is a NEW row, never an update: the
/// approved row it follows is closed the day before it starts. Payroll and cost attribution resolve the
/// row in force on the transaction date. A draft is edited; a submitted or approved row never is.
model EmploymentAssignment {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employmentProfileId BigInt    @map("employment_profile_id") @db.UnsignedBigInt
  /// The profile's estate, copied: the scope and the approval place read it.
  estateId            BigInt    @map("estate_id") @db.UnsignedBigInt
  /// Required for an employee (the design's employee form); a worker's form has none.
  departmentId        BigInt?   @map("department_id") @db.UnsignedBigInt
  designationId       BigInt?   @map("designation_id") @db.UnsignedBigInt
  divisionId          BigInt?   @map("division_id") @db.UnsignedBigInt
  sectionId           BigInt?   @map("section_id") @db.UnsignedBigInt
  /// The design's Job / Task (plucking, pruning, …): required for a worker.
  activityTypeId      BigInt?   @map("activity_type_id") @db.UnsignedBigInt
  /// Where labour cost is charged. No foreign key until cost centres exist (P3.02).
  costCentreId        BigInt?   @map("cost_centre_id") @db.UnsignedBigInt
  defaultShiftId      BigInt?   @map("default_shift_id") @db.UnsignedBigInt
  /// daily | monthly | hourly | piece_rate | quantity | fixed: selects the calculation method
  wageBasis           String    @map("wage_basis") @db.VarChar(30)
  /// Overrides the category's wage rule; NULL resolves from wage_rule (exceptional, P3 §8.3).
  baseRate            Decimal?  @map("base_rate") @db.Decimal(18, 4)
  effectiveFrom       DateTime  @map("effective_from") @db.Date
  /// Set when the next assignment is approved: the day before it starts. NULL: open-ended.
  effectiveTo         DateTime? @map("effective_to") @db.Date
  /// joining | transfer | promotion | demotion | wage_revision | other (P3 §8.3; separation ends the profile instead)
  changeReason        String    @map("change_reason") @db.VarChar(30)
  remarks             String?   @db.VarChar(500)
  /// Its pay differs from the assignment it follows: approval is required (P7 §9.6). Set on submission.
  isWageChange        Boolean   @default(false) @map("is_wage_change")
  /// Starts before the day it was submitted (P1 §10.7): arrears may follow.
  isRetrospective     Boolean   @default(false) @map("is_retrospective")
  // ---- state block (P3 §3.2): draft | submitted | approved | rejected ----
  state               String    @default("draft") @db.VarChar(30)
  stateChangedAt      DateTime? @map("state_changed_at") @db.DateTime(0)
  // ---- approval block (P3 §3.3) ----
  submittedAt         DateTime? @map("submitted_at") @db.DateTime(0)
  submittedBy         BigInt?   @map("submitted_by") @db.UnsignedBigInt
  approvedAt          DateTime? @map("approved_at") @db.DateTime(0)
  approvedBy          BigInt?   @map("approved_by") @db.UnsignedBigInt
  rejectedAt          DateTime? @map("rejected_at") @db.DateTime(0)
  rejectedBy          BigInt?   @map("rejected_by") @db.UnsignedBigInt
  rejectionReason     String?   @map("rejection_reason") @db.VarChar(500)
  /// GENERATED (migration SQL): profile + effective_from unless rejected. Unique (ux_assignment_effective).
  effectiveKey        String?   @map("effective_key") @db.VarChar(40)
  /// GENERATED (migration SQL): the profile while draft or submitted. Unique: one pending change at a time.
  openKey             BigInt?   @map("open_key") @db.UnsignedBigInt
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  profile      EmploymentProfile   @relation(fields: [employmentProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_profile")
  estate       Estate              @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_estate")
  department   Department?         @relation(fields: [departmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_department")
  designation  Designation?        @relation(fields: [designationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_designation")
  division     Division?           @relation(fields: [divisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_division")
  section      Section?            @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_section")
  activityType ActivityType?       @relation(fields: [activityTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_activity_type")
  defaultShift Shift?              @relation(fields: [defaultShiftId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_shift")
  payLines     AssignmentPayLine[]
  creator      User                @relation("AssignmentCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_created_by")
  updater      User?               @relation("AssignmentUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_updated_by")
  submitter    User?               @relation("AssignmentSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_submitted_by")
  approver     User?               @relation("AssignmentApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_approved_by")
  rejecter     User?               @relation("AssignmentRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_assignment_rejected_by")

  @@unique([effectiveKey], map: "ux_assignment_effective")
  @@unique([openKey], map: "ux_assignment_open")
  @@index([employmentProfileId, effectiveFrom], map: "ix_assignment_profile_from")
  @@index([estateId], map: "ix_assignment_estate")
  @@index([departmentId], map: "ix_assignment_department")
  @@index([designationId], map: "ix_assignment_designation")
  @@index([divisionId], map: "ix_assignment_division")
  @@index([sectionId], map: "ix_assignment_section")
  @@index([activityTypeId], map: "ix_assignment_activity_type")
  @@index([defaultShiftId], map: "ix_assignment_shift")
  @@index([effectiveFrom], map: "ix_assignment_from")
  @@index([effectiveTo], map: "ix_assignment_to")
  @@index([state], map: "ix_assignment_state")
  @@index([createdBy], map: "ix_assignment_created_by")
  @@index([updatedBy], map: "ix_assignment_updated_by")
  @@index([submittedBy], map: "ix_assignment_submitted_by")
  @@index([approvedBy], map: "ix_assignment_approved_by")
  @@index([rejectedBy], map: "ix_assignment_rejected_by")
  @@map("employment_assignment")
}

/// P2.03 (the design's employee form, Salary & Payroll, D-2-3): the salary structure of an assignment.
/// Part of the assignment: replaced with it while a draft, fixed once submitted. Payroll (Phase 9) maps
/// each component to a pay component.
model AssignmentPayLine {
  id           BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  assignmentId BigInt  @map("assignment_id") @db.UnsignedBigInt
  /// basic | house_rent | medical | conveyance | other
  component    String  @db.VarChar(30)
  amount       Decimal @db.Decimal(18, 4)

  assignment EmploymentAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_pay_line_assignment")

  @@unique([assignmentId, component], map: "ux_pay_line_component")
  @@map("assignment_pay_line")
}

/// P2.04 (Spec P3 §8.4): a team of workers at an estate (a plucking gang under its sardar, a field or
/// factory team). Membership is effective-dated (team_member), so a distribution dated in March resolves
/// March's members.
model WorkerTeam {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  estateId            BigInt    @map("estate_id") @db.UnsignedBigInt
  code                String    @db.VarChar(20)
  name                String    @db.VarChar(150)
  /// plucking | field | factory | general
  teamType            String    @map("team_type") @db.VarChar(30)
  /// The sardar or supervisor accountable for the team: a profile of the same estate.
  supervisorProfileId BigInt?   @map("supervisor_profile_id") @db.UnsignedBigInt
  divisionId          BigInt?   @map("division_id") @db.UnsignedBigInt
  sectionId           BigInt?   @map("section_id") @db.UnsignedBigInt
  description         String?   @db.VarChar(500)
  /// active | inactive
  status              String    @default("active") @db.VarChar(30)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  estate     Estate             @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_team_estate")
  supervisor EmploymentProfile? @relation("TeamSupervisor", fields: [supervisorProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_team_supervisor")
  division   Division?          @relation(fields: [divisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_team_division")
  section    Section?           @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_team_section")
  members    TeamMember[]
  creator    User               @relation("WorkerTeamCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_team_created_by")
  updater    User?              @relation("WorkerTeamUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_team_updated_by")

  @@unique([estateId, code], map: "ux_team_code")
  @@index([supervisorProfileId], map: "ix_team_supervisor")
  @@index([divisionId], map: "ix_team_division")
  @@index([sectionId], map: "ix_team_section")
  @@index([teamType], map: "ix_team_type")
  @@index([status], map: "ix_team_status")
  @@index([createdBy], map: "ix_team_created_by")
  @@index([updatedBy], map: "ix_team_updated_by")
  @@map("worker_team")
}

/// P2.04 (Spec P3 §8.5): who is in a team, from when to when. NULL effective_to: a current member. A worker
/// is in one team at a time (checked by the service under a lock on the profile: MySQL has no exclusion
/// constraint).
model TeamMember {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  workerTeamId        BigInt    @map("worker_team_id") @db.UnsignedBigInt
  employmentProfileId BigInt    @map("employment_profile_id") @db.UnsignedBigInt
  effectiveFrom       DateTime  @map("effective_from") @db.Date
  effectiveTo         DateTime? @map("effective_to") @db.Date
  /// member | leader | assistant
  roleInTeam          String    @default("member") @map("role_in_team") @db.VarChar(30)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  team    WorkerTeam        @relation(fields: [workerTeamId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_team_member_team")
  profile EmploymentProfile @relation(fields: [employmentProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_team_member_profile")
  creator User              @relation("TeamMemberCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_team_member_created_by")
  updater User?             @relation("TeamMemberUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_team_member_updated_by")

  @@unique([workerTeamId, employmentProfileId, effectiveFrom], map: "ux_team_member")
  @@index([employmentProfileId, effectiveFrom], map: "ix_team_member_profile")
  @@index([workerTeamId, effectiveFrom], map: "ix_team_member_team")
  @@index([effectiveTo], map: "ix_team_member_to")
  @@index([createdBy], map: "ix_team_member_created_by")
  @@index([updatedBy], map: "ix_team_member_updated_by")
  @@map("team_member")
}

/// P2.05 (the manager's design, Add New Contractor, D-2-4): Trade / Work Category. Common lookup shape,
/// client-editable.
model TradeCategory {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  isSystem    Boolean   @default(false) @map("is_system")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy   BigInt?   @map("updated_by") @db.UnsignedBigInt

  contractors Contractor[]
  creator     User         @relation("TradeCategoryCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_trade_category_created_by")
  updater     User?        @relation("TradeCategoryUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_trade_category_updated_by")

  @@unique([code], map: "ux_trade_category_code")
  @@index([status], map: "ix_trade_category_status")
  @@index([createdBy], map: "ix_trade_category_created_by")
  @@index([updatedBy], map: "ix_trade_category_updated_by")
  @@map("trade_category")
}

/// P2.05 (Spec P3 §8.6 + the manager's design, D-2-4): a contractor supplying labour or services. Not an
/// employer of record: its people are contractor_labour, never employment profiles (P1 §5.5.1).
/// contact_person / designation are a cache of the primary party_contact (owner_type contractor).
model Contractor {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// The design's Contractor ID, numbered by the `contractor` format.
  code                  String    @db.VarChar(20)
  name                  String    @db.VarChar(150)
  shortName             String?   @map("short_name") @db.VarChar(50)
  /// individual | company | supplier
  contractorType        String    @map("contractor_type") @db.VarChar(30)
  tradeCategoryId       BigInt?   @map("trade_category_id") @db.UnsignedBigInt
  /// proprietorship | partnership | private_ltd | public_ltd | other
  legalStatus           String?   @map("legal_status") @db.VarChar(30)
  registrationType      String?   @map("registration_type") @db.VarChar(100)
  contractorSince       DateTime? @map("contractor_since") @db.Date
  description           String?   @db.VarChar(1000)
  /// Cache of the primary contact (party_contact is authoritative).
  contactPerson         String?   @map("contact_person") @db.VarChar(150)
  designation           String?   @db.VarChar(100)
  phone                 String?   @db.VarChar(30)
  phoneAlt              String?   @map("phone_alt") @db.VarChar(30)
  email                 String?   @db.VarChar(150)
  addressLine1          String?   @map("address_line1") @db.VarChar(300)
  presentDistrict       String?   @map("present_district") @db.VarChar(100)
  presentUpazila        String?   @map("present_upazila") @db.VarChar(100)
  presentPostalCode     String?   @map("present_postal_code") @db.VarChar(10)
  permanentAddress      String?   @map("permanent_address") @db.VarChar(300)
  permanentDistrict     String?   @map("permanent_district") @db.VarChar(100)
  permanentUpazila      String?   @map("permanent_upazila") @db.VarChar(100)
  permanentPostalCode   String?   @map("permanent_postal_code") @db.VarChar(10)
  nationalId            String?   @map("national_id") @db.VarChar(30)
  /// Company registration no.
  registrationNumber    String?   @map("registration_number") @db.VarChar(50)
  tradeLicenceNumber    String?   @map("trade_licence_number") @db.VarChar(50)
  tradeLicenceExpiry    DateTime? @map("trade_licence_expiry") @db.Date
  bin                   String?   @db.VarChar(30)
  tin                   String?   @db.VarChar(30)
  vatRegistrationNumber String?   @map("vat_registration_number") @db.VarChar(50)
  registrationDate      DateTime? @map("registration_date") @db.Date
  renewalDate           DateTime? @map("renewal_date") @db.Date
  bankName              String?   @map("bank_name") @db.VarChar(150)
  bankBranch            String?   @map("bank_branch") @db.VarChar(150)
  bankAccountName       String?   @map("bank_account_name") @db.VarChar(150)
  bankAccountNumber     String?   @map("bank_account_number") @db.VarChar(40)
  bankRoutingNumber     String?   @map("bank_routing_number") @db.VarChar(20)
  /// bkash | nagad | rocket | upay | other
  mobileBankingProvider String?   @map("mobile_banking_provider") @db.VarChar(30)
  mobileBankingNumber   String?   @map("mobile_banking_number") @db.VarChar(30)
  equipmentOwned        String?   @map("equipment_owned") @db.VarChar(1000)
  yearsOfExperience     Int?      @map("years_of_experience") @db.UnsignedSmallInt
  /// compliant | partially_compliant | non_compliant
  safetyCompliance      String?   @map("safety_compliance") @db.VarChar(30)
  /// excellent | good | average | poor
  qualityRating         String?   @map("quality_rating") @db.VarChar(30)
  remarks               String?   @db.VarChar(500)
  emergencyContactName  String?   @map("emergency_contact_name") @db.VarChar(150)
  /// father | mother | spouse | son | daughter | brother | sister | other
  emergencyRelation     String?   @map("emergency_relation") @db.VarChar(30)
  emergencyPhone        String?   @map("emergency_phone") @db.VarChar(30)
  emergencyPhoneAlt     String?   @map("emergency_phone_alt") @db.VarChar(30)
  emergencyAddress      String?   @map("emergency_address") @db.VarChar(300)
  /// The estate that registered it: who sees and changes it besides the estates it has contracts in.
  registeredEstateId    BigInt?   @map("registered_estate_id") @db.UnsignedBigInt
  /// active | inactive | blacklisted
  status                String    @default("active") @db.VarChar(30)
  blacklistReason       String?   @map("blacklist_reason") @db.VarChar(500)
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy             BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt             DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy             BigInt?   @map("updated_by") @db.UnsignedBigInt

  tradeCategory    TradeCategory?       @relation(fields: [tradeCategoryId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contractor_trade_category")
  registeredEstate Estate?              @relation(fields: [registeredEstateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contractor_registered_estate")
  contracts        ContractorContract[]
  creator          User                 @relation("ContractorCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contractor_created_by")
  updater          User?                @relation("ContractorUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contractor_updated_by")

  @@unique([code], map: "ux_contractor_code")
  @@index([name], map: "ix_contractor_name")
  @@index([contractorType], map: "ix_contractor_type")
  @@index([tradeCategoryId], map: "ix_contractor_trade_category")
  @@index([registeredEstateId], map: "ix_contractor_registered_estate")
  @@index([status], map: "ix_contractor_status")
  @@index([tradeLicenceExpiry], map: "ix_contractor_licence_expiry")
  @@index([createdBy], map: "ix_contractor_created_by")
  @@index([updatedBy], map: "ix_contractor_updated_by")
  @@map("contractor")
}

/// P2.05 (Spec P3 §8.7 + the design's Contract Information): a contract of a contractor at an estate.
/// Approvable (P7 §9.5): draft → submitted → approved, or rejected; an approved contract may be
/// terminated. It is "completed" once its end date has passed (computed, not stored).
model ContractorContract {
  id                       BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  contractorId             BigInt    @map("contractor_id") @db.UnsignedBigInt
  estateId                 BigInt    @map("estate_id") @db.UnsignedBigInt
  /// Numbered by the `contractor_contract` format.
  contractNumber           String    @map("contract_number") @db.VarChar(30)
  /// The design's Contract Reference No.: the contractor's own or the paper agreement's reference.
  referenceNumber          String?   @map("reference_number") @db.VarChar(50)
  /// labour_supply | plucking | field_work | construction | transport | service | other
  workType                 String    @map("work_type") @db.VarChar(30)
  /// per_day | per_kg | per_unit | lump_sum
  rateBasis                String    @map("rate_basis") @db.VarChar(30)
  rate                     Decimal   @db.Decimal(18, 4)
  startDate                DateTime  @map("start_date") @db.Date
  /// Drives the contract-expiry alert.
  endDate                  DateTime  @map("end_date") @db.Date
  /// Required for a lump-sum contract; the estimated value otherwise.
  contractValue            Decimal?  @map("contract_value") @db.Decimal(18, 4)
  retentionPercentage      Decimal?  @map("retention_percentage") @db.Decimal(9, 4)
  /// advance | monthly | quarterly | milestone
  paymentTerms             String?   @map("payment_terms") @db.VarChar(30)
  /// estate | factory | office | field
  workLocation             String?   @map("work_location") @db.VarChar(30)
  divisionId               BigInt?   @map("division_id") @db.UnsignedBigInt
  /// The design's Reporting To (Estate Manager, HR Manager …): a designation.
  reportingToDesignationId BigInt?   @map("reporting_to_designation_id") @db.UnsignedBigInt
  terms                    String?   @db.Text
  // ---- state block (P3 §3.2): draft | submitted | approved | rejected | terminated ----
  state                    String    @default("draft") @db.VarChar(30)
  stateChangedAt           DateTime? @map("state_changed_at") @db.DateTime(0)
  terminatedOn             DateTime? @map("terminated_on") @db.Date
  terminatedAt             DateTime? @map("terminated_at") @db.DateTime(0)
  terminatedBy             BigInt?   @map("terminated_by") @db.UnsignedBigInt
  terminationReason        String?   @map("termination_reason") @db.VarChar(500)
  // ---- approval block (P3 §3.3) ----
  submittedAt              DateTime? @map("submitted_at") @db.DateTime(0)
  submittedBy              BigInt?   @map("submitted_by") @db.UnsignedBigInt
  approvedAt               DateTime? @map("approved_at") @db.DateTime(0)
  approvedBy               BigInt?   @map("approved_by") @db.UnsignedBigInt
  rejectedAt               DateTime? @map("rejected_at") @db.DateTime(0)
  rejectedBy               BigInt?   @map("rejected_by") @db.UnsignedBigInt
  rejectionReason          String?   @map("rejection_reason") @db.VarChar(500)
  version                  Int       @default(1)
  createdAt                DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy                BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt                DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy                BigInt?   @map("updated_by") @db.UnsignedBigInt

  contractor  Contractor         @relation(fields: [contractorId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contract_contractor")
  estate      Estate             @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contract_estate")
  division    Division?          @relation(fields: [divisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contract_division")
  reportingTo Designation?       @relation(fields: [reportingToDesignationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contract_reporting_to")
  labour      ContractorLabour[]
  creator     User               @relation("ContractCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contract_created_by")
  updater     User?              @relation("ContractUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contract_updated_by")
  submitter   User?              @relation("ContractSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contract_submitted_by")
  approver    User?              @relation("ContractApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contract_approved_by")
  rejecter    User?              @relation("ContractRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contract_rejected_by")
  terminator  User?              @relation("ContractTerminatedBy", fields: [terminatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contract_terminated_by")

  @@unique([contractNumber], map: "ux_contract_number")
  @@index([contractorId], map: "ix_contract_contractor")
  @@index([estateId], map: "ix_contract_estate")
  @@index([divisionId], map: "ix_contract_division")
  @@index([reportingToDesignationId], map: "ix_contract_reporting_to")
  @@index([startDate], map: "ix_contract_start")
  @@index([endDate], map: "ix_contract_end")
  @@index([state], map: "ix_contract_state")
  @@index([createdBy], map: "ix_contract_created_by")
  @@index([updatedBy], map: "ix_contract_updated_by")
  @@index([submittedBy], map: "ix_contract_submitted_by")
  @@index([approvedBy], map: "ix_contract_approved_by")
  @@index([rejectedBy], map: "ix_contract_rejected_by")
  @@index([terminatedBy], map: "ix_contract_terminated_by")
  @@map("contractor_contract")
}

/// P2.05 (Spec P3 §8.8): named people supplied under a contract, for attendance, safety and output.
/// They have NO employment profile and NO payroll relationship (P1 §5.5.1): no payroll table may ever
/// reference this one. Contractor cost reaches the ledger through a contractor bill and a payable.
model ContractorLabour {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  contractorContractId BigInt    @map("contractor_contract_id") @db.UnsignedBigInt
  /// Unique within the contract.
  labourCode           String    @map("labour_code") @db.VarChar(20)
  name                 String    @db.VarChar(150)
  nationalId           String?   @map("national_id") @db.VarChar(30)
  phone                String?   @db.VarChar(30)
  engagedFrom          DateTime? @map("engaged_from") @db.Date
  engagedTo            DateTime? @map("engaged_to") @db.Date
  /// active | inactive
  status               String    @default("active") @db.VarChar(30)
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy            BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt            DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy            BigInt?   @map("updated_by") @db.UnsignedBigInt

  contract ContractorContract @relation(fields: [contractorContractId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contractor_labour_contract")
  creator  User               @relation("ContractorLabourCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contractor_labour_created_by")
  updater  User?              @relation("ContractorLabourUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_contractor_labour_updated_by")

  @@unique([contractorContractId, labourCode], map: "ux_contractor_labour")
  @@index([status], map: "ix_contractor_labour_status")
  @@index([nationalId], map: "ix_contractor_labour_nid")
  @@index([createdBy], map: "ix_contractor_labour_created_by")
  @@index([updatedBy], map: "ix_contractor_labour_updated_by")
  @@map("contractor_labour")
}

/// P2.07 (Spec P3 §22.1, P9 §12): a profile's entitlement of a leave type for a fiscal year. Generated,
/// not keyed: pro-rata for a mid-year joiner or leaver, the previous year's balance carried forward up to
/// the type's limit. consumed_days is maintained from approved leave, under a lock on this row.
model LeaveEntitlement {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employmentProfileId BigInt    @map("employment_profile_id") @db.UnsignedBigInt
  leaveTypeId         BigInt    @map("leave_type_id") @db.UnsignedBigInt
  fiscalYearId        BigInt    @map("fiscal_year_id") @db.UnsignedBigInt
  /// The rule version that produced the figure: from Phase 9 (statutory_rule). NULL: the leave type's days.
  statutoryRuleId     BigInt?   @map("statutory_rule_id") @db.UnsignedBigInt
  entitledDays        Decimal   @map("entitled_days") @db.Decimal(9, 4)
  carriedForwardDays  Decimal   @default(0) @map("carried_forward_days") @db.Decimal(9, 4)
  adjustmentDays      Decimal   @default(0) @map("adjustment_days") @db.Decimal(9, 4)
  adjustmentReason    String?   @map("adjustment_reason") @db.VarChar(300)
  consumedDays        Decimal   @default(0) @map("consumed_days") @db.Decimal(9, 4)
  encashedDays        Decimal   @default(0) @map("encashed_days") @db.Decimal(9, 4)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  profile    EmploymentProfile @relation(fields: [employmentProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_entitlement_profile")
  leaveType  LeaveType         @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_entitlement_type")
  fiscalYear FiscalYear        @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_entitlement_fiscal_year")
  requests   LeaveRequest[]
  creator    User              @relation("LeaveEntitlementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_entitlement_created_by")
  updater    User?             @relation("LeaveEntitlementUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_entitlement_updated_by")

  @@unique([employmentProfileId, leaveTypeId, fiscalYearId], map: "ux_leave_entitlement")
  @@index([leaveTypeId], map: "ix_leave_entitlement_type")
  @@index([fiscalYearId], map: "ix_leave_entitlement_fiscal_year")
  @@index([createdBy], map: "ix_leave_entitlement_created_by")
  @@index([updatedBy], map: "ix_leave_entitlement_updated_by")
  @@map("leave_entitlement")
}

/// P2.07 (Spec P3 §22.2, P7 §7.9): a leave request. Approvable; approval consumes the entitlement under a
/// lock (the balance must be available unless the type allows a negative one). Attendance for the dates
/// is written from P5.02. Cancelling approved leave restores the balance.
model LeaveRequest {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employmentProfileId BigInt    @map("employment_profile_id") @db.UnsignedBigInt
  /// The profile's estate, copied: scope and the approval place read it.
  estateId            BigInt    @map("estate_id") @db.UnsignedBigInt
  leaveTypeId         BigInt    @map("leave_type_id") @db.UnsignedBigInt
  requestNumber       String    @map("request_number") @db.VarChar(30)
  fromDate            DateTime  @map("from_date") @db.Date
  toDate              DateTime  @map("to_date") @db.Date
  /// Working days (weekly offs excluded; holidays and rosters from P5.01); a half day is 0.500.
  dayCount            Decimal   @map("day_count") @db.Decimal(9, 4)
  isHalfDay           Boolean   @default(false) @map("is_half_day")
  reason              String?   @db.VarChar(500)
  contactDuringLeave  String?   @map("contact_during_leave") @db.VarChar(30)
  coveringProfileId   BigInt?   @map("covering_profile_id") @db.UnsignedBigInt
  leaveEntitlementId  BigInt?   @map("leave_entitlement_id") @db.UnsignedBigInt
  isPaid              Boolean   @default(true) @map("is_paid")
  /// draft | submitted | approved | rejected | cancelled
  state               String    @default("draft") @db.VarChar(30)
  stateChangedAt      DateTime? @map("state_changed_at") @db.DateTime(0)
  cancelledAt         DateTime? @map("cancelled_at") @db.DateTime(0)
  cancelledBy         BigInt?   @map("cancelled_by") @db.UnsignedBigInt
  cancellationReason  String?   @map("cancellation_reason") @db.VarChar(500)
  submittedAt         DateTime? @map("submitted_at") @db.DateTime(0)
  submittedBy         BigInt?   @map("submitted_by") @db.UnsignedBigInt
  approvedAt          DateTime? @map("approved_at") @db.DateTime(0)
  approvedBy          BigInt?   @map("approved_by") @db.UnsignedBigInt
  rejectedAt          DateTime? @map("rejected_at") @db.DateTime(0)
  rejectedBy          BigInt?   @map("rejected_by") @db.UnsignedBigInt
  rejectionReason     String?   @map("rejection_reason") @db.VarChar(500)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  profile     EmploymentProfile  @relation("LeaveRequestProfile", fields: [employmentProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_request_profile")
  estate      Estate             @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_request_estate")
  leaveType   LeaveType          @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_request_type")
  covering    EmploymentProfile? @relation("LeaveRequestCovering", fields: [coveringProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_request_covering")
  entitlement LeaveEntitlement?  @relation(fields: [leaveEntitlementId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_request_entitlement")
  creator     User               @relation("LeaveRequestCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_request_created_by")
  updater     User?              @relation("LeaveRequestUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_request_updated_by")
  submitter   User?              @relation("LeaveRequestSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_request_submitted_by")
  approver    User?              @relation("LeaveRequestApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_request_approved_by")
  rejecter    User?              @relation("LeaveRequestRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_request_rejected_by")
  canceller   User?              @relation("LeaveRequestCancelledBy", fields: [cancelledBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_leave_request_cancelled_by")

  @@unique([requestNumber], map: "ux_leave_request_number")
  @@index([employmentProfileId, fromDate], map: "ix_leave_request_profile")
  @@index([estateId], map: "ix_leave_request_estate")
  @@index([leaveTypeId], map: "ix_leave_request_type")
  @@index([fromDate], map: "ix_leave_request_from")
  @@index([toDate], map: "ix_leave_request_to")
  @@index([state], map: "ix_leave_request_state")
  @@index([coveringProfileId], map: "ix_leave_request_covering")
  @@index([leaveEntitlementId], map: "ix_leave_request_entitlement")
  @@index([createdBy], map: "ix_leave_request_created_by")
  @@index([updatedBy], map: "ix_leave_request_updated_by")
  @@index([submittedBy], map: "ix_leave_request_submitted_by")
  @@index([approvedBy], map: "ix_leave_request_approved_by")
  @@index([rejectedBy], map: "ix_leave_request_rejected_by")
  @@index([cancelledBy], map: "ix_leave_request_cancelled_by")
  @@map("leave_request")
}

/// P2.08 (Spec P3 §23.1): a kind of benefit (housing, ration, medical …). Common lookup shape. A benefit
/// is an entitlement with an employer cost; it becomes a payroll earning ONLY by explicit configuration
/// (payroll_treatment, with its pay component type), which opens with payroll (Phase 9, D-2.08-2).
model BenefitType {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code                String    @db.VarChar(20)
  name                String    @db.VarChar(150)
  description         String?   @db.VarChar(500)
  sortOrder           Int       @default(0) @map("sort_order")
  isSystem            Boolean   @default(false) @map("is_system")
  /// housing | medical | transport | ration | education | utility | other
  benefitCategory     String    @map("benefit_category") @db.VarChar(30)
  /// one_time | weekly | monthly | quarterly | annual | on_demand
  issueFrequency      String?   @map("issue_frequency") @db.VarChar(30)
  /// Indicative unit cost; the actual is recorded per issue.
  defaultEmployerCost Decimal?  @map("default_employer_cost") @db.Decimal(18, 4)
  /// For measurable benefits such as ration (kg).
  uomId               BigInt?   @map("uom_id") @db.UnsignedBigInt
  /// not_payroll | taxable_perquisite | cash_component. Default not_payroll.
  payrollTreatment    String    @default("not_payroll") @map("payroll_treatment") @db.VarChar(30)
  /// The pay component type: required when payroll_treatment is not not_payroll. No FK until Phase 9.
  componentTypeId     BigInt?   @map("component_type_id") @db.UnsignedBigInt
  /// No FK until the chart of accounts (Phase 3).
  expenseAccountId    BigInt?   @map("expense_account_id") @db.UnsignedBigInt
  /// active | inactive
  status              String    @default("active") @db.VarChar(30)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  uom          Uom?                 @relation(fields: [uomId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_type_uom")
  entitlements BenefitEntitlement[]
  creator      User                 @relation("BenefitTypeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_type_created_by")
  updater      User?                @relation("BenefitTypeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_type_updated_by")

  @@unique([code], map: "ux_benefit_type_code")
  @@index([benefitCategory], map: "ix_benefit_type_category")
  @@index([uomId], map: "ix_benefit_type_uom")
  @@index([status], map: "ix_benefit_type_status")
  @@index([createdBy], map: "ix_benefit_type_created_by")
  @@index([updatedBy], map: "ix_benefit_type_updated_by")
  @@map("benefit_type")
}

/// P2.08 (Spec P3 §23.2; the design's Ration Card tab): a profile's entitlement to a benefit for a
/// period. Approvable (operational): draft → submitted → approved, or rejected; an approved one may be
/// withdrawn (effective_to and a reason).
model BenefitEntitlement {
  id                    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  employmentProfileId   BigInt    @map("employment_profile_id") @db.UnsignedBigInt
  /// The profile's estate, copied: scope and the approval place read it.
  estateId              BigInt    @map("estate_id") @db.UnsignedBigInt
  benefitTypeId         BigInt    @map("benefit_type_id") @db.UnsignedBigInt
  /// The design's Issue Date.
  effectiveFrom         DateTime  @map("effective_from") @db.Date
  /// The design's Valid Till; set on withdrawal.
  effectiveTo           DateTime? @map("effective_to") @db.Date
  quantityPerPeriod     Decimal?  @map("quantity_per_period") @db.Decimal(14, 3)
  employerCostPerPeriod Decimal?  @map("employer_cost_per_period") @db.Decimal(18, 4)
  employeeContribution  Decimal   @default(0) @map("employee_contribution") @db.Decimal(18, 4)
  /// The design's Ration Card No. (or a quarter / house number).
  allocationReference   String?   @map("allocation_reference") @db.VarChar(50)
  /// The design's Ration Dealer / Office.
  issuingOffice         String?   @map("issuing_office") @db.VarChar(150)
  /// Homestead land (P5.03). No FK until land allocations exist.
  landAllocationId      BigInt?   @map("land_allocation_id") @db.UnsignedBigInt
  withdrawalReason      String?   @map("withdrawal_reason") @db.VarChar(300)
  /// draft | submitted | approved | rejected | withdrawn
  state                 String    @default("draft") @db.VarChar(30)
  stateChangedAt        DateTime? @map("state_changed_at") @db.DateTime(0)
  submittedAt           DateTime? @map("submitted_at") @db.DateTime(0)
  submittedBy           BigInt?   @map("submitted_by") @db.UnsignedBigInt
  approvedAt            DateTime? @map("approved_at") @db.DateTime(0)
  approvedBy            BigInt?   @map("approved_by") @db.UnsignedBigInt
  rejectedAt            DateTime? @map("rejected_at") @db.DateTime(0)
  rejectedBy            BigInt?   @map("rejected_by") @db.UnsignedBigInt
  rejectionReason       String?   @map("rejection_reason") @db.VarChar(500)
  version               Int       @default(1)
  createdAt             DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy             BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt             DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy             BigInt?   @map("updated_by") @db.UnsignedBigInt

  profile     EmploymentProfile @relation(fields: [employmentProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_entitlement_profile")
  benefitType BenefitType       @relation(fields: [benefitTypeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_entitlement_type")
  issues      BenefitIssue[]
  creator     User              @relation("BenefitEntitlementCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_entitlement_created_by")
  updater     User?             @relation("BenefitEntitlementUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_entitlement_updated_by")
  submitter   User?             @relation("BenefitEntitlementSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_entitlement_submitted_by")
  approver    User?             @relation("BenefitEntitlementApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_entitlement_approved_by")
  rejecter    User?             @relation("BenefitEntitlementRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_entitlement_rejected_by")

  @@unique([employmentProfileId, benefitTypeId, effectiveFrom], map: "ux_benefit_entitlement")
  @@index([estateId], map: "ix_benefit_entitlement_estate")
  @@index([benefitTypeId], map: "ix_benefit_entitlement_type")
  @@index([effectiveFrom], map: "ix_benefit_entitlement_from")
  @@index([effectiveTo], map: "ix_benefit_entitlement_to")
  @@index([state], map: "ix_benefit_entitlement_state")
  @@index([createdBy], map: "ix_benefit_entitlement_created_by")
  @@index([updatedBy], map: "ix_benefit_entitlement_updated_by")
  @@index([submittedBy], map: "ix_benefit_entitlement_submitted_by")
  @@index([approvedBy], map: "ix_benefit_entitlement_approved_by")
  @@index([rejectedBy], map: "ix_benefit_entitlement_rejected_by")
  @@map("benefit_entitlement")
}

/// P2.08 (Spec P3 §23.3): one issue of a benefit under an approved entitlement (this month's ration).
/// Approvable (financial: it carries an employer cost). Stock consumption for ration (P4.04) and the
/// posting block (Phase 3) join later; stock_movement_id and payroll_component_id have no FK yet.
model BenefitIssue {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  benefitEntitlementId BigInt    @map("benefit_entitlement_id") @db.UnsignedBigInt
  estateId             BigInt    @map("estate_id") @db.UnsignedBigInt
  issueDate            DateTime  @map("issue_date") @db.Date
  /// The month or week the issue covers, e.g. 2026-10.
  periodReference      String?   @map("period_reference") @db.VarChar(30)
  quantity             Decimal?  @db.Decimal(14, 3)
  employerCost         Decimal   @map("employer_cost") @db.Decimal(18, 4)
  employeeContribution Decimal   @default(0) @map("employee_contribution") @db.Decimal(18, 4)
  stockMovementId      BigInt?   @map("stock_movement_id") @db.UnsignedBigInt
  payrollComponentId   BigInt?   @map("payroll_component_id") @db.UnsignedBigInt
  issuedByProfileId    BigInt?   @map("issued_by_profile_id") @db.UnsignedBigInt
  /// draft | submitted | approved | rejected
  state                String    @default("draft") @db.VarChar(30)
  stateChangedAt       DateTime? @map("state_changed_at") @db.DateTime(0)
  submittedAt          DateTime? @map("submitted_at") @db.DateTime(0)
  submittedBy          BigInt?   @map("submitted_by") @db.UnsignedBigInt
  approvedAt           DateTime? @map("approved_at") @db.DateTime(0)
  approvedBy           BigInt?   @map("approved_by") @db.UnsignedBigInt
  rejectedAt           DateTime? @map("rejected_at") @db.DateTime(0)
  rejectedBy           BigInt?   @map("rejected_by") @db.UnsignedBigInt
  rejectionReason      String?   @map("rejection_reason") @db.VarChar(500)
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy            BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt            DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy            BigInt?   @map("updated_by") @db.UnsignedBigInt

  entitlement BenefitEntitlement @relation(fields: [benefitEntitlementId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_issue_entitlement")
  issuedBy    EmploymentProfile? @relation("BenefitIssueIssuedBy", fields: [issuedByProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_issue_issued_by")
  creator     User               @relation("BenefitIssueCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_issue_created_by")
  updater     User?              @relation("BenefitIssueUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_issue_updated_by")
  submitter   User?              @relation("BenefitIssueSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_issue_submitted_by")
  approver    User?              @relation("BenefitIssueApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_issue_approved_by")
  rejecter    User?              @relation("BenefitIssueRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_benefit_issue_rejected_by")

  @@unique([benefitEntitlementId, issueDate], map: "ux_benefit_issue")
  @@index([estateId], map: "ix_benefit_issue_estate")
  @@index([issueDate], map: "ix_benefit_issue_date")
  @@index([state], map: "ix_benefit_issue_state")
  @@index([issuedByProfileId], map: "ix_benefit_issue_issued_by")
  @@index([createdBy], map: "ix_benefit_issue_created_by")
  @@index([updatedBy], map: "ix_benefit_issue_updated_by")
  @@index([submittedBy], map: "ix_benefit_issue_submitted_by")
  @@index([approvedBy], map: "ix_benefit_issue_approved_by")
  @@index([rejectedBy], map: "ix_benefit_issue_rejected_by")
  @@map("benefit_issue")
}

/// P2.08 (Spec P3 §23.4): a welfare case (medical help, education, disaster relief …) for a worker, a
/// person or the community. Approvable (financial, requested amount); then disbursed up to the approved
/// amount and closed with its outcome. budget_head_id has no FK until budgets (Phase 3).
model WelfareCase {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  caseNumber      String    @map("case_number") @db.VarChar(30)
  estateId        BigInt    @map("estate_id") @db.UnsignedBigInt
  /// employment_profile | person | community
  beneficiaryType String    @map("beneficiary_type") @db.VarChar(30)
  /// NULL for a community case.
  beneficiaryId   BigInt?   @map("beneficiary_id") @db.UnsignedBigInt
  /// medical | education | disaster | bereavement | community | other
  welfareCategory String    @map("welfare_category") @db.VarChar(30)
  caseDate        DateTime  @map("case_date") @db.Date
  description     String    @db.VarChar(500)
  requestedAmount Decimal?  @map("requested_amount") @db.Decimal(18, 4)
  approvedAmount  Decimal?  @map("approved_amount") @db.Decimal(18, 4)
  disbursedAmount Decimal   @default(0) @map("disbursed_amount") @db.Decimal(18, 4)
  budgetHeadId    BigInt?   @map("budget_head_id") @db.UnsignedBigInt
  outcome         String?   @db.VarChar(500)
  /// draft | submitted | approved | rejected | closed
  state           String    @default("draft") @db.VarChar(30)
  stateChangedAt  DateTime? @map("state_changed_at") @db.DateTime(0)
  submittedAt     DateTime? @map("submitted_at") @db.DateTime(0)
  submittedBy     BigInt?   @map("submitted_by") @db.UnsignedBigInt
  approvedAt      DateTime? @map("approved_at") @db.DateTime(0)
  approvedBy      BigInt?   @map("approved_by") @db.UnsignedBigInt
  rejectedAt      DateTime? @map("rejected_at") @db.DateTime(0)
  rejectedBy      BigInt?   @map("rejected_by") @db.UnsignedBigInt
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy       BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt       DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy       BigInt?   @map("updated_by") @db.UnsignedBigInt

  estate    Estate @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_welfare_case_estate")
  creator   User   @relation("WelfareCaseCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_welfare_case_created_by")
  updater   User?  @relation("WelfareCaseUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_welfare_case_updated_by")
  submitter User?  @relation("WelfareCaseSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_welfare_case_submitted_by")
  approver  User?  @relation("WelfareCaseApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_welfare_case_approved_by")
  rejecter  User?  @relation("WelfareCaseRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_welfare_case_rejected_by")

  @@unique([caseNumber], map: "ux_welfare_case_number")
  @@index([estateId], map: "ix_welfare_case_estate")
  @@index([beneficiaryType, beneficiaryId], map: "ix_welfare_case_beneficiary")
  @@index([welfareCategory], map: "ix_welfare_case_category")
  @@index([caseDate], map: "ix_welfare_case_date")
  @@index([state], map: "ix_welfare_case_state")
  @@index([createdBy], map: "ix_welfare_case_created_by")
  @@index([updatedBy], map: "ix_welfare_case_updated_by")
  @@index([submittedBy], map: "ix_welfare_case_submitted_by")
  @@index([approvedBy], map: "ix_welfare_case_approved_by")
  @@index([rejectedBy], map: "ix_welfare_case_rejected_by")
  @@map("welfare_case")
}

/// P2.09 (Spec P3 §24.1): a training programme at an estate. Approvable (operational: its cost):
/// draft → submitted → approved (planned), or rejected; an approved one is completed once its
/// participants' attendance is recorded, or cancelled. budget_head_id has no FK until budgets (Phase 3).
model TrainingProgram {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  /// Numbered TP-… per estate and year when not given.
  programCode        String    @map("program_code") @db.VarChar(30)
  estateId           BigInt    @map("estate_id") @db.UnsignedBigInt
  title              String    @db.VarChar(200)
  /// induction | safety | technical | skill | compliance | health | leadership | other
  trainingType       String    @map("training_type") @db.VarChar(30)
  trainerName        String?   @map("trainer_name") @db.VarChar(150)
  /// internal | external
  trainerType        String    @default("internal") @map("trainer_type") @db.VarChar(30)
  venue              String?   @db.VarChar(200)
  startDate          DateTime  @map("start_date") @db.Date
  endDate            DateTime  @map("end_date") @db.Date
  durationHours      Decimal?  @map("duration_hours") @db.Decimal(9, 4)
  /// The most participants; NULL: no limit.
  capacity           Int?      @db.UnsignedSmallInt
  cost               Decimal?  @db.Decimal(18, 4)
  budgetHeadId       BigInt?   @map("budget_head_id") @db.UnsignedBigInt
  description        String?   @db.VarChar(1000)
  /// draft | submitted | approved | rejected | completed | cancelled
  state              String    @default("draft") @db.VarChar(30)
  stateChangedAt     DateTime? @map("state_changed_at") @db.DateTime(0)
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(500)
  submittedAt        DateTime? @map("submitted_at") @db.DateTime(0)
  submittedBy        BigInt?   @map("submitted_by") @db.UnsignedBigInt
  approvedAt         DateTime? @map("approved_at") @db.DateTime(0)
  approvedBy         BigInt?   @map("approved_by") @db.UnsignedBigInt
  rejectedAt         DateTime? @map("rejected_at") @db.DateTime(0)
  rejectedBy         BigInt?   @map("rejected_by") @db.UnsignedBigInt
  rejectionReason    String?   @map("rejection_reason") @db.VarChar(500)
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy          BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt          DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy          BigInt?   @map("updated_by") @db.UnsignedBigInt

  estate       Estate                @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_training_program_estate")
  participants TrainingParticipant[]
  creator      User                  @relation("TrainingProgramCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_training_program_created_by")
  updater      User?                 @relation("TrainingProgramUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_training_program_updated_by")
  submitter    User?                 @relation("TrainingProgramSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_training_program_submitted_by")
  approver     User?                 @relation("TrainingProgramApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_training_program_approved_by")
  rejecter     User?                 @relation("TrainingProgramRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_training_program_rejected_by")

  @@unique([programCode], map: "ux_training_program_code")
  @@index([estateId], map: "ix_training_program_estate")
  @@index([startDate], map: "ix_training_program_start")
  @@index([trainingType], map: "ix_training_program_type")
  @@index([state], map: "ix_training_program_state")
  @@index([createdBy], map: "ix_training_program_created_by")
  @@index([updatedBy], map: "ix_training_program_updated_by")
  @@index([submittedBy], map: "ix_training_program_submitted_by")
  @@index([approvedBy], map: "ix_training_program_approved_by")
  @@index([rejectedBy], map: "ix_training_program_rejected_by")
  @@map("training_program")
}

/// P2.09 (Spec P3 §24.1): a profile in a training programme: attendance, score, result, certificate,
/// feedback. One row per programme and profile (ux_training_participant: the verification).
model TrainingParticipant {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  trainingProgramId   BigInt    @map("training_program_id") @db.UnsignedBigInt
  employmentProfileId BigInt    @map("employment_profile_id") @db.UnsignedBigInt
  /// registered | attended | absent | withdrawn
  attendanceStatus    String    @default("registered") @map("attendance_status") @db.VarChar(30)
  /// 0 – 100.
  score               Decimal?  @db.Decimal(9, 4)
  /// pass | fail | not_assessed
  result              String    @default("not_assessed") @db.VarChar(30)
  certificateNumber   String?   @map("certificate_number") @db.VarChar(50)
  certificateIssuedOn DateTime? @map("certificate_issued_on") @db.Date
  /// 1 – 5.
  feedbackRating      Int?      @map("feedback_rating") @db.UnsignedTinyInt
  remarks             String?   @db.VarChar(500)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  program TrainingProgram   @relation(fields: [trainingProgramId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_training_participant_program")
  profile EmploymentProfile @relation(fields: [employmentProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_training_participant_profile")
  creator User              @relation("TrainingParticipantCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_training_participant_created_by")
  updater User?             @relation("TrainingParticipantUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_training_participant_updated_by")

  @@unique([trainingProgramId, employmentProfileId], map: "ux_training_participant")
  @@index([employmentProfileId], map: "ix_training_participant_profile")
  @@index([createdBy], map: "ix_training_participant_created_by")
  @@index([updatedBy], map: "ix_training_participant_updated_by")
  @@map("training_participant")
}

/// P2.10 (Spec P3 §24.2): a goal of a profile, a department or an estate, with its KPI and target.
/// Approvable: draft → submitted → active (approved), or rejected; progress makes it in_progress; it is
/// completed, or cancelled. delayed / overdue are computed nightly from the dates and progress.
model Goal {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  goalCode           String    @map("goal_code") @db.VarChar(30)
  /// employment_profile | department | estate
  ownerType          String    @map("owner_type") @db.VarChar(30)
  ownerId            BigInt    @map("owner_id") @db.UnsignedBigInt
  /// The estate the goal belongs to (the owner's, or the department goal's estate): scope reads it.
  estateId           BigInt    @map("estate_id") @db.UnsignedBigInt
  /// Links an individual goal to a departmental or estate objective.
  parentGoalId       BigInt?   @map("parent_goal_id") @db.UnsignedBigInt
  title              String    @db.VarChar(200)
  description        String?   @db.VarChar(500)
  kpiName            String?   @map("kpi_name") @db.VarChar(150)
  measureUnit        String?   @map("measure_unit") @db.VarChar(50)
  targetValue        Decimal?  @map("target_value") @db.Decimal(18, 4)
  /// Maintained from goal_progress.
  currentValue       Decimal   @default(0) @map("current_value") @db.Decimal(18, 4)
  /// Relative weight within the owner's goal set.
  weight             Decimal?  @db.Decimal(9, 4)
  startDate          DateTime  @map("start_date") @db.Date
  /// Drives the goal calendar and the overdue count.
  dueDate            DateTime  @map("due_date") @db.Date
  reviewDate         DateTime? @map("review_date") @db.Date
  progressPercentage Decimal   @default(0) @map("progress_percentage") @db.Decimal(9, 4)
  /// draft | submitted | active | in_progress | delayed | overdue | completed | rejected | cancelled
  state              String    @default("draft") @db.VarChar(30)
  stateChangedAt     DateTime? @map("state_changed_at") @db.DateTime(0)
  completedAt        DateTime? @map("completed_at") @db.DateTime(0)
  cancellationReason String?   @map("cancellation_reason") @db.VarChar(500)
  submittedAt        DateTime? @map("submitted_at") @db.DateTime(0)
  submittedBy        BigInt?   @map("submitted_by") @db.UnsignedBigInt
  approvedAt         DateTime? @map("approved_at") @db.DateTime(0)
  approvedBy         BigInt?   @map("approved_by") @db.UnsignedBigInt
  rejectedAt         DateTime? @map("rejected_at") @db.DateTime(0)
  rejectedBy         BigInt?   @map("rejected_by") @db.UnsignedBigInt
  rejectionReason    String?   @map("rejection_reason") @db.VarChar(500)
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy          BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt          DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy          BigInt?   @map("updated_by") @db.UnsignedBigInt

  estate    Estate           @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_goal_estate")
  parent    Goal?            @relation("GoalParent", fields: [parentGoalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_goal_parent")
  children  Goal[]           @relation("GoalParent")
  progress  GoalProgress[]
  lines     EvaluationLine[]
  creator   User             @relation("GoalCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_goal_created_by")
  updater   User?            @relation("GoalUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_goal_updated_by")
  submitter User?            @relation("GoalSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_goal_submitted_by")
  approver  User?            @relation("GoalApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_goal_approved_by")
  rejecter  User?            @relation("GoalRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_goal_rejected_by")

  @@unique([goalCode], map: "ux_goal_code")
  @@index([ownerType, ownerId], map: "ix_goal_owner")
  @@index([estateId], map: "ix_goal_estate")
  @@index([parentGoalId], map: "ix_goal_parent")
  @@index([startDate], map: "ix_goal_start")
  @@index([dueDate], map: "ix_goal_due")
  @@index([reviewDate], map: "ix_goal_review")
  @@index([state], map: "ix_goal_state")
  @@index([createdBy], map: "ix_goal_created_by")
  @@index([updatedBy], map: "ix_goal_updated_by")
  @@index([submittedBy], map: "ix_goal_submitted_by")
  @@index([approvedBy], map: "ix_goal_approved_by")
  @@index([rejectedBy], map: "ix_goal_rejected_by")
  @@map("goal")
}

/// P2.10 (Spec P3 §24.2): a progress update of a goal (its value and percentage on a date).
model GoalProgress {
  id                 BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  goalId             BigInt   @map("goal_id") @db.UnsignedBigInt
  progressDate       DateTime @map("progress_date") @db.Date
  value              Decimal? @db.Decimal(18, 4)
  progressPercentage Decimal  @map("progress_percentage") @db.Decimal(9, 4)
  note               String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at") @db.DateTime(0)
  /// recorded_by (P3): the user who recorded it.
  createdBy          BigInt   @map("created_by") @db.UnsignedBigInt

  goal    Goal @relation(fields: [goalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_goal_progress_goal")
  creator User @relation("GoalProgressCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_goal_progress_created_by")

  @@index([goalId, progressDate], map: "ix_goal_progress_goal")
  @@index([createdBy], map: "ix_goal_progress_created_by")
  @@map("goal_progress")
}

/// P2.10 (Spec P3 §24.3): what an evaluation scores (job knowledge, quality, attendance …). Common lookup
/// shape plus its group, maximum score, who it applies to and whether it scores a goal.
model EvaluationCriteria {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code          String    @db.VarChar(20)
  name          String    @db.VarChar(150)
  description   String?   @db.VarChar(500)
  sortOrder     Int       @default(0) @map("sort_order")
  isSystem      Boolean   @default(false) @map("is_system")
  /// competency | performance | behaviour | goals | other
  criteriaGroup String    @map("criteria_group") @db.VarChar(30)
  maxScore      Decimal   @default(5) @map("max_score") @db.Decimal(9, 4)
  /// all | worker | employee (P3 applies_to_category_id, simplified: D-2.10-5)
  appliesTo     String    @default("all") @map("applies_to") @db.VarChar(30)
  isGoalLinked  Boolean   @default(false) @map("is_goal_linked")
  /// active | inactive
  status        String    @default("active") @db.VarChar(30)
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy     BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt     DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy     BigInt?   @map("updated_by") @db.UnsignedBigInt

  lines   EvaluationLine[]
  creator User             @relation("EvaluationCriteriaCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_criteria_created_by")
  updater User?            @relation("EvaluationCriteriaUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_criteria_updated_by")

  @@unique([code], map: "ux_evaluation_criteria_code")
  @@index([status], map: "ix_evaluation_criteria_status")
  @@index([createdBy], map: "ix_evaluation_criteria_created_by")
  @@index([updatedBy], map: "ix_evaluation_criteria_updated_by")
  @@map("evaluation_criteria")
}

/// P2.10 (Spec P3 §24.3): an evaluation of a profile for a period by a reviewer. Approvable: draft →
/// submitted → approved, or rejected; then acknowledged by the employee, which locks it for good. Never
/// deleted; historical evaluations stay accessible in full.
model Evaluation {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  evaluationNumber    String    @map("evaluation_number") @db.VarChar(30)
  employmentProfileId BigInt    @map("employment_profile_id") @db.UnsignedBigInt
  estateId            BigInt    @map("estate_id") @db.UnsignedBigInt
  reviewerProfileId   BigInt?   @map("reviewer_profile_id") @db.UnsignedBigInt
  periodStart         DateTime  @map("period_start") @db.Date
  periodEnd           DateTime  @map("period_end") @db.Date
  /// annual | probation | project
  evaluationType      String    @map("evaluation_type") @db.VarChar(30)
  /// Σ weighted scores ÷ Σ weights, as a percentage (computed from the lines).
  overallScore        Decimal?  @map("overall_score") @db.Decimal(9, 4)
  /// outstanding | exceeds | meets | needs_improvement | unsatisfactory (from the score)
  overallRating       String?   @map("overall_rating") @db.VarChar(30)
  strengths           String?   @db.VarChar(1000)
  developmentNeeds    String?   @map("development_needs") @db.VarChar(1000)
  reviewerComment     String?   @map("reviewer_comment") @db.VarChar(1000)
  employeeComment     String?   @map("employee_comment") @db.VarChar(1000)
  acknowledgedAt      DateTime? @map("acknowledged_at") @db.DateTime(0)
  /// draft | submitted | approved | rejected | acknowledged
  state               String    @default("draft") @db.VarChar(30)
  stateChangedAt      DateTime? @map("state_changed_at") @db.DateTime(0)
  submittedAt         DateTime? @map("submitted_at") @db.DateTime(0)
  submittedBy         BigInt?   @map("submitted_by") @db.UnsignedBigInt
  approvedAt          DateTime? @map("approved_at") @db.DateTime(0)
  approvedBy          BigInt?   @map("approved_by") @db.UnsignedBigInt
  rejectedAt          DateTime? @map("rejected_at") @db.DateTime(0)
  rejectedBy          BigInt?   @map("rejected_by") @db.UnsignedBigInt
  rejectionReason     String?   @map("rejection_reason") @db.VarChar(500)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  profile   EmploymentProfile  @relation("EvaluationProfile", fields: [employmentProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_profile")
  reviewer  EmploymentProfile? @relation("EvaluationReviewer", fields: [reviewerProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_reviewer")
  estate    Estate             @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_estate")
  lines     EvaluationLine[]
  creator   User               @relation("EvaluationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_created_by")
  updater   User?              @relation("EvaluationUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_updated_by")
  submitter User?              @relation("EvaluationSubmittedBy", fields: [submittedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_submitted_by")
  approver  User?              @relation("EvaluationApprovedBy", fields: [approvedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_approved_by")
  rejecter  User?              @relation("EvaluationRejectedBy", fields: [rejectedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_rejected_by")

  @@unique([evaluationNumber], map: "ux_evaluation_number")
  @@index([employmentProfileId], map: "ix_evaluation_profile")
  @@index([reviewerProfileId], map: "ix_evaluation_reviewer")
  @@index([estateId], map: "ix_evaluation_estate")
  @@index([periodEnd], map: "ix_evaluation_period_end")
  @@index([state], map: "ix_evaluation_state")
  @@index([createdBy], map: "ix_evaluation_created_by")
  @@index([updatedBy], map: "ix_evaluation_updated_by")
  @@index([submittedBy], map: "ix_evaluation_submitted_by")
  @@index([approvedBy], map: "ix_evaluation_approved_by")
  @@index([rejectedBy], map: "ix_evaluation_rejected_by")
  @@map("evaluation")
}

/// P2.10 (Spec P3 §24.3): the score of one criterion in an evaluation. weighted_score = score ÷ max ×
/// weight. One line per evaluation and criterion.
model EvaluationLine {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  evaluationId  BigInt    @map("evaluation_id") @db.UnsignedBigInt
  criteriaId    BigInt    @map("criteria_id") @db.UnsignedBigInt
  goalId        BigInt?   @map("goal_id") @db.UnsignedBigInt
  weight        Decimal   @default(1) @db.Decimal(9, 4)
  score         Decimal?  @db.Decimal(9, 4)
  maxScore      Decimal   @map("max_score") @db.Decimal(9, 4)
  weightedScore Decimal?  @map("weighted_score") @db.Decimal(9, 4)
  comment       String?   @db.VarChar(500)
  sequence      Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy     BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt     DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy     BigInt?   @map("updated_by") @db.UnsignedBigInt

  evaluation Evaluation         @relation(fields: [evaluationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_line_evaluation")
  criteria   EvaluationCriteria @relation(fields: [criteriaId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_line_criteria")
  goal       Goal?              @relation(fields: [goalId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_line_goal")
  creator    User               @relation("EvaluationLineCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_line_created_by")
  updater    User?              @relation("EvaluationLineUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_evaluation_line_updated_by")

  @@unique([evaluationId, criteriaId], map: "ux_evaluation_line")
  @@index([criteriaId], map: "ix_evaluation_line_criteria")
  @@index([goalId], map: "ix_evaluation_line_goal")
  @@index([createdBy], map: "ix_evaluation_line_created_by")
  @@index([updatedBy], map: "ix_evaluation_line_updated_by")
  @@map("evaluation_line")
}
