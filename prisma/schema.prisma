// =============================================================================================
// RupAI database schema — a typed MIRROR of spec Part 3. Part 3 is the authority, not this file.
//
// Read prisma/README.md before changing anything here. In short:
//   * Every model maps to its Part 3 table and column names with @@map / @map (snake_case singular).
//   * Surrogate keys:  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
//     ULID keys (the six field-capture tables, P3 §2.2):  id String @id @db.Char(26)
//   * Money Decimal @db.Decimal(18,4) · qty (14,3) · rate (18,8) · pct (9,4). Never Float.
//   * States and enums are String @db.VarChar(30), validated in TypeScript. Never a Prisma enum.
//   * Generated columns and CHECK constraints are added by hand in the migration SQL.
//   * Migrations are created with `npm run db:migrate:new -- --name <x>` (create-only), then the
//     SQL is reviewed and edited. `prisma db push` is never used.
// =============================================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// Models are added epic by epic.

// ---------------------------------------------------------------------------------------------
// P1.01 — Platform prerequisites: permission, role, role_permission, user, user_role (P3 §28.1,
// migration step 1 of P3 §32). Every audit column in the schema references user.
// ---------------------------------------------------------------------------------------------

/// P3 §28.1. System data: seeded from the catalogue in code, never written by the app account.
model Permission {
  id          BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  module      String  @db.VarChar(40)
  action      String  @db.VarChar(20)
  description String? @db.VarChar(500)

  roles RolePermission[]

  @@unique([module, action], map: "ux_permission_module_action")
  @@map("permission")
}

/// P3 §28.1: the common lookup shape (P3 §5.1) + audit block. `version` per P4 §5.1.
model Role {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  code        String    @db.VarChar(20)
  name        String    @db.VarChar(150)
  description String?   @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  /// The Administrator role is is_system: it may be renamed but not deleted or deactivated.
  isSystem    Boolean   @default(false) @map("is_system")
  /// active | inactive
  status      String    @default("active") @db.VarChar(30)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy   BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt   DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy   BigInt?   @map("updated_by") @db.UnsignedBigInt

  creator     User             @relation("RoleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_created_by")
  updater     User?            @relation("RoleUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_updated_by")
  permissions RolePermission[]
  users       UserRole[]

  @@unique([code], map: "ux_role_code")
  @@index([status], map: "ix_role_status")
  @@index([createdBy], map: "ix_role_created_by")
  @@index([updatedBy], map: "ix_role_updated_by")
  @@map("role")
}

/// P3 §28.1. Junction; rows go with their role (P2 §7.1, line-to-header).
model RolePermission {
  roleId       BigInt @map("role_id") @db.UnsignedBigInt
  permissionId BigInt @map("permission_id") @db.UnsignedBigInt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_role_permission_role")
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_role_permission_permission")

  @@id([roleId, permissionId])
  @@index([permissionId], map: "ix_role_permission_permission")
  @@map("role_permission")
}

/// P3 §28.1 + audit block. `version` per P4 §5.1. person_id / employment_profile_id get their foreign
/// keys when person (P2.01) and employment_profile (P2.02) exist.
model User {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  personId            BigInt?   @map("person_id") @db.UnsignedBigInt
  employmentProfileId BigInt?   @map("employment_profile_id") @db.UnsignedBigInt
  username            String    @db.VarChar(50)
  email               String?   @db.VarChar(254)
  /// PHC string (argon2id). Never returned in any payload (P4 §14.1).
  passwordHash        String    @map("password_hash") @db.VarChar(255)
  phone               String?   @db.VarChar(20)
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  lastLoginAt         DateTime? @map("last_login_at") @db.DateTime(0)
  failedAttempts      Int       @default(0) @map("failed_attempts")
  lockedUntil         DateTime? @map("locked_until") @db.DateTime(0)
  twoFactorSecret     String?   @map("two_factor_secret") @db.VarChar(255)
  twoFactorEnabled    Boolean   @default(false) @map("two_factor_enabled")
  /// active | disabled
  status              String    @default("active") @db.VarChar(30)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  /// The bootstrap administrator (P3 §32.2) is created by itself.
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  creator User?      @relation("UserCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_created_by")
  updater User?      @relation("UserUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_updated_by")
  roles   UserRole[]

  // Back-relations of the audit columns. Every audited table adds a pair here.
  createdUsers     User[]     @relation("UserCreatedBy")
  updatedUsers     User[]     @relation("UserUpdatedBy")
  createdRoles     Role[]     @relation("RoleCreatedBy")
  updatedRoles     Role[]     @relation("RoleUpdatedBy")
  grantedUserRoles UserRole[] @relation("UserRoleGrantedBy")

  sessions            AuthSession[]
  passwordResetTokens PasswordResetToken[]

  auditChanges          AuditChange[]   @relation("AuditChangeBy")
  auditChangesActingFor AuditChange[]   @relation("AuditChangeActingFor")
  statusChanges         StatusHistory[]
  accessEvents          AccessLog[]

  authorisations        AccessAuthorisation[] @relation("AccessAuthorisationUser")
  authorisationsGiven   AccessAuthorisation[] @relation("AccessAuthorisationBy")
  authorisationsRemoved AccessAuthorisation[] @relation("AccessAuthorisationRemovedBy")

  createdOrganisations Organisation[] @relation("OrganisationCreatedBy")
  updatedOrganisations Organisation[] @relation("OrganisationUpdatedBy")
  createdEstates       Estate[]       @relation("EstateCreatedBy")
  updatedEstates       Estate[]       @relation("EstateUpdatedBy")
  createdDivisions     Division[]     @relation("DivisionCreatedBy")
  updatedDivisions     Division[]     @relation("DivisionUpdatedBy")
  createdSections      Section[]      @relation("SectionCreatedBy")
  updatedSections      Section[]      @relation("SectionUpdatedBy")
  createdFields        Field[]        @relation("FieldCreatedBy")
  updatedFields        Field[]        @relation("FieldUpdatedBy")

  scopes        UserScope[] @relation("UserScopeUser")
  grantedScopes UserScope[] @relation("UserScopeGrantedBy")
  createdScopes UserScope[] @relation("UserScopeCreatedBy")
  updatedScopes UserScope[] @relation("UserScopeUpdatedBy")

  @@unique([username], map: "ux_user_username")
  @@unique([email], map: "ux_user_email")
  @@index([status], map: "ix_user_status")
  @@index([personId], map: "ix_user_person")
  @@index([employmentProfileId], map: "ix_user_employment_profile")
  @@index([createdBy], map: "ix_user_created_by")
  @@index([updatedBy], map: "ix_user_updated_by")
  @@map("user")
}

/// P3 §28.1, plus granted_at / granted_by / expires_at for temporary role grants (P6 §11.2).
model UserRole {
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  roleId    BigInt    @map("role_id") @db.UnsignedBigInt
  grantedAt DateTime  @default(now()) @map("granted_at") @db.DateTime(0)
  grantedBy BigInt    @map("granted_by") @db.UnsignedBigInt
  /// NULL = permanent. A lapsed grant confers nothing; no job is needed to revoke it.
  expiresAt DateTime? @map("expires_at") @db.DateTime(0)

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_role_user")
  role    Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_role_role")
  granter User @relation("UserRoleGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_role_granted_by")

  @@id([userId, roleId])
  @@index([roleId], map: "ix_user_role_role")
  @@index([grantedBy], map: "ix_user_role_granted_by")
  @@index([expiresAt], map: "ix_user_role_expires")
  @@map("user_role")
}

// ---------------------------------------------------------------------------------------------
// P1.02 — Authentication & sessions (P4 §2.2, P1 §12.4). Not in P3: the server-side revocation
// state that P4 §2.2.1 requires ("a store of active token identifiers ... with a database fallback").
// ---------------------------------------------------------------------------------------------

/// One sign-in = one session = one refresh-token family. Revoking it ends the family at once.
model AuthSession {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt    @map("user_id") @db.UnsignedBigInt
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  lastUsedAt    DateTime  @default(now()) @map("last_used_at") @db.DateTime(0)
  /// Absolute end of the session, however often it is refreshed.
  expiresAt     DateTime  @map("expires_at") @db.DateTime(0)
  revokedAt     DateTime? @map("revoked_at") @db.DateTime(0)
  /// logout | logout_all | session_revoked | refresh_reuse | user_disabled | password_changed | password_reset
  revokedReason String?   @map("revoked_reason") @db.VarChar(30)
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.VarChar(255)

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_auth_session_user")
  refreshTokens AuthRefreshToken[]

  @@index([userId, revokedAt], map: "ix_auth_session_user_revoked")
  @@index([expiresAt], map: "ix_auth_session_expires")
  @@map("auth_session")
}

/// Every refresh token ever issued in a session. Only the SHA-256 of the token is stored. A token that
/// was already used (rotated) and is presented again is theft: the whole session is revoked.
model AuthRefreshToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sessionId BigInt    @map("session_id") @db.UnsignedBigInt
  tokenHash String    @map("token_hash") @db.Char(64)
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.DateTime(0)
  expiresAt DateTime  @map("expires_at") @db.DateTime(0)
  /// Set when the token is rotated. A used token is never valid again.
  usedAt    DateTime? @map("used_at") @db.DateTime(0)

  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_auth_refresh_token_session")

  @@unique([tokenHash], map: "ux_auth_refresh_token_hash")
  @@index([sessionId], map: "ix_auth_refresh_token_session")
  @@map("auth_refresh_token")
}

/// Single-use password reset links (P4 §2.2.3). Only the SHA-256 of the token is stored.
model PasswordResetToken {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash   String    @map("token_hash") @db.Char(64)
  createdAt   DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  expiresAt   DateTime  @map("expires_at") @db.DateTime(0)
  usedAt      DateTime? @map("used_at") @db.DateTime(0)
  requestedIp String?   @map("requested_ip") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_password_reset_token_user")

  @@unique([tokenHash], map: "ux_password_reset_token_hash")
  @@index([userId], map: "ix_password_reset_token_user")
  @@map("password_reset_token")
}

// ---------------------------------------------------------------------------------------------
// P1.03 — Data scope (P3 §28.2, P6 §4, P1 §12.2). Which records a user may touch; permission (P1.01)
// decides what they may do. Both must pass.
// ---------------------------------------------------------------------------------------------

/// P3 §28.2 + audit block + `version` (P4 §5.1). scope_id is polymorphic (estate, division, section,
/// department or facility id), so it has no foreign key; the API checks the target exists once its
/// table does (P1.07 estate hierarchy, P2 departments).
model UserScope {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  /// all_estates | estate | division | section | department | facility | self
  scopeType String    @map("scope_type") @db.VarChar(30)
  /// NULL for all_estates and self.
  scopeId   BigInt?   @map("scope_id") @db.UnsignedBigInt
  /// GENERATED column (see migration SQL): IFNULL(scope_id, 0), so the unique key also covers the
  /// NULL-id types (MySQL treats NULLs as distinct). Read-only: never set it from code.
  scopeKey  BigInt?   @map("scope_key") @db.UnsignedBigInt
  grantedAt DateTime  @default(now()) @map("granted_at") @db.DateTime(0)
  grantedBy BigInt    @map("granted_by") @db.UnsignedBigInt
  /// NULL = permanent. A lapsed grant confers nothing; no job is needed to revoke it.
  expiresAt DateTime? @map("expires_at") @db.DateTime(0)
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy BigInt?   @map("updated_by") @db.UnsignedBigInt

  user    User  @relation("UserScopeUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_user_scope_user")
  granter User  @relation("UserScopeGrantedBy", fields: [grantedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_scope_granted_by")
  creator User  @relation("UserScopeCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_scope_created_by")
  updater User? @relation("UserScopeUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_scope_updated_by")

  @@unique([userId, scopeType, scopeKey], map: "ux_user_scope")
  @@index([expiresAt], map: "ix_user_scope_expires")
  @@index([scopeType, scopeId], map: "ix_user_scope_target")
  @@index([grantedBy], map: "ix_user_scope_granted_by")
  @@index([createdBy], map: "ix_user_scope_created_by")
  @@index([updatedBy], map: "ix_user_scope_updated_by")
  @@map("user_scope")
}

// ---------------------------------------------------------------------------------------------
// P1.04 — Separation of duties and sensitive permissions (P6 §5.3, §9, §10). Not in P3: the record
// P6 requires of each override ("the user, the conflicting permissions, the rule, the reason, who
// authorised it, and when") and of each sensitive grant ("named written authorisation ... recorded").
// ---------------------------------------------------------------------------------------------

/// One recorded, named authorisation for one user: an override of a prohibited combination
/// (sod_override) or the grant of a sensitive permission (sensitive_grant). It stays on the
/// concentration report until it is removed. Never deleted by the application.
model AccessAuthorisation {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt    @map("user_id") @db.UnsignedBigInt
  /// sod_override | sensitive_grant
  kind             String    @db.VarChar(30)
  /// The P6 Table 5.1 rule (SOD-1 … SOD-7), or SENSITIVE.
  ruleCode         String    @map("rule_code") @db.VarChar(20)
  /// Stable identity of what was authorised, e.g. "SOD-2:payroll.approve+payroll.post".
  authorisationKey String    @map("authorisation_key") @db.VarChar(255)
  /// The permissions involved, comma-separated and sorted.
  permissions      String    @db.VarChar(500)
  reason           String    @db.VarChar(1000)
  authorisedBy     BigInt    @map("authorised_by") @db.UnsignedBigInt
  authorisedAt     DateTime  @default(now()) @map("authorised_at") @db.DateTime(0)
  removedAt        DateTime? @map("removed_at") @db.DateTime(0)
  removedBy        BigInt?   @map("removed_by") @db.UnsignedBigInt
  /// GENERATED column (see migration SQL): the key while active, NULL once removed. Read-only.
  activeKey        String?   @map("active_key") @db.VarChar(255)

  user       User  @relation("AccessAuthorisationUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "fk_access_authorisation_user")
  authoriser User  @relation("AccessAuthorisationBy", fields: [authorisedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_access_authorisation_by")
  remover    User? @relation("AccessAuthorisationRemovedBy", fields: [removedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_access_authorisation_removed_by")

  @@unique([userId, activeKey], map: "ux_access_authorisation_active")
  @@index([kind, removedAt], map: "ix_access_authorisation_kind")
  @@index([authorisedBy], map: "ix_access_authorisation_by")
  @@index([removedBy], map: "ix_access_authorisation_removed_by")
  @@map("access_authorisation")
}

// ---------------------------------------------------------------------------------------------
// P1.05 — Audit (P3 §29, P1 §13, P2 §6.3). Four APPEND-ONLY tables: the application account holds no
// UPDATE or DELETE grant on any of them, at any permission level, including administrator.
// ---------------------------------------------------------------------------------------------

/// P3 §29.1. Field-level before/after values. Depth per record class (P1 Table 13.1).
model AuditChange {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// Short entity key (user, role, user_scope, …), never a class or model name.
  recordType      String   @map("record_type") @db.VarChar(40)
  /// Wide enough for both BIGINT (as a decimal string) and ULID keys.
  recordId        String   @map("record_id") @db.VarChar(26)
  /// create | update | delete | approve | reject | post | reverse | cancel
  action          String   @db.VarChar(20)
  /// NULL for whole-record actions (create and delete carry a snapshot instead).
  field           String?  @db.VarChar(64)
  oldValue        String?  @map("old_value") @db.LongText
  newValue        String?  @map("new_value") @db.LongText
  changedBy       BigInt   @map("changed_by") @db.UnsignedBigInt
  actingForUserId BigInt?  @map("acting_for_user_id") @db.UnsignedBigInt
  changedAt       DateTime @default(now()) @map("changed_at") @db.DateTime(0)
  /// Financial and policy records only.
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent") @db.VarChar(255)
  reason          String?  @db.VarChar(500)

  changer   User  @relation("AuditChangeBy", fields: [changedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_change_changed_by")
  actingFor User? @relation("AuditChangeActingFor", fields: [actingForUserId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_audit_change_acting_for")

  @@index([recordType, recordId, changedAt], map: "ix_audit_record")
  @@index([changedBy, changedAt], map: "ix_audit_user")
  @@index([changedAt], map: "ix_audit_changed_at")
  @@index([actingForUserId], map: "ix_audit_acting_for")
  @@map("audit_change")
}

/// P3 §29.2. Lifecycle transitions. A record's current state must be reproducible from it.
model StatusHistory {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  recordType     String   @map("record_type") @db.VarChar(40)
  recordId       String   @map("record_id") @db.VarChar(26)
  /// NULL for the first state (creation).
  fromState      String?  @map("from_state") @db.VarChar(30)
  toState        String   @map("to_state") @db.VarChar(30)
  changedBy      BigInt   @map("changed_by") @db.UnsignedBigInt
  changedAt      DateTime @default(now()) @map("changed_at") @db.DateTime(0)
  /// FK to workflow_step when the workflow engine arrives (P1.13).
  workflowStepId BigInt?  @map("workflow_step_id") @db.UnsignedBigInt
  comment        String?  @db.VarChar(1000)

  changer User @relation(fields: [changedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_status_history_changed_by")

  @@index([recordType, recordId, changedAt], map: "ix_status_history_record")
  @@index([changedAt], map: "ix_status_history_changed_at")
  @@index([changedBy], map: "ix_status_history_changed_by")
  @@index([workflowStepId], map: "ix_status_history_workflow_step")
  @@map("status_history")
}

/// P3 §29.2 + P1 §12.4: authentication events, permission and scope denials, exports and prints.
model AccessLog {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// NULL when no user is known (a sign-in attempt for an unknown username).
  userId          BigInt?  @map("user_id") @db.UnsignedBigInt
  eventType       String   @map("event_type") @db.VarChar(30)
  module          String?  @db.VarChar(40)
  recordReference String?  @map("record_reference") @db.VarChar(100)
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent") @db.VarChar(255)
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.DateTime(0)
  /// Structured context (reason, session, filters of an export). Never a password or token.
  detail          Json?

  user User? @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_access_log_user")

  @@index([userId, occurredAt], map: "ix_access_log_user")
  @@index([occurredAt], map: "ix_access_log_occurred_at")
  @@index([eventType, occurredAt], map: "ix_access_log_event")
  @@map("access_log")
}

/// P3 §29.2. Calls to and from external systems. Never stores a biometric payload (P3 §9.4).
model IntegrationLog {
  id               BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  /// face_recognition | broker_import | other
  integrationKey   String   @map("integration_key") @db.VarChar(40)
  /// inbound | outbound
  direction        String   @db.VarChar(10)
  requestReference String?  @map("request_reference") @db.VarChar(100)
  endpoint         String?  @db.VarChar(255)
  statusCode       Int?     @map("status_code")
  /// success | failure
  outcome          String   @db.VarChar(20)
  durationMs       Int?     @map("duration_ms")
  errorMessage     String?  @map("error_message") @db.VarChar(1000)
  occurredAt       DateTime @default(now()) @map("occurred_at") @db.DateTime(0)
  relatedType      String?  @map("related_type") @db.VarChar(40)
  relatedId        String?  @map("related_id") @db.VarChar(26)

  @@index([occurredAt], map: "ix_integration_log_occurred_at")
  @@index([integrationKey, occurredAt], map: "ix_integration_log_key")
  @@index([relatedType, relatedId], map: "ix_integration_log_related")
  @@map("integration_log")
}

// ---- P1.07 organisation and estate hierarchy (Spec P3 §4.1–§4.5) ---------------------------------

/// One row per deployment (P3 §4.1): the GENERATED singleton key makes a second row impossible, and the
/// API refuses to start without one. country_id and base_currency_id gain their foreign keys and NOT NULL
/// in P1.10, which creates country and currency (BACKLOG D-1.07-1).
model Organisation {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name                 String    @db.VarChar(150)
  shortName            String    @map("short_name") @db.VarChar(50)
  registrationNumber   String?   @map("registration_number") @db.VarChar(50)
  tin                  String?   @db.VarChar(30)
  vatRegistration      String?   @map("vat_registration") @db.VarChar(30)
  addressLine1         String?   @map("address_line1") @db.VarChar(200)
  addressLine2         String?   @map("address_line2") @db.VarChar(200)
  city                 String?   @db.VarChar(100)
  postalCode           String?   @map("postal_code") @db.VarChar(20)
  countryId            BigInt?   @map("country_id") @db.UnsignedBigInt
  phone                String?   @db.VarChar(30)
  email                String?   @db.VarChar(150)
  website              String?   @db.VarChar(150)
  logoPath             String?   @map("logo_path") @db.VarChar(255)
  baseCurrencyId       BigInt?   @map("base_currency_id") @db.UnsignedBigInt
  /// 1 to 12. Governs every estate (O-17).
  fiscalYearStartMonth Int       @map("fiscal_year_start_month") @db.SmallInt
  /// active | inactive
  status               String    @default("active") @db.VarChar(30)
  /// GENERATED column (see migration SQL): always 1, under a unique index, so there is one row at most.
  singleton            Int?      @db.TinyInt
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy            BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt            DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy            BigInt?   @map("updated_by") @db.UnsignedBigInt

  creator User     @relation("OrganisationCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_organisation_created_by")
  updater User?    @relation("OrganisationUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_organisation_updated_by")
  estates Estate[]

  @@unique([singleton], map: "ux_organisation_singleton")
  @@index([createdBy], map: "ix_organisation_created_by")
  @@index([updatedBy], map: "ix_organisation_updated_by")
  @@map("organisation")
}

/// Estate tier root (P3 §4.2). Deactivated, never deleted once referenced. manager_profile_id gains its
/// foreign key to employment_profile in Phase 2 (BACKLOG D-1.07-2).
model Estate {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  organisationId   BigInt    @map("organisation_id") @db.UnsignedBigInt
  /// Unique within the organisation; appears in document numbers.
  code             String    @db.VarChar(20)
  name             String    @db.VarChar(150)
  location         String?   @db.VarChar(200)
  addressLine1     String?   @map("address_line1") @db.VarChar(200)
  district         String?   @db.VarChar(100)
  /// Hectares. Informational; the authoritative figure is the sum of land_parcel.
  totalArea        Decimal?  @map("total_area") @db.Decimal(14, 3)
  managerProfileId BigInt?   @map("manager_profile_id") @db.UnsignedBigInt
  phone            String?   @db.VarChar(30)
  email            String?   @db.VarChar(150)
  establishedOn    DateTime? @map("established_on") @db.Date
  /// owned | leased | government_lease | other
  ownershipType    String?   @map("ownership_type") @db.VarChar(30)
  /// active | inactive
  status           String    @default("active") @db.VarChar(30)
  remarks          String?   @db.VarChar(500)
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy        BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt        DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy        BigInt?   @map("updated_by") @db.UnsignedBigInt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_estate_organisation")
  creator      User         @relation("EstateCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_estate_created_by")
  updater      User?        @relation("EstateUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_estate_updated_by")
  divisions    Division[]
  fields       Field[]

  @@unique([organisationId, code], map: "ux_estate_code")
  @@index([status], map: "ix_estate_status")
  @@index([managerProfileId], map: "ix_estate_manager")
  @@index([createdBy], map: "ix_estate_created_by")
  @@index([updatedBy], map: "ix_estate_updated_by")
  @@map("estate")
}

/// P3 §4.3.
model Division {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  estateId         BigInt    @map("estate_id") @db.UnsignedBigInt
  /// Unique within the estate.
  code             String    @db.VarChar(20)
  name             String    @db.VarChar(150)
  managerProfileId BigInt?   @map("manager_profile_id") @db.UnsignedBigInt
  /// Hectares.
  area             Decimal?  @db.Decimal(14, 3)
  /// active | inactive
  status           String    @default("active") @db.VarChar(30)
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy        BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt        DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy        BigInt?   @map("updated_by") @db.UnsignedBigInt

  estate   Estate    @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_division_estate")
  creator  User      @relation("DivisionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_division_created_by")
  updater  User?     @relation("DivisionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_division_updated_by")
  sections Section[]

  @@unique([estateId, code], map: "ux_division_code")
  @@index([status], map: "ix_division_status")
  @@index([managerProfileId], map: "ix_division_manager")
  @@index([createdBy], map: "ix_division_created_by")
  @@index([updatedBy], map: "ix_division_updated_by")
  @@map("division")
}

/// P3 §4.4. estate_id is deliberately absent: it is reached through division.
model Section {
  id                  BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  divisionId          BigInt    @map("division_id") @db.UnsignedBigInt
  /// Unique within the division.
  code                String    @db.VarChar(20)
  name                String    @db.VarChar(150)
  supervisorProfileId BigInt?   @map("supervisor_profile_id") @db.UnsignedBigInt
  area                Decimal?  @db.Decimal(14, 3)
  /// active | inactive
  status              String    @default("active") @db.VarChar(30)
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy           BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt           DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy           BigInt?   @map("updated_by") @db.UnsignedBigInt

  division Division @relation(fields: [divisionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_section_division")
  creator  User     @relation("SectionCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_section_created_by")
  updater  User?    @relation("SectionUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_section_updated_by")
  fields   Field[]

  @@unique([divisionId, code], map: "ux_section_code")
  @@index([status], map: "ix_section_status")
  @@index([supervisorProfileId], map: "ix_section_supervisor")
  @@index([createdBy], map: "ix_section_created_by")
  @@index([updatedBy], map: "ix_section_updated_by")
  @@map("section")
}

/// P3 §4.5. The field is permanent; what is planted on it is plantation_record (Phase 5). estate_id is
/// denormalised on purpose (query volume) and kept equal to the section's estate by the application.
model Field {
  id                   BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sectionId            BigInt    @map("section_id") @db.UnsignedBigInt
  estateId             BigInt    @map("estate_id") @db.UnsignedBigInt
  /// Unique within the estate.
  fieldNumber          String    @map("field_number") @db.VarChar(20)
  name                 String?   @db.VarChar(150)
  /// Hectares.
  grossArea            Decimal   @map("gross_area") @db.Decimal(14, 3)
  /// Hectares. Set here until plantation_record derives it (BACKLOG D-1.07-6).
  plantedArea          Decimal?  @map("planted_area") @db.Decimal(14, 3)
  /// producing | young | nursery | uprooted | fallow | abandoned
  fieldStatus          String    @map("field_status") @db.VarChar(30)
  /// When the field joined its current section.
  sectionEffectiveFrom DateTime? @map("section_effective_from") @db.Date
  /// active | inactive
  status               String    @default("active") @db.VarChar(30)
  remarks              String?   @db.VarChar(500)
  version              Int       @default(1)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(0)
  createdBy            BigInt    @map("created_by") @db.UnsignedBigInt
  updatedAt            DateTime? @map("updated_at") @db.DateTime(0)
  updatedBy            BigInt?   @map("updated_by") @db.UnsignedBigInt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_section")
  estate  Estate  @relation(fields: [estateId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_estate")
  creator User    @relation("FieldCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_created_by")
  updater User?   @relation("FieldUpdatedBy", fields: [updatedBy], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_field_updated_by")

  @@unique([estateId, fieldNumber], map: "ux_field_number")
  @@index([sectionId], map: "ix_field_section")
  @@index([fieldStatus], map: "ix_field_status")
  @@index([createdBy], map: "ix_field_created_by")
  @@index([updatedBy], map: "ix_field_updated_by")
  @@map("field")
}
