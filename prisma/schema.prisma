  employmentProfile           EmploymentProfile?    @relation("UserProfile", fields: [employmentProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_user_employment_profile")

  @@index([employmentProfileId], map: "ix_user_employment_profile")
  @@index([createdBy], map: "ix_user_created_by")
  @@index([updatedBy], map: "ix_user_updated_by")
