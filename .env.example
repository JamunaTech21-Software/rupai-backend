# Copy to .env and fill in. Never commit .env.
# The app validates every value at start-up and refuses to start if anything is missing or malformed.

# Runtime mode: development | test | production
NODE_ENV=development

# Deployment environment name: development | test | staging | production.
# Any value other than production shows a banner in the web app (X-Environment header).
APP_ENV=development

PORT=4000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# json (servers) | pretty (local development only; refused in production)
LOG_FORMAT=pretty

# Display timezone. Storage is always UTC.
APP_TIMEZONE=Asia/Dhaka

# ---- Database (MySQL 8.4; local: `npm run db:up`) -------------------------------------------
# Values below match the local Docker MySQL (docker/mysql/init). Production uses real secrets.

# Application account: SELECT/INSERT database-wide, UPDATE/DELETE per table. Used by the running app.
DATABASE_URL=mysql://rupai_app:rupai_app_dev@127.0.0.1:3306/rupai
# Migration account: DDL. Used only by the Prisma CLI (migrate, seed).
MIGRATION_DATABASE_URL=mysql://rupai_migrator:rupai_migrator_dev@127.0.0.1:3306/rupai
# Scratch database for `prisma migrate dev` and the drift check. Never holds real data.
SHADOW_DATABASE_URL=mysql://rupai_migrator:rupai_migrator_dev@127.0.0.1:3306/rupai_shadow
# Connections per process.
DB_POOL_SIZE=10
# Needed for MySQL 8 auth without TLS. true only for localhost or a trusted LAN.
DB_ALLOW_PUBLIC_KEY_RETRIEVAL=true

# Hide Prisma's "update available" banner (we pin versions deliberately).
PRISMA_HIDE_UPDATE_MESSAGE=1

# ---- HTTP -----------------------------------------------------------------------------------
# Exact browser origins allowed to call the API (comma-separated). No wildcard. Required in production.
# Leave empty locally to allow http://localhost:5173 (the Vite dev server).
CORS_ORIGINS=
# true only if the refresh token travels in a cookie (decided in P1.02).
CORS_ALLOW_CREDENTIALS=false
CORS_MAX_AGE_SECONDS=600
# Reverse proxies whose X-Forwarded-For is trusted (Express "trust proxy").
TRUST_PROXY=loopback
# Only once a valid TLS certificate is in place (Spec P14 §7.3).
HSTS_ENABLED=false
BODY_LIMIT=1mb
# Never false in production (the config refuses it).
RATE_LIMIT_ENABLED=true

# Reported by GET /health. Set by the deployment.
APP_VERSION=0.0.0-dev
BUILD_COMMIT=unknown

# ---- Redis (local: `npm run stack:up`) -------------------------------------------------------
# Shared idempotency records and rate-limit counters (later: job queue, token revocation).
# Required in production. Leave unset locally to fall back to per-process memory.
REDIS_URL=redis://:rupai_redis_dev@127.0.0.1:6379

# ---- API docs ----------------------------------------------------------------------------------
# Swagger UI at /docs and the document at /docs/openapi.json. Defaults: on outside production, off in it.
# DOCS_ENABLED=true

# ---- Mail (local: Mailpit at http://localhost:8025 catches everything) --------------------------
# Used from P1.02 (password reset) and P1.16 (notifications).
# SMTP_HOST=127.0.0.1
# SMTP_PORT=1025
