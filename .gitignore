# dependencies
node_modules/

# build output
dist/
coverage/
*.tsbuildinfo

# environment — secrets never enter the repository (Spec P14 §4.3)
.env
.env.*
!.env.example

# local storage & logs, at the backend root only: without the leading slash these would also hide
# source folders of the same name (src/core/storage)
/storage/
/uploads/
/logs/
*.log

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# generated Prisma clients (rebuilt by `prisma generate` on install)
src/generated/
tests/fixtures/**/generated/

# generated OpenAPI document (`npm run docs:openapi`; live at /docs/openapi.json)
docs/openapi.json

# Staging secrets, backups and deploy state (deploy/staging)
deploy/staging/.env
deploy/staging/backups/
deploy/staging/.deployed-tag
