# dependencies
node_modules/

# build output
dist/
coverage/
*.tsbuildinfo

# environment — secrets never enter the repository (Spec P14 §4.3)
.env
.env.*
!.env.example

# local storage & logs
storage/
uploads/
logs/
*.log

# OS / editor
.DS_Store
.idea/
