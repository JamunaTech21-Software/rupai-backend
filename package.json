{
  "name": "rupai-backend",
  "version": "0.1.0",
  "private": true,
  "description": "RupAI \u2014 Integrated Tea Estate ERP backend (Express + TypeScript + Prisma + MySQL 8)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepare": "husky || true",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d --wait mysql",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate:new": "prisma migrate dev --create-only",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed/demo.ts",
    "db:drift": "tsx scripts/check-drift.ts",
    "db:push": "node -e \"console.error(\\\"prisma db push is not allowed in this project. Use db:migrate:new and review the SQL (prisma/README.md).\\\");process.exit(1)\"",
    "test:db": "vitest run --project db",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:db && npm run build && npm audit --omit=dev --audit-level=critical",
    "docs:openapi": "tsx scripts/export-openapi.ts",
    "stack:up": "docker compose up -d --wait",
    "stack:down": "docker compose down"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "mariadb": "3.4.7",
    "nodemailer": "10.0.14",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qs": "6.16.0",
    "rate-limit-redis": "6.0.1",
    "swagger-ui-express": "5.0.1",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@testcontainers/mysql": "12.2.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/qs": "6.15.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.9",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "testcontainers": "12.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "cpu-features": false,
    "ssh2": false,
    "protobufjs": false,
    "fsevents": false,
    "@scarf/scarf": false
  },
  "overrides": {
    "mariadb": "3.4.7",
    "mysql2": "3.24.5"
  }
}
